diff --git a/include/InlineUnderline.h b/include/InlineUnderline.h
new file mode 100644
index 0000000..8cd3271
--- /dev/null
+++ b/include/InlineUnderline.h
@@ -0,0 +1,52 @@
+#pragma once
+#include <msctf.h>
+#include "WeaselIPCData.h"
+namespace weasel {
+inline TF_DISPLAYATTRIBUTE InlineUnderlineAttribute(const Config& config, const UIStyle& style) {
+  TF_DISPLAYATTRIBUTE attr{{TF_CT_NONE, 0}, {TF_CT_NONE, 0}, TF_LS_SOLID,
+                            config.inline_underline_bold, {TF_CT_COLORREF, RGB(0x28,0x6c,0xf4)}, TF_ATTR_INPUT};
+  const auto& line = config.inline_underline_style;
+  if (line == L"none") attr.lsStyle = TF_LS_NONE;
+  else if (line == L"dot") attr.lsStyle = TF_LS_DOT;
+  else if (line == L"dash") attr.lsStyle = TF_LS_DASH;
+  else if (line == L"squiggle") attr.lsStyle = TF_LS_SQUIGGLE;
+  const auto& color = config.inline_underline_color;
+  if (color == L"theme") {
+    if (style.hilited_candidate_back_color & 0xff000000)
+      attr.crLine.cr = style.hilited_candidate_back_color & 0xffffff;
+  } else if (color.size() == 7 && color[0] == L'#') {
+    unsigned rgb = 0;
+    bool valid = true;
+    for (size_t i = 1; i < color.size(); ++i) {
+      const auto c = color[i];
+      int digit = c >= L'0' && c <= L'9' ? c-L'0' :
+                  c >= L'a' && c <= L'f' ? c-L'a'+10 :
+                  c >= L'A' && c <= L'F' ? c-L'A'+10 : -1;
+      if (digit < 0) { valid = false; break; }
+      rgb = (rgb << 4) | digit;
+    }
+    if (valid) attr.crLine.cr = RGB((rgb>>16)&255, (rgb>>8)&255, rgb&255);
+  }
+  return attr;
+}
+// Encode resolved attributes in their own GUID. A host caching an earlier
+// attribute cannot mistake a new color/style for the old definition.
+inline GUID MakeInlineUnderlineGuid(const Config& config, const UIStyle& style) {
+  const auto attr = InlineUnderlineAttribute(config, style);
+  GUID guid{0x2ac87e79,0x3260,0x4b32,{0x9d,0xeb,0,0,0,0,0,0xa7}};
+  guid.Data4[2] = static_cast<BYTE>(attr.lsStyle);
+  guid.Data4[3] = attr.fBoldLine ? 1 : 0;
+  guid.Data4[4] = GetRValue(attr.crLine.cr);
+  guid.Data4[5] = GetGValue(attr.crLine.cr);
+  guid.Data4[6] = GetBValue(attr.crLine.cr);
+  return guid;
+}
+inline bool DecodeInlineUnderlineGuid(REFGUID guid, TF_DISPLAYATTRIBUTE& attr) {
+  if (guid.Data1 != 0x2ac87e79 || guid.Data2 != 0x3260 || guid.Data3 != 0x4b32 ||
+      guid.Data4[0] != 0x9d || guid.Data4[1] != 0xeb || guid.Data4[7] != 0xa7 ||
+      guid.Data4[2] > TF_LS_SQUIGGLE || guid.Data4[3] > 1) return false;
+  attr = {{TF_CT_NONE,0}, {TF_CT_NONE,0}, static_cast<TF_DA_LINESTYLE>(guid.Data4[2]),
+           guid.Data4[3] != 0, {TF_CT_COLORREF,RGB(guid.Data4[4],guid.Data4[5],guid.Data4[6])}, TF_ATTR_INPUT};
+  return true;
+}
+}  // namespace weasel
