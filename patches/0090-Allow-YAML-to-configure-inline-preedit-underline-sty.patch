+#include <windows.h>
+#include <msctf.h>
+#include <InlineUnderline.h>
+#include <ResponseParser.h>
+#include <WeaselIPC.h>
+#include <cassert>
+#include <iostream>
+int wmain(int argc, wchar_t** argv) {
+  assert(argc == 2 || argc == 3);
+  assert(SUCCEEDED(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED)));
+  HMODULE dll = LoadLibraryW(argv[1]); assert(dll);
+  using GetClass = HRESULT (WINAPI*)(REFCLSID, REFIID, void**);
+  auto getClass = reinterpret_cast<GetClass>(GetProcAddress(dll, "DllGetClassObject")); assert(getClass);
+  GUID clsid{0xa3f4cded,0xb1e9,0x41ee,{0x9c,0xa6,0x7b,0x4d,0x0d,0xe6,0xcb,0x0a}};
+  IClassFactory* factory = nullptr;
+  assert(SUCCEEDED(getClass(clsid, IID_IClassFactory, (void**)&factory)));
+  ITfDisplayAttributeProvider* provider = nullptr;
+  assert(SUCCEEDED(factory->CreateInstance(nullptr, IID_ITfDisplayAttributeProvider, (void**)&provider)));
+  factory->Release();
+  weasel::Config config;
+  weasel::UIStyle style;
+  // Configuration is transported independently of the unchanged style archive.
+  weasel::ResponseParser parser(nullptr, nullptr, nullptr, &config);
+  parser.Feed(L"action=config");
+  parser.Feed(L"config.inline_underline_style=dash");
+  parser.Feed(L"config.inline_underline_color=#A13F07");
+  parser.Feed(L"config.inline_underline_bold=1");
+  assert(config.inline_underline_style == L"dash" && config.inline_underline_bold);
+  auto resolve = [&](const weasel::Config& cfg, const weasel::UIStyle& sty) {
+    GUID guid = weasel::MakeInlineUnderlineGuid(cfg, sty);
+    ITfDisplayAttributeInfo* info = nullptr;
+    assert(SUCCEEDED(provider->GetDisplayAttributeInfo(guid, &info)));
+    GUID returned{}; assert(SUCCEEDED(info->GetGUID(&returned)) && IsEqualGUID(guid, returned));
+    TF_DISPLAYATTRIBUTE attr{}; assert(SUCCEEDED(info->GetAttributeInfo(&attr)));
+    info->Release(); return attr;
+  };
+  auto custom = resolve(config, style);
+  assert(custom.lsStyle == TF_LS_DASH && custom.fBoldLine && custom.crLine.cr == RGB(0xa1,0x3f,7));
+  assert(custom.crText.type == TF_CT_NONE && custom.crBk.type == TF_CT_NONE);
+  const wchar_t* names[] = {L"none", L"solid", L"dot", L"dash", L"squiggle"};
+  const TF_DA_LINESTYLE expected[] = {TF_LS_NONE, TF_LS_SOLID, TF_LS_DOT, TF_LS_DASH, TF_LS_SQUIGGLE};
+  for (size_t i = 0; i < 5; ++i) {
+    config.inline_underline_style = names[i];
+    assert(resolve(config, style).lsStyle == expected[i]);
+  }
+  config.inline_underline_color = L"theme";
+  style.hilited_candidate_back_color = 0xff604020;
+  const GUID first = weasel::MakeInlineUnderlineGuid(config,style);
+  assert(resolve(config,style).crLine.cr == RGB(0x20,0x40,0x60));
+  style.hilited_candidate_back_color = 0xffc05030;
+  const GUID second = weasel::MakeInlineUnderlineGuid(config,style);
+  assert(!IsEqualGUID(first, second));
+  assert(resolve(config,style).crLine.cr == RGB(0x30,0x50,0xc0));
+  ITfDisplayAttributeInfo* previous = nullptr;
+  assert(SUCCEEDED(provider->GetDisplayAttributeInfo(first,&previous)));
+  TF_DISPLAYATTRIBUTE old{}; previous->GetAttributeInfo(&old); previous->Release();
+  assert(old.crLine.cr == RGB(0x20,0x40,0x60)); // cached old definitions remain immutable
+  config.inline_underline_color = L"invalid";
+  config.inline_underline_style = L"invalid";
+  assert(resolve(config,style).crLine.cr == RGB(0x28,0x6c,0xf4));
+  assert(resolve(config,style).lsStyle == TF_LS_SOLID);
+  GUID invalid = second; invalid.Data4[3] = 9;
+  ITfDisplayAttributeInfo* rejected = nullptr;
+  assert(provider->GetDisplayAttributeInfo(invalid,&rejected) == E_INVALIDARG && !rejected);
+  config.reset(); assert(!config.inline_underline_bold && config.inline_underline_style == L"solid");
+  if (argc == 3 && std::wstring(argv[2]) == L"--live") {
+    weasel::Client client;
+    assert(client.Connect());
+    client.StartSession();
+    weasel::Config actual;
+    weasel::UIStyle palette;
+    weasel::ResponseParser response(nullptr, nullptr, nullptr, &actual, &palette);
+    assert(client.GetResponseData(std::ref(response)));
+    assert(actual.inline_preedit && actual.inline_underline_style == L"solid");
+    assert(actual.inline_underline_color == L"#286CF4" && !actual.inline_underline_bold);
+    assert(resolve(actual, palette).crLine.cr == RGB(0x28, 0x6c, 0xf4));
+    client.EndSession(); client.Disconnect();
+    std::cout << "Live deployed YAML -> server -> IPC -> DLL attributes passed\n";
+  }
+  provider->Release(); FreeLibrary(dll); CoUninitialize();
+  std::cout << "YAML IPC fields, real DLL attributes, theme changes and cache isolation passed\n";
+}
