 };
diff --git a/include/WeaselIPCData.h b/include/WeaselIPCData.h
index 09f22f9..063a1b4 100644
--- a/include/WeaselIPCData.h
+++ b/include/WeaselIPCData.h
@@ -2,6 +2,7 @@
 
 #include <string>
 #include <vector>
+#include "RewriteState.h"
 #include <boost/serialization/vector.hpp>
 #include <boost/serialization/string.hpp>
 
@@ -120,14 +121,16 @@ struct CandidateInfo {
 
 struct Context {
   Context() {}
+  bool HasPanelPreedit() const { return !preedit.empty() || rewrite.active(); }
   void clear() {
     preedit.clear();
     aux.clear();
     cinfo.clear();
+    rewrite.clear();
   }
-  bool empty() const { return preedit.empty() && aux.empty() && cinfo.empty(); }
+  bool empty() const { return preedit.empty() && aux.empty() && cinfo.empty() && !rewrite.active(); }
   bool operator==(const Context& ctx) {
-    if (preedit == ctx.preedit && aux == ctx.aux && cinfo == ctx.cinfo)
+    if (preedit == ctx.preedit && aux == ctx.aux && cinfo == ctx.cinfo && rewrite == ctx.rewrite)
       return true;
     return false;
   }
@@ -135,12 +138,13 @@ struct Context {
 
   bool operator!() {
     if (preedit.str.empty() && aux.str.empty() && cinfo.candies.empty() &&
-        cinfo.labels.empty() && cinfo.comments.empty())
+        cinfo.labels.empty() && cinfo.comments.empty() && !rewrite.active())
       return true;
     else
       return false;
   }
   Text preedit;
+  RewriteState rewrite;
   Text aux;
   CandidateInfo cinfo;
 };
