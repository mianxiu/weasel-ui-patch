 /* End Composition */
+// Keep the old range alive before the host can terminate its composition.
+// Both the termination callback and a delayed edit session share this record,
+// so an empty range is never cleared a second time after new input is inserted.
+struct CompositionCleanup {
+  com_ptr<ITfContext> context;
+  com_ptr<ITfComposition> composition;
+  com_ptr<ITfRange> range;
+  bool clear = false;
+  bool textCleared = false;
+  bool attributesCleared = false;
+  bool terminated = false;
+};
+
+static HRESULT ClearCompositionText(CompositionCleanup& cleanup,
+                                    TfEditCookie ec) {
+  if (!cleanup.clear || cleanup.textCleared)
+    return S_OK;
+  if (!cleanup.range)
+    return E_FAIL;
+  cleanup.textCleared = true; // SetText may re-enter the termination sink.
+  HRESULT hr = cleanup.range->SetText(ec, 0, L"", 0);
+  if (FAILED(hr))
+    cleanup.textCleared = false;
+  return hr;
+}
+
 class CEndCompositionEditSession : public CEditSession {
  public:
-  CEndCompositionEditSession(com_ptr<WeaselTSF> pTextService,
-                             com_ptr<ITfContext> pContext,
-                             com_ptr<ITfComposition> pComposition,
-                             BOOL clear = TRUE)
-      : CEditSession(pTextService, pContext), _clear(clear) {
-    _pComposition = pComposition;
-  }
+  CEndCompositionEditSession(com_ptr<WeaselTSF> service,
+                             std::shared_ptr<CompositionCleanup> cleanup)
+      : CEditSession(service, cleanup->context), _cleanup(cleanup) {}
 
-  /* ITfEditSession */
-  STDMETHODIMP DoEditSession(TfEditCookie ec);
+  STDMETHODIMP DoEditSession(TfEditCookie ec) {
+    auto& cleanup = *_cleanup;
+    if (!cleanup.clear && !cleanup.terminated) {
+      com_ptr<ITfRange> currentRange;
+      if (SUCCEEDED(cleanup.composition->GetRange(&currentRange)))
+        cleanup.range = currentRange;
+    }
+    // Once the termination callback removed the text, its empty saved range
+    // may expand around new input. Do not touch that input's attributes.
+    if (!cleanup.attributesCleared) {
+      cleanup.attributesCleared = true;
+      _pTextService->_ClearCompositionDisplayAttributes(ec, _pContext,
+                                                       cleanup.range);
+    }
+    HRESULT hr = ClearCompositionText(cleanup, ec);
+    if (FAILED(hr))
+      return hr;
+    if (_pTextService->_IsCurrentComposition(cleanup.composition))
+      _pTextService->_FinalizeComposition();
+    if (!cleanup.terminated) {
+      hr = cleanup.composition->EndComposition(ec);
+      if (SUCCEEDED(hr))
+        cleanup.terminated = true;
+    }
+    _pTextService->_pendingCompositionCleanup.erase(cleanup.composition);
+    return hr;
+  }
 
  private:
-  com_ptr<ITfComposition> _pComposition;
-  BOOL _clear;
+  std::shared_ptr<CompositionCleanup> _cleanup;
 };
 
