+++ b/test/tsf_focus_test.cpp
@@ -0,0 +1,197 @@
+#include "../WeaselUI/stdafx.h"
+#include "../WeaselTSF/WeaselTSF.h"
+#include "../WeaselTSF/CandidateList.h"
+#include <cassert>
+#include <iostream>
+
+CAppModule _Module;
+
+// Exercise the production TSF objects with deterministic COM hosts. No real
+// input-method registration, user input, or Rime user directory is touched.
+#define MOCK_UNKNOWN(interfaceName) \
+  STDMETHODIMP QueryInterface(REFIID iid, void** out) override { \
+    *out = nullptr; \
+    if (iid != IID_IUnknown && iid != __uuidof(interfaceName)) \
+      return E_NOINTERFACE; \
+    *out = static_cast<interfaceName*>(this); AddRef(); return S_OK; \
+  } \
+  STDMETHODIMP_(ULONG) AddRef() override { return ++refs; } \
+  STDMETHODIMP_(ULONG) Release() override { return --refs; } \
+  ULONG refs = 1;
+
+struct Host : ITfThreadMgr, ITfUIElementMgr {
+  ULONG refs = 1;
+  int begins = 0, ends = 0;
+  bool unavailable = false;
+  STDMETHODIMP QueryInterface(REFIID iid, void** out) override {
+    *out = nullptr;
+    if (iid == IID_IUnknown || iid == IID_ITfThreadMgr)
+      *out = static_cast<ITfThreadMgr*>(this);
+    else if (iid == IID_ITfUIElementMgr && !unavailable)
+      *out = static_cast<ITfUIElementMgr*>(this);
+    else return E_NOINTERFACE;
+    AddRef(); return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++refs; }
+  STDMETHODIMP_(ULONG) Release() override { return --refs; }
+  STDMETHODIMP BeginUIElement(ITfUIElement*, BOOL* show, DWORD* id) override {
+    *show = FALSE; *id = ++begins; return S_OK;
+  }
+  STDMETHODIMP EndUIElement(DWORD) override { ++ends; return S_OK; }
+  STDMETHODIMP UpdateUIElement(DWORD) override { return S_OK; }
+  STDMETHODIMP GetUIElement(DWORD, ITfUIElement**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumUIElements(IEnumTfUIElements**) override { return E_NOTIMPL; }
+  STDMETHODIMP Activate(TfClientId*) override { return E_NOTIMPL; }
+  STDMETHODIMP Deactivate() override { return E_NOTIMPL; }
+  STDMETHODIMP CreateDocumentMgr(ITfDocumentMgr**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumDocumentMgrs(IEnumTfDocumentMgrs**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetFocus(ITfDocumentMgr** out) override { *out = nullptr; return E_FAIL; }
+  STDMETHODIMP SetFocus(ITfDocumentMgr*) override { return E_NOTIMPL; }
+  STDMETHODIMP AssociateFocus(HWND, ITfDocumentMgr*, ITfDocumentMgr**) override { return E_NOTIMPL; }
+  STDMETHODIMP IsThreadFocus(BOOL*) override { return E_NOTIMPL; }
+  STDMETHODIMP GetFunctionProvider(REFCLSID, ITfFunctionProvider**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumFunctionProviders(IEnumTfFunctionProviders**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetGlobalCompartment(ITfCompartmentMgr**) override { return E_NOTIMPL; }
+};
+
+struct Composition : ITfComposition {
+  MOCK_UNKNOWN(ITfComposition)
+  int rangeReads = 0, ends = 0;
+  STDMETHODIMP GetRange(ITfRange** out) override { ++rangeReads; *out = nullptr; return E_FAIL; }
+  STDMETHODIMP ShiftStart(TfEditCookie, ITfRange*) override { return E_NOTIMPL; }
+  STDMETHODIMP ShiftEnd(TfEditCookie, ITfRange*) override { return E_NOTIMPL; }
+  STDMETHODIMP EndComposition(TfEditCookie) override { ++ends; return S_OK; }
+};
+
+struct Document : ITfDocumentMgr {
+  MOCK_UNKNOWN(ITfDocumentMgr)
+  STDMETHODIMP CreateContext(TfClientId, DWORD, IUnknown*, ITfContext**, TfEditCookie*) override { return E_NOTIMPL; }
+  STDMETHODIMP Push(ITfContext*) override { return E_NOTIMPL; }
+  STDMETHODIMP Pop(DWORD) override { return E_NOTIMPL; }
+  STDMETHODIMP GetTop(ITfContext** out) override { *out = nullptr; return S_OK; }
+  STDMETHODIMP GetBase(ITfContext**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumContexts(IEnumTfContexts**) override { return E_NOTIMPL; }
+};
+
+struct Context : ITfContext {
+  MOCK_UNKNOWN(ITfContext)
+  ITfDocumentMgr* document = nullptr;
+  std::vector<com_ptr<ITfEditSession>> pending;
+  STDMETHODIMP RequestEditSession(TfClientId, ITfEditSession* session,
+                                  DWORD, HRESULT* result) override {
+    pending.emplace_back(session); *result = TF_S_ASYNC; return S_OK;
+  }
+  void Drain() {
+    auto sessions = std::move(pending);
+    for (auto& session : sessions) assert(SUCCEEDED(session->DoEditSession(0)));
+  }
+  STDMETHODIMP InWriteSession(TfClientId, BOOL*) override { return E_NOTIMPL; }
+  STDMETHODIMP GetSelection(TfEditCookie, ULONG, ULONG, TF_SELECTION*, ULONG*) override { return E_NOTIMPL; }
+  STDMETHODIMP SetSelection(TfEditCookie, ULONG, const TF_SELECTION*) override { return E_NOTIMPL; }
+  STDMETHODIMP GetStart(TfEditCookie, ITfRange**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetEnd(TfEditCookie, ITfRange**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetActiveView(ITfContextView**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumViews(IEnumTfContextViews**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetStatus(TF_STATUS*) override { return E_NOTIMPL; }
+  STDMETHODIMP GetProperty(REFGUID, ITfProperty**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetAppProperty(REFGUID, ITfReadOnlyProperty**) override { return E_NOTIMPL; }
+  STDMETHODIMP TrackProperties(const GUID**, ULONG, const GUID**, ULONG, ITfReadOnlyProperty**) override { return E_NOTIMPL; }
+  STDMETHODIMP EnumProperties(IEnumTfProperties**) override { return E_NOTIMPL; }
+  STDMETHODIMP GetDocumentMgr(ITfDocumentMgr** out) override {
+    *out = document; if (*out) (*out)->AddRef(); return S_OK;
+  }
+  STDMETHODIMP CreateRangeBackup(TfEditCookie, ITfRange*, ITfRangeBackup**) override { return E_NOTIMPL; }
+};
+
+struct TSFFocusTest {
+  static void Run() {
+    Host host;
+    Context context;
+    Composition oldComposition, newComposition;
+    auto* service = new WeaselTSF;
+    service->_pThreadMgr = &host;
+    service->_pEditSessionContext = &context;
+    auto& candidates = service->_cand;
+    candidates->style().inline_preedit = true;
+
+    // Destroy without a TSF composition used to leave _uiStarted true.
+    candidates->StartUI();
+    candidates->Destroy();
+    candidates->StartUI();
+    assert(host.begins == 2 && host.ends == 1);
+    host.unavailable = true;
+    candidates->Destroy();
+    host.unavailable = false;
+    candidates->StartUI();
+    assert(host.begins == 3); // Even failed EndUIElement QI permits restart.
+
+    // Queued key/start/inline updates from window 1 must not resurrect input
+    // after thread focus loss, even if they run after focus returns.
+    service->_UpdateComposition(&context);
+    service->_StartComposition(&context, FALSE);
+    service->_SetComposition(&oldComposition);
+    auto input = std::make_shared<weasel::Context>();
+    input->preedit.str = L"shi";
+    service->_ShowInlinePreedit(&context, input);
+    service->_status.composing = true;
+    service->_fTestKeyDownPending = service->_fTestKeyUpPending = TRUE;
+    auto epoch = service->_GetCompositionEpoch();
+    service->OnKillThreadFocus();
+    assert(!service->_IsComposing() && !service->_status.composing);
+    assert(!service->_fTestKeyDownPending && !service->_fTestKeyUpPending);
+    assert(!service->_IsCompositionEpoch(epoch));
+    service->_SetComposition(&newComposition);
+    context.Drain();
+    assert(service->_IsCurrentComposition(&newComposition));
+    assert(oldComposition.rangeReads == 2 && oldComposition.ends == 1);
+    assert(newComposition.rangeReads == 0); // Old cleanup cannot use new range.
+
+    // A late callback from the old composition cannot clear the new one.
+    service->_status.composing = true;
+    service->OnCompositionTerminated(0, &oldComposition);
+    assert(service->_status.composing && service->_IsCurrentComposition(&newComposition));
+
+    // External termination of a real inline composition clears both states.
+    service->OnCompositionTerminated(0, &newComposition);
+    assert(!service->_IsComposing() && !service->_status.composing);
+    candidates->StartUI();
+    assert(host.begins == 4);
+
+    // Preserve the host's empty non-inline composition workaround.
+    candidates->style().inline_preedit = false;
+    service->_SetComposition(&newComposition);
+    service->_status.composing = true;
+    service->OnCompositionTerminated(0, &newComposition);
+    assert(!service->_IsComposing() && service->_status.composing);
+    service->_AbortComposition();
+    context.Drain();
+
+    // Same-thread document changes can arrive without OnKillThreadFocus.
+    Document document;
+    context.document = &document;
+    service->_SetComposition(&newComposition);
+    service->_status.composing = true;
+    service->OnSetFocus(nullptr, nullptr);
+    assert(!service->_status.composing && !service->_IsComposing());
+    context.Drain();
+    // Even a queued first key (before a TSF composition exists) is cancelled.
+    service->_UpdateComposition(&context);
+    epoch = service->_GetCompositionEpoch();
+    service->OnSetFocus(nullptr, nullptr);
+    assert(!service->_IsCompositionEpoch(epoch));
+    context.Drain();
+    context.document = nullptr;
+    service->_pEditSessionContext.Release();
+    candidates->Destroy();
+    candidates.Release(); // Break the existing service/candidate COM cycle.
+    service->_pThreadMgr.Release();
+    service->Release();
+  }
+};
+
+int main() {
+  assert(SUCCEEDED(CoInitialize(nullptr)));
+  TSFFocusTest::Run();
+  CoUninitialize();
+  std::cout << "TSF focus lifecycle and stale edit-session tests passed\n";
+}
