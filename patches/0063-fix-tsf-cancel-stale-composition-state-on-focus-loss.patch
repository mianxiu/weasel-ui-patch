+class CUpdateCompositionEditSession : public CEditSession {
+ public:
+  CUpdateCompositionEditSession(com_ptr<WeaselTSF> service,
+                                com_ptr<ITfContext> context)
+      : CEditSession(service, context),
+        _epoch(service->_GetCompositionEpoch()) {}
+
+  STDMETHODIMP DoEditSession(TfEditCookie ec) {
+    if (!_pTextService->_IsCompositionEpoch(_epoch))
+      return S_OK;
+    _pTextService->_pEditSessionContext = _pContext;
+    return _pTextService->DoEditSession(ec);
+  }
 
-  _pEditSessionContext = pContext;
+ private:
+  unsigned long long _epoch;
+};
 
-  _pEditSessionContext->RequestEditSession(
-      _tfClientId, this, TF_ES_ASYNCDONTCARE | TF_ES_READWRITE, &hr);
-  _async_edit = !!(hr == TF_S_ASYNC);
+void WeaselTSF::_UpdateComposition(com_ptr<ITfContext> pContext) {
+  if (!pContext)
+    return;
+  HRESULT hr = E_FAIL;
+  _pEditSessionContext = pContext;
+  com_ptr<CUpdateCompositionEditSession> session;
+  session.Attach(new CUpdateCompositionEditSession(this, pContext));
+  pContext->RequestEditSession(_tfClientId, session,
+                              TF_ES_ASYNCDONTCARE | TF_ES_READWRITE, &hr);
+  _async_edit = (hr == TF_S_ASYNC);
 }
 
 /* Composition State */
@@ -402,22 +435,32 @@ STDMETHODIMP WeaselTSF::OnCompositionTerminated(TfEditCookie ecWrite,
     return S_OK;
 
   // A host may terminate the empty TSF composition used for a non-inline
-  // preedit. Keep Rime's composing state; the next key will create a fresh
-  // TSF composition. Only an inactive Rime session should be aborted here.
-  if (_status.composing) {
+  // preedit. Keep that non-inline workaround; a real inline composition
+  // terminated by the host must also end the Rime input state.
+  if (_status.composing && !_cand->style().inline_preedit) {
     _FinalizeComposition();
     return S_OK;
   }
 
+  // An inline composition terminated by the host is no longer editable.
+  // Do not leave its Rime preedit alive with a destroyed candidate window.
+  _FinalizeComposition();
   _AbortComposition();
   return S_OK;
 }
 
 void WeaselTSF::_AbortComposition(bool clear) {
+  ++_compositionEpoch;
   m_client.ClearComposition();
-  if (_IsComposing()) {
+  if (_IsComposing() && _pEditSessionContext) {
     _EndComposition(_pEditSessionContext, clear);
   }
+  // The end edit session owns the old COM object until it finishes. Detach
+  // now so a key after focus returns cannot reuse that ending composition.
+  _FinalizeComposition();
+  _status.composing = false;
+  _fTestKeyDownPending = _fTestKeyUpPending = FALSE;
+  _async_edit = FALSE;
   _committed = TRUE;
   _cand->Destroy();
 }
