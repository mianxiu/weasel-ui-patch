+> **2026-10-01 悬停与间距：** 次要候选悬停背景为浅灰色 `#EEEEEE`，文字保持黑色；Tab 前 4 个音节隐藏编号，新增音节间距缩小为隐藏编号占位的一半，首音节仍与主候选文字对齐，第 5 项起保留编号。
 
 > **2026-10-01 Tab 可读性调整：** Tab 拼音约为主字号的 80%（至少 10pt），编号按实际字体的小写 s 字形高度缩放并使用灰色；第 1–4 个音节隐藏编号显示，数字定位操作不变。Tab 文字与主候选填充边缘留出 4px 视觉间隔，朝连接侧增加填充留白，保留相交背景圆角融合及稳定定位。
 
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index b64b464..d561d4a 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -204,7 +204,9 @@ int main() {
         const int lastGap = mode == 2 ?
             fiveLayout.cells[4].text.top - fiveLayout.cells[3].text.bottom :
             fiveLayout.cells[4].text.left - fiveLayout.cells[3].text.right;
-        assert(abs(visualGap - lastGap) <= (int)ceil(dwr->dpiScaleLayout));
+        const int baseGap = 2 * (std::max)(2, (int)(4 * dwr->dpiScaleLayout));
+        const int expectedGap = i < 4 ? baseGap + (lastGap - baseGap + 1) / 2 : lastGap;
+        assert(abs(visualGap - expectedGap) <= (int)ceil(dwr->dpiScaleLayout));
       }
       assert(dwr->pRewriteLabelTextFormat->GetFontSize() <= dwr->pRewriteTextFormat->GetFontSize());
       assert(dwr->pRewriteTextFormat->GetFontSize() >= 10 * dwr->dpiScaleFontPoint);
