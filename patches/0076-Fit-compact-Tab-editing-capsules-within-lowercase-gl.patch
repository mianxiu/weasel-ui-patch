 > **2026-10-01 Tab 输入序号外观：** 末尾正在输入的序号使用浅灰色圆角背景和深灰文字，字号与前面的 Tab 音节一致，外侧填充沿用 Tab 音节的左右及上下留白。
 > **2026-10-01 Tab 序号连续输入：** 相邻序号键间隔小于 350 毫秒才拼接编号；超时或插入其他按键会清空待拼接前缀，保留最后选择。每次数字按键重新计时，松键不打断连续输入。超时在下次按键时判定，不重绘或移动已选音节。
diff --git a/WeaselUI/DirectWriteResources.cpp b/WeaselUI/DirectWriteResources.cpp
index 3ef6ee8..8966480 100644
--- a/WeaselUI/DirectWriteResources.cpp
+++ b/WeaselUI/DirectWriteResources.cpp
@@ -143,7 +143,7 @@ HRESULT DirectWriteResources::InitResources(const wstring& label_font_face,
   const auto glyphMetrics = [&](ComPtr<IDWriteTextFormat1>& format, const wchar_t* glyph) {
     std::pair<float,float> result{format->GetFontSize() * .7f, format->GetFontSize()};
     ComPtr<IDWriteTextLayout> text;
-    if (SUCCEEDED(pDWFactory->CreateTextLayout(glyph, 1, format.Get(), 1000, 1000, &text))) {
+    if (SUCCEEDED(pDWFactory->CreateTextLayout(glyph, (UINT32)wcslen(glyph), format.Get(), 1000, 1000, &text))) {
       DWRITE_OVERHANG_METRICS ink{}; DWRITE_LINE_METRICS line{}; UINT32 count = 0;
       if (SUCCEEDED(text->GetOverhangMetrics(&ink)))
         result.first = (std::max)(1.f, 1000.f + ink.top + ink.bottom);
@@ -156,6 +156,14 @@ HRESULT DirectWriteResources::InitResources(const wstring& label_font_face,
   const float ratio = (std::max)(.55f, (std::min)(1.f, lower.first / digit.first));
   init_font(font_face, rewritePoint * ratio, pRewriteLabelTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
   rewriteLabelBaselineOffset = lower.second - glyphMetrics(pRewriteLabelTextFormat, L"0").second;
+  // Both editing capsules fit inside the pronunciation's visible lowercase s.
+  rewriteBadgeHeight = (std::max)(1, (int)floor(lower.first));
+  const float padding = (std::min)(dpiScaleLayout, rewriteBadgeHeight * .15f);
+  init_font(font_face, rewritePoint * .5f, pRewriteBadgeTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
+  const float badgeInk = glyphMetrics(pRewriteBadgeTextFormat, L"0123456789abcdefghijklmnopqrstuvwxyz/").first;
+  init_font(font_face, rewritePoint * .5f * (rewriteBadgeHeight - 2 * padding) / badgeInk,
+            pRewriteBadgeTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
+  pRewriteBadgeTextFormat->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_CENTER);
   init_font(label_font_face, label_font_point, pLabelTextFormat, wrapping);
   init_font(comment_font_face, comment_font_point, pCommentTextFormat,
             wrapping);
diff --git a/WeaselUI/RewriteLayout.h b/WeaselUI/RewriteLayout.h
index 6b51213..f560a93 100644
--- a/WeaselUI/RewriteLayout.h
+++ b/WeaselUI/RewriteLayout.h
@@ -31,13 +31,43 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
   };
   for (size_t unitIndex = 0; unitIndex < units.size(); ++unitIndex) {
     const auto& unit = units[unitIndex];
+    if (unit.badge) {
+      CSize digits(0, 0), editing(0, 0), row(0, 0);
+      layout.GetTextSizeDW(L"s", 1, dwr->pRewriteTextFormat, dwr, &row);
+      if (!state.index.empty())
+        layout.GetTextSizeDW(state.index, state.index.size(), dwr->pRewriteBadgeTextFormat, dwr, &digits);
+      if (!state.replacement.empty())
+        layout.GetTextSizeDW(state.replacement, state.replacement.size(), dwr->pRewriteBadgeTextFormat, dwr, &editing);
+      const int pad = (std::max)(1, (int)ceil(dwr->dpiScaleLayout));
+      const int dw = state.index.empty() ? 0 : digits.cx + pad * 2;
+      const int ew = state.replacement.empty() ? 0 : editing.cx + pad * 2;
+      const int between = dw && ew ? pad * 2 : 0;
+      const int w = vertical ? (std::max)(dw, ew) : dw + between + ew;
+      const int h = vertical ? dwr->rewriteBadgeHeight * ((dw && ew) ? 2 : 1) + between : row.cy;
+      const int span = vertical ? h : w;
+      if (!unwrapped && limit > 0 && advance > 0 && advance + span > limit) {
+        cross += line + gap; advance = 0; line = 0;
+      }
+      const int x = vertical ? cross : advance, y = vertical ? advance : cross;
+      const int top = vertical ? y : y + (row.cy - dwr->rewriteBadgeHeight) / 2;
+      CRect number, text;
+      number.SetRectEmpty(); text.SetRectEmpty();
+      if (dw) number.SetRect(x, top, x + dw, top + dwr->rewriteBadgeHeight);
+      if (ew) {
+        const int tx = x + (vertical ? 0 : dw + between);
+        const int ty = top + (vertical && dw ? dwr->rewriteBadgeHeight + between : 0);
+        text.SetRect(tx, ty, tx + ew, ty + dwr->rewriteBadgeHeight);
+      }
+      auto shown = unit; shown.label = state.index; shown.text = state.replacement;
+      result.cells.push_back({shown, CRect(x, y, x + w, y + h), text, number, number});
+      result.size.cx = (std::max<LONG>)(result.size.cx, x + w);
+      result.size.cy = (std::max<LONG>)(result.size.cy, y + h);
+      advance += span + gap; line = (std::max)(line, vertical ? w : h);
+      continue;
+    }
     CSize text(0, 0), label(0, 0);
     std::wstring number;
-    if (unit.badge) {
-      number = state.index;
-      if (!number.empty())
-        layout.GetTextSizeDW(number, number.size(), dwr->pRewriteLabelTextFormat, dwr, &label);
-    } else if (!unit.label.empty() && !hiddenNumber(unit.label)) {
+    if (!unit.label.empty() && !hiddenNumber(unit.label)) {
       wchar_t formatted[128];
       swprintf_s(formatted, style.label_text_format.c_str(), unit.label.c_str());
       number = formatted;
@@ -45,8 +75,8 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     }
     const int labelOffset = vertical ? 0 : (std::max)(0, (int)ceil(dwr->rewriteLabelBaselineOffset));
     const int lw = number.empty() ? 0 : label.cx + px * 2;
-    const auto& textValue = unit.badge ? state.replacement : unit.text;
-    const int prefixGap = unit.badge ? gap : margin;
+    const auto& textValue = unit.text;
+    const int prefixGap = margin;
     // A replacement may contain many pronunciations in one original slot.
     // Wrap that text too, leaving room for its visible group prefix.
     const int savedWidth = layout._style.max_width;
