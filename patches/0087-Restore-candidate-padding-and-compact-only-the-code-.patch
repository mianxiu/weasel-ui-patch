From 5869dd26b6cbd7aab9917939e3bd872646ecaf71 Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Fri, 2 Oct 2026 22:25:20 +0800
Subject: [PATCH] Restore candidate padding and compact only the code and Tab
 rows

---
 REWRITE-UI.md                    | 1 +
 WeaselUI/HorizontalLayout.cpp    | 2 +-
 WeaselUI/Layout.cpp              | 2 +-
 WeaselUI/VerticalLayout.cpp      | 2 +-
 WeaselUI/WeaselPanel.cpp         | 2 +-
 rewrite-build.txt                | 2 +-
 rime/skins/azure_pill.yaml       | 6 +++---
 rime/skins/azure_pill_black.yaml | 6 +++---
 rime/skins/azure_pill_green.yaml | 6 +++---
 rime/skins/azure_pill_navy.yaml  | 6 +++---
 test/rewrite_pipeline_test.cpp   | 4 ++--
 11 files changed, 20 insertions(+), 19 deletions(-)

diff --git a/REWRITE-UI.md b/REWRITE-UI.md
index 8cd4306..78520ac 100644
--- a/REWRITE-UI.md
+++ b/REWRITE-UI.md
@@ -1,3 +1,4 @@
+> **2026-10-02 仅缩小编码留白：** 恢复中文主候选的高亮 padding 5、外边距 8、行距 6 和原有圆角比例；仅普通编码单行槽与 Tab 音节高亮使用半量上下 padding。连接圆角和普通编码／Tab 切换框高稳定继续保留。
 > **2026-10-02 上下留白减半：** 四款 Azure Pill 皮肤的上下高亮 padding 从 5 改为 2（整数像素向下取整），外部 margin_y 从 8 改为 4，行距从 6 改为 3；Tab 额外连接留白从 4 改为 2。普通编码与 Tab 行高仍保持一致，连接圆角保留。
 > **2026-10-02 非行内 Tab 连接高亮修复：** 单行槽增加上下留白后，选中音节背景延伸至主候选边缘，恢复相交区域的连接圆角；不移动文字或修改候选框高度。仅最后一行音节可与主候选首行相连，横向不相交的选择继续独立显示。
 > **2026-10-02 非行内 Tab 稳定布局：** inline_preedit:false 时 Tab 音节行固定在主候选上方；普通编码与 Tab 使用相同的单行高度及上下留白，文字垂直居中。横排和竖排候选均覆盖；Tab 拼音实际换行仍按内容增高。
diff --git a/WeaselUI/HorizontalLayout.cpp b/WeaselUI/HorizontalLayout.cpp
index 9fe2c5a..59a9f49 100644
--- a/WeaselUI/HorizontalLayout.cpp
+++ b/WeaselUI/HorizontalLayout.cpp
@@ -66,7 +66,7 @@ void HorizontalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
       GetTextSizeDW(L"s", 1, pDWR->pPreeditTextFormat, pDWR, &codeLine);
       GetTextSizeDW(L"s", 1, pDWR->pRewriteTextFormat, pDWR, &tabLine);
       const int lineHeight = max(codeLine.cy, max(tabLine.cy, pDWR->rewriteBadgeHeight));
-      szy = max(szy, lineHeight) + 2 * _style.hilite_padding_y;
+      szy = max(szy, lineHeight) + 2 * (_style.hilite_padding_y / 2);
     }
     // icon size higher then preedit text
     int yoffset = (STATUS_ICON_SIZE >= szy && ShouldDisplayStatusIcon())
diff --git a/WeaselUI/Layout.cpp b/WeaselUI/Layout.cpp
index fee3140..ced26c0 100644
--- a/WeaselUI/Layout.cpp
+++ b/WeaselUI/Layout.cpp
@@ -23,7 +23,7 @@ Layout::Layout(const UIStyle& style,
     _style.inline_preedit = false;
   }
   if (_context.rewrite.active() || !_configuredInlinePreedit) {
-    _style.spacing = (std::max)(_style.spacing, _style.hilite_padding_y + 2);
+    _style.spacing = (std::max)(_style.spacing, _style.hilite_padding_y + 4);
   }
   if (pDWR) {
     float scale = pDWR->dpiScaleLayout;
diff --git a/WeaselUI/VerticalLayout.cpp b/WeaselUI/VerticalLayout.cpp
index 0789c31..850b3ff 100644
--- a/WeaselUI/VerticalLayout.cpp
+++ b/WeaselUI/VerticalLayout.cpp
@@ -57,7 +57,7 @@ void weasel::VerticalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
       GetTextSizeDW(L"s", 1, pDWR->pPreeditTextFormat, pDWR, &codeLine);
       GetTextSizeDW(L"s", 1, pDWR->pRewriteTextFormat, pDWR, &tabLine);
       const int lineHeight = max(codeLine.cy, max(tabLine.cy, pDWR->rewriteBadgeHeight));
-      szy = max(szy, lineHeight) + 2 * _style.hilite_padding_y;
+      szy = max(szy, lineHeight) + 2 * (_style.hilite_padding_y / 2);
     }
     // icon size higher then preedit text
     int yoffset = (STATUS_ICON_SIZE >= szy && ShouldDisplayStatusIcon())
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 29a948a..6d5e86f 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -918,7 +918,7 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
       } else if (cell.unit.active) {
         auto back = cell.back; back.OffsetRect(rc.left, rc.top);
         // Pad the painted fill, without changing text layout or window height.
-        back.InflateRect(DPI_SCALE(4), DPI_SCALE(m_style.hilite_padding_y));
+        back.InflateRect(DPI_SCALE(4), DPI_SCALE(m_style.hilite_padding_y / 2));
         // Keep a compact 2px reach toward the main highlight on either side.
         if (m_candidateCount && rc.bottom <= m_layout->GetCandidateTextRect(0).top)
           back.bottom += DPI_SCALE(2);
