 namespace {
 // Out-of-context callbacks run on the registering window message thread.
 thread_local std::map<HWINEVENTHOOK, std::pair<HWND, HWND>> positionHooks;
+thread_local HHOOK positionMessageHook = nullptr;
+thread_local std::map<std::pair<HWND, HWND>, bool> positionMessageTargets;
+LRESULT CALLBACK HostPositionMessage(int code, WPARAM wParam, LPARAM lParam) {
+  if (code >= 0) {
+    const auto* message = reinterpret_cast<const CWPRETSTRUCT*>(lParam);
+    if (message->message == WM_WINDOWPOSCHANGED) {
+      // Copy targets before sending: reentrant window messages may unregister them.
+      std::vector<HWND> targets;
+      for (const auto& target : positionMessageTargets)
+        if (target.first.first == message->hwnd) targets.push_back(target.first.second);
+      for (const auto panel : targets)
+        ::SendMessage(panel, WeaselPanel::POSITION_CHANGED,
+                      reinterpret_cast<WPARAM>(message->hwnd), 0);
+    }
+  }
+  return ::CallNextHookEx(nullptr, code, wParam, lParam);
+}
 void CALLBACK HostLocationChanged(HWINEVENTHOOK hook, DWORD event, HWND window,
                                  LONG object, LONG child, DWORD, DWORD) {
   const auto found = positionHooks.find(hook);
   if (event == EVENT_OBJECT_LOCATIONCHANGE && object == OBJID_WINDOW &&
       child == CHILDID_SELF && found != positionHooks.end() &&
       window == found->second.second)
-    ::PostMessage(found->second.first, WeaselPanel::POSITION_CHANGED,
+    ::SendMessage(found->second.first, WeaselPanel::POSITION_CHANGED,
                   reinterpret_cast<WPARAM>(window), 0);
 }
 }
@@ -1273,6 +1290,14 @@ LRESULT WeaselPanel::OnDpiChanged(UINT uMsg,
 
 void WeaselPanel::_RemovePositionSubscription() {
   ::KillTimer(m_hWnd, POSITION_TIMER);
+  if (m_positionMessageHook) {
+    positionMessageTargets.erase({m_hookHost, m_hWnd});
+    m_positionMessageHook = false;
+    if (positionMessageTargets.empty() && positionMessageHook) {
+      ::UnhookWindowsHookEx(positionMessageHook);
+      positionMessageHook = nullptr;
+    }
+  }
   if (m_positionHook) {
     positionHooks.erase(m_positionHook);
     ::UnhookWinEvent(m_positionHook);
@@ -1287,10 +1312,22 @@ void WeaselPanel::_UpdatePositionSubscription() {
       !::IsWindow(m_positionHost)) {
     _RemovePositionSubscription(); return;
   }
-  if (m_positionHook && m_hookHost == m_positionHost) return;
+  if ((m_positionHook || m_positionMessageHook) && m_hookHost == m_positionHost) return;
   _RemovePositionSubscription();
   DWORD process = 0;
-  ::GetWindowThreadProcessId(m_positionHost, &process);
+  const DWORD hostThread = ::GetWindowThreadProcessId(m_positionHost, &process);
+  if (hostThread == ::GetCurrentThreadId()) {
+    if (!positionMessageHook)
+      positionMessageHook = ::SetWindowsHookEx(WH_CALLWNDPROCRET,
+          HostPositionMessage, nullptr, hostThread);
+    if (positionMessageHook) {
+      m_positionMessageHook = true;
+      m_hookHost = m_positionHost;
+      positionMessageTargets[{m_hookHost, m_hWnd}] = true;
+      _FollowHostWindow();
+      return;
+    }
+  }
   m_positionHook = ::SetWinEventHook(EVENT_OBJECT_LOCATIONCHANGE,
       EVENT_OBJECT_LOCATIONCHANGE, nullptr, HostLocationChanged,
       process, 0, WINEVENT_OUTOFCONTEXT);
@@ -1323,13 +1360,15 @@ LRESULT WeaselPanel::OnPositionTimer(UINT, WPARAM id, LPARAM, BOOL& handled) {
 }
 
 void WeaselPanel::_FollowHostWindow() {
-  if (m_editOnly || !m_status.composing || !IsWindowVisible() ||
+  if (m_followingHost || m_editOnly || !m_status.composing || !IsWindowVisible() ||
       !::IsWindow(m_positionHost) || (m_lastCaretRect.bottom <= m_lastCaretRect.top)) return;
   CPoint origin(0, 0);
   if (!::ClientToScreen(m_positionHost, &origin) || origin == m_hostOrigin) return;
   CRect caret = m_lastCaretRect;
   caret.OffsetRect(origin - m_hostOrigin);
+  m_followingHost = true;
   MoveTo(caret, m_positionHost);
+  m_followingHost = false;
 }
 
