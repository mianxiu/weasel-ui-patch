+    // A host on a different thread retains the WinEvent fallback, without a timer.
+    std::promise<HWND> ready; auto readyWindow = ready.get_future();
+    std::atomic<bool> stopWorker{false};
+    std::thread worker([&] {
+      HWND other = CreateWindowEx(0, L"STATIC", L"other thread host", WS_POPUP,
+          100, 100, 400, 300, nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
+      ShowWindow(other, SW_SHOWNOACTIVATE);
+      ready.set_value(other);
+      while (!stopWorker.load()) {
+        MSG message;
+        while (PeekMessage(&message, nullptr, 0, 0, PM_REMOVE)) {
+          TranslateMessage(&message); DispatchMessage(&message);
+        }
+        Sleep(1);
+      }
+      DestroyWindow(other);
