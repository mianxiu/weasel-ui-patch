@@ -1388,7 +1427,7 @@ void WeaselPanel::MoveTo(RECT const& rc, HWND host) {
     m_inputPos = irc;
     _RepositionWindow(true);
     RedrawWindow();
-  } else if (m_sourceCtx.rewrite.active() || !(rc.left == m_inputPos.left && rc.bottom != m_inputPos.bottom &&
+  } else if (m_followingHost || m_sourceCtx.rewrite.active() || !(rc.left == m_inputPos.left && rc.bottom != m_inputPos.bottom &&
                abs(rc.bottom - m_inputPos.bottom) < 6) ||
              m_layout->ShouldDisplayStatusIcon()) {
     // in some apps like word 2021, with inline_preedit set,
@@ -1567,11 +1606,13 @@ void WeaselPanel::_UpdateRewriteWindow() {
   m_joinEditorWidth = m_editPanel->m_joinEditorWidth = childContent.Width();
   m_istorepos = reverse;
   const CPoint delta = placement.candidate.TopLeft() - visible.TopLeft();
-  if (m_candidateCount) SetWindowPos(HWND_TOPMOST, candidate.left + delta.x, candidate.top + delta.y, 0, 0,
+  if (m_candidateCount && (delta.x || delta.y)) SetWindowPos(HWND_TOPMOST, candidate.left + delta.x, candidate.top + delta.y, 0, 0,
                                     SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOREDRAW);
   m_editPanel->SetWindowPos(HWND_TOPMOST, placement.editor.left - childContent.left,
       placement.editor.top - childContent.top, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOREDRAW);
-  m_editPanel->ShowWindow(IsWindowVisible() ? SW_SHOWNA : SW_HIDE);
+  const bool showEditor = IsWindowVisible() != FALSE;
+  if ((m_editPanel->IsWindowVisible() != FALSE) != showEditor)
+    m_editPanel->ShowWindow(showEditor ? SW_SHOWNA : SW_HIDE);
   if (repaintEditor) m_editPanel->RedrawWindow();
   if (repaint && m_candidateCount) RedrawWindow();
 }
