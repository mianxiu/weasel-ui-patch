diff --git a/rime/lua/indexed_rewrite_pro.lua b/rime/lua/indexed_rewrite_pro.lua
index e5ada02..3028999 100644
--- a/rime/lua/indexed_rewrite_pro.lua
+++ b/rime/lua/indexed_rewrite_pro.lua
@@ -15,9 +15,9 @@
 --      jxjirzbj//3jm
 --      -> 把第 3 音节替换为 jm
 --
--- 原生 Weasel UI 读取 property；索引仅用 1–6，7–0 为声调。
+-- 原生 Weasel UI 读取 property；索引仅用 1–4，5/6 不操作，7–0 为声调。
 --   //      -> 进入音节选择
---   //3     -> 选择第三音节；第七项编号为 11
+--   //3     -> 选择第三音节；第五项编号为 11
 --
 -- 单个 / 始终先交给万象 Pro。
 -- 只有第二个连续 / 到来时才进入本脚本。
@@ -76,20 +76,20 @@ local function is_slash(repr)
 end
 
 local function is_digit(repr)
-    return #repr == 1 and repr:match("^[1-6]$") ~= nil
+    return #repr == 1 and repr:match("^[1-4]$") ~= nil
 end
 
 local function is_tone(repr)
     return #repr == 1 and repr:match("^[7890]$") ~= nil
 end
 
--- Bijective base six: 1..6, 11..16, 21..26, ...; never use tone keys.
+-- Bijective base four: 1..4, 11..14, 21..24, ...; never use tone keys.
 local function decode_index(label)
     if label == "" then return nil end
     local n = 0
     for digit in label:gmatch(".") do
-        if not digit:match("^[1-6]$") then return nil end
-        n = n * 6 + tonumber(digit)
+        if not digit:match("^[1-4]$") then return nil end
+        n = n * 4 + tonumber(digit)
         if n > 256 then return nil end
     end
     return n
@@ -331,6 +331,10 @@ function M.func(key, env)
         stage = ""
     end
 
+    if stage ~= "" and (repr == "5" or repr == "6") then
+        return ACCEPTED
+    end
+
     if stage ~= "" and is_digit(repr) then
         local ranges = parse_ranges(get_prop(ctx, PROP_RANGES))
         local prefix = get_prop(ctx, PROP_INDEX_PREFIX)
