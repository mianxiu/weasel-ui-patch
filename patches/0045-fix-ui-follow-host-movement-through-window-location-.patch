 #include "WeaselPanel.h"
 
 #include <utility>
+#include <map>
+
+namespace {
+// Out-of-context callbacks run on the registering window message thread.
+thread_local std::map<HWINEVENTHOOK, std::pair<HWND, HWND>> positionHooks;
+void CALLBACK HostLocationChanged(HWINEVENTHOOK hook, DWORD event, HWND window,
+                                 LONG object, LONG child, DWORD, DWORD) {
+  const auto found = positionHooks.find(hook);
+  if (event == EVENT_OBJECT_LOCATIONCHANGE && object == OBJID_WINDOW &&
+      child == CHILDID_SELF && found != positionHooks.end() &&
+      window == found->second.second)
+    ::PostMessage(found->second.first, WeaselPanel::POSITION_CHANGED,
+                  reinterpret_cast<WPARAM>(window), 0);
+}
+}
+
