   return LRESULT();
 }
 
+void WeaselPanel::_RemovePositionSubscription() {
+  ::KillTimer(m_hWnd, POSITION_TIMER);
+  if (m_positionHook) {
+    positionHooks.erase(m_positionHook);
+    ::UnhookWinEvent(m_positionHook);
+    m_positionHook = nullptr;
+  }
+  m_hookHost = nullptr;
+}
+
+void WeaselPanel::_UpdatePositionSubscription() {
+  // Install on the window thread; IPC worker threads have no message pump.
+  if (m_editOnly || !m_status.composing || !IsWindowVisible() ||
+      !::IsWindow(m_positionHost)) {
+    _RemovePositionSubscription(); return;
+  }
+  if (m_positionHook && m_hookHost == m_positionHost) return;
+  _RemovePositionSubscription();
+  DWORD process = 0;
+  ::GetWindowThreadProcessId(m_positionHost, &process);
+  m_positionHook = ::SetWinEventHook(EVENT_OBJECT_LOCATIONCHANGE,
+      EVENT_OBJECT_LOCATIONCHANGE, nullptr, HostLocationChanged,
+      process, 0, WINEVENT_OUTOFCONTEXT);
+  if (m_positionHook) {
+    m_hookHost = m_positionHost;
+    positionHooks[m_positionHook] = {m_hWnd, m_hookHost};
+  } else {
+    // Only fall back to polling if Windows cannot register the hook.
+    ::SetTimer(m_hWnd, POSITION_TIMER, 16, nullptr);
+  }
+  _FollowHostWindow();
+}
+
+LRESULT WeaselPanel::OnPositionSetup(UINT, WPARAM, LPARAM, BOOL&) {
+  _UpdatePositionSubscription(); return 0;
+}
+
+LRESULT WeaselPanel::OnPositionChanged(UINT, WPARAM host, LPARAM, BOOL&) {
+  if (reinterpret_cast<HWND>(host) == m_positionHost) {
+    ++m_positionEventCount;
+    _FollowHostWindow();
+  }
+  return 0;
+}
+
 LRESULT WeaselPanel::OnPositionTimer(UINT, WPARAM id, LPARAM, BOOL& handled) {
   handled = id == POSITION_TIMER;
-  if (!handled || m_editOnly || !m_status.composing || !IsWindowVisible() ||
-      !::IsWindow(m_positionHost) || (m_lastCaretRect.bottom <= m_lastCaretRect.top)) return 0;
+  if (handled) _FollowHostWindow();
+  return 0;
+}
+
+void WeaselPanel::_FollowHostWindow() {
+  if (m_editOnly || !m_status.composing || !IsWindowVisible() ||
+      !::IsWindow(m_positionHost) || (m_lastCaretRect.bottom <= m_lastCaretRect.top)) return;
   CPoint origin(0, 0);
-  if (!::ClientToScreen(m_positionHost, &origin) || origin == m_hostOrigin) return 0;
+  if (!::ClientToScreen(m_positionHost, &origin) || origin == m_hostOrigin) return;
   CRect caret = m_lastCaretRect;
   caret.OffsetRect(origin - m_hostOrigin);
   MoveTo(caret, m_positionHost);
-  return 0;
 }
 
