From: mianxiu <mianxiu8481@gmail.com>
Date: Fri, 2 Oct 2026 18:55:52 +0800
Subject: [PATCH] Reduce vertical padding and spacing for compact Tab
 candidates

---
 REWRITE-UI.md                    | 1 +
 WeaselUI/Layout.cpp              | 2 +-
 WeaselUI/WeaselPanel.cpp         | 6 +++---
 rewrite-build.txt                | 2 +-
 rime/skins/azure_pill.yaml       | 6 +++---
 rime/skins/azure_pill_black.yaml | 6 +++---
 rime/skins/azure_pill_green.yaml | 6 +++---
 rime/skins/azure_pill_navy.yaml  | 6 +++---
 test/rewrite_pipeline_test.cpp   | 5 ++++-
 9 files changed, 22 insertions(+), 18 deletions(-)

diff --git a/REWRITE-UI.md b/REWRITE-UI.md
index 13fec0c..8cd4306 100644
--- a/REWRITE-UI.md
+++ b/REWRITE-UI.md
@@ -1,3 +1,4 @@
+> **2026-10-02 上下留白减半：** 四款 Azure Pill 皮肤的上下高亮 padding 从 5 改为 2（整数像素向下取整），外部 margin_y 从 8 改为 4，行距从 6 改为 3；Tab 额外连接留白从 4 改为 2。普通编码与 Tab 行高仍保持一致，连接圆角保留。
 > **2026-10-02 非行内 Tab 连接高亮修复：** 单行槽增加上下留白后，选中音节背景延伸至主候选边缘，恢复相交区域的连接圆角；不移动文字或修改候选框高度。仅最后一行音节可与主候选首行相连，横向不相交的选择继续独立显示。
 > **2026-10-02 非行内 Tab 稳定布局：** inline_preedit:false 时 Tab 音节行固定在主候选上方；普通编码与 Tab 使用相同的单行高度及上下留白，文字垂直居中。横排和竖排候选均覆盖；Tab 拼音实际换行仍按内容增高。
 > **2026-10-02 普通编码纯文字：** 非行内模式的普通编码去掉高亮背景，统一使用普通文字色；关闭软光标符号。Tab 编辑高亮及分组编号填充保留。新增 Collect-IME-Diagnostics.cmd，只读导出 Windows 构建/更新、输入组件版本、触摸键盘状态和运行应用实际加载的 Weasel DLL 构建标识，供两台系统对比。
diff --git a/WeaselUI/Layout.cpp b/WeaselUI/Layout.cpp
index ced26c0..fee3140 100644
--- a/WeaselUI/Layout.cpp
+++ b/WeaselUI/Layout.cpp
@@ -23,7 +23,7 @@ Layout::Layout(const UIStyle& style,
     _style.inline_preedit = false;
   }
   if (_context.rewrite.active() || !_configuredInlinePreedit) {
-    _style.spacing = (std::max)(_style.spacing, _style.hilite_padding_y + 4);
+    _style.spacing = (std::max)(_style.spacing, _style.hilite_padding_y + 2);
   }
   if (pDWR) {
     float scale = pDWR->dpiScaleLayout;
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 6c9681f..29a948a 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -919,11 +919,11 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
         auto back = cell.back; back.OffsetRect(rc.left, rc.top);
         // Pad the painted fill, without changing text layout or window height.
         back.InflateRect(DPI_SCALE(4), DPI_SCALE(m_style.hilite_padding_y));
-        // Leave 4px between the text and the main highlight edge on either side.
+        // Keep a compact 2px reach toward the main highlight on either side.
         if (m_candidateCount && rc.bottom <= m_layout->GetCandidateTextRect(0).top)
-          back.bottom += DPI_SCALE(4);
+          back.bottom += DPI_SCALE(2);
         else
-          back.top -= DPI_SCALE(4);
+          back.top -= DPI_SCALE(2);
         Gdiplus::GraphicsPath joined;
         CRect candidate, bounds;
         if (m_candidateCount && !stable) {
