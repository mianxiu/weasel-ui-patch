 > **2026-10-01 Tab 换行与分组编号：** 横排 Tab 行以当前主候选区域的实际宽度作为换行边界，保留右侧高亮填充及皮肤留白，不再由长拼音行撑宽整个候选框。一个原音节替换为长拼音串时，文本本身也可换行。前四项编号保持隐藏；之后每组四项仅显示开头 11、21、31、41、111…，组内其余编号隐藏。选择键仍仅使用 1–4，5/6 无操作，7–0 输入声调。
diff --git a/WeaselUI/RewriteLayout.h b/WeaselUI/RewriteLayout.h
index fd8451b..6b51213 100644
--- a/WeaselUI/RewriteLayout.h
+++ b/WeaselUI/RewriteLayout.h
@@ -33,7 +33,11 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     const auto& unit = units[unitIndex];
     CSize text(0, 0), label(0, 0);
     std::wstring number;
-    if (!unit.label.empty() && !hiddenNumber(unit.label)) {
+    if (unit.badge) {
+      number = state.index;
+      if (!number.empty())
+        layout.GetTextSizeDW(number, number.size(), dwr->pRewriteLabelTextFormat, dwr, &label);
+    } else if (!unit.label.empty() && !hiddenNumber(unit.label)) {
       wchar_t formatted[128];
       swprintf_s(formatted, style.label_text_format.c_str(), unit.label.c_str());
       number = formatted;
@@ -41,17 +45,21 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     }
     const int labelOffset = vertical ? 0 : (std::max)(0, (int)ceil(dwr->rewriteLabelBaselineOffset));
     const int lw = number.empty() ? 0 : label.cx + px * 2;
+    const auto& textValue = unit.badge ? state.replacement : unit.text;
+    const int prefixGap = unit.badge ? gap : margin;
     // A replacement may contain many pronunciations in one original slot.
     // Wrap that text too, leaving room for its visible group prefix.
     const int savedWidth = layout._style.max_width;
     if (!vertical && !unwrapped && limit > 0)
-      layout._style.max_width = (std::max)(1, limit - (lw ? lw + margin : 0));
-    layout.GetTextSizeDW(unit.text, unit.text.size(), dwr->pRewriteTextFormat,
-                        dwr, &text);
+      layout._style.max_width = (std::max)(1, limit - (lw ? lw + prefixGap : 0));
+    if (!textValue.empty())
+      layout.GetTextSizeDW(textValue, textValue.size(), dwr->pRewriteTextFormat,
+                          dwr, &text);
     layout._style.max_width = savedWidth;
     const int lh = number.empty() ? 0 : label.cy + py * 2 + labelOffset;
-    const int w = vertical ? (std::max<LONG>)(text.cx, lw) : text.cx + (lw ? margin + lw : 0);
-    const int h = vertical ? text.cy + (lh ? margin + lh : 0) : (std::max<LONG>)(text.cy, lh);
+    const int separation = textValue.empty() ? 0 : prefixGap;
+    const int w = vertical ? (std::max<LONG>)(text.cx, lw) : text.cx + (lw ? separation + lw : 0);
+    const int h = vertical ? text.cy + (lh ? separation + lh : 0) : (std::max<LONG>)(text.cy, lh);
     const int span = vertical ? h : w;
     if (!unwrapped && limit > 0 && advance > 0 && advance + span > limit) {
       cross += line + gap; advance = 0; line = 0;
@@ -65,8 +73,8 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
       lb.SetRect(bx, by, bx + lw, by + lh);
       lr.SetRect(bx + px, by + py + labelOffset, bx + px + label.cx, by + py + labelOffset + label.cy);
     }
-    if (lw) tr.OffsetRect(vertical ? 0 : lw + margin, vertical ? lh + margin : py);
-    auto shown = unit; shown.label = number;
+    if (lw) tr.OffsetRect(vertical ? 0 : lw + separation, vertical ? lh + separation : py);
+    auto shown = unit; shown.label = number; shown.text = textValue;
     result.cells.push_back({shown, CRect(x, y, x + w, y + h), tr, lb, lr});
     result.size.cx = (std::max<LONG>)(result.size.cx, x + w);
     result.size.cy = (std::max<LONG>)(result.size.cy, y + h);
@@ -111,10 +119,10 @@ inline RewriteLayout MeasureStableRewrite(Layout& layout, const RewriteState& st
   for (auto& cell : result.cells) {
     int dx = vertical ? 0 : -shift, dy = vertical ? -shift : 0;
     if (cell.unit.badge) {
-      dx = editor.left - cell.text.left;
-      dy = editor.top - cell.text.top;
-      if (vertical) dy -= (std::max)(0, cell.text.Height() - editor.Height());
-      else dx -= (std::max)(0, cell.text.Width() - editor.Width());
+      dx = editor.left - cell.back.left;
+      dy = editor.top - cell.back.top;
+      if (vertical) dy -= (std::max)(0, cell.back.Height() - editor.Height());
+      else dx -= (std::max)(0, cell.back.Width() - editor.Width());
     }
     cell.back.OffsetRect(dx, dy); cell.text.OffsetRect(dx, dy);
     cell.labelBack.OffsetRect(dx, dy); cell.label.OffsetRect(dx, dy);
