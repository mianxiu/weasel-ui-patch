+                         BackType::TEXT, IsToRoundStruct());
+        }
       } else if (cell.unit.active) {
         auto back = cell.back; back.OffsetRect(rc.left, rc.top);
         // Pad the painted fill, without changing text layout or window height.
@@ -949,11 +958,13 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
           D2D1::RectF((float)clip.left, (float)clip.top, (float)clip.right, (float)clip.bottom),
           D2D1_ANTIALIAS_MODE_ALIASED);
       // Ordinary candidate-style numbering and pronunciation share a baseline.
-      _TextOut(cell.text, cell.unit.text, cell.unit.text.size(), color,
