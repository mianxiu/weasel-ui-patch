 using namespace weasel;
 
 void HorizontalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
+  if (_context.rewrite.active() && candidates_count) {
+    // Measure the candidate body independently so the Tab row cannot widen it.
+    auto body = _context;
+    body.rewrite.clear(); body.preedit.clear(); body.aux.clear();
+    HorizontalLayout candidateLayout(_style, body, _status, nullptr);
+    candidateLayout.DoLayout(dc, pDWR);  // _style is already DPI-scaled.
+    rewrite_max_width = (std::max)(1, candidateLayout.GetContentRect().Width() -
+        real_margin_x * 2 - (int)ceil(4 * pDWR->dpiScaleLayout));
+  }
   CSize size;
   int width = offsetX + real_margin_x, height = offsetY + real_margin_y;
   int w = offsetX + real_margin_x;
@@ -57,7 +66,8 @@ void HorizontalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
     _preeditRect.SetRect(w, height + yoffset, w + size.cx,
                          height + yoffset + size.cy);
     height += szy + 2 * yoffset + _style.spacing;
-    width = max(width, real_margin_x * 2 + size.cx + szx);
+    width = max(width, (_context.rewrite.active() ? offsetX + real_margin_x :
+                        real_margin_x * 2) + size.cx + szx);
     if (ShouldDisplayStatusIcon())
       width += STATUS_ICON_SIZE;
   }
