From ef00f56161f2def09efabd66449e2d4dffef683d Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Thu, 1 Oct 2026 00:11:09 +0800
Subject: [PATCH 44/61] perf(ui): update following at 16ms and reuse editor
 layout during movement

---
 Install-Binaries.ps1           |  2 +-
 WeaselUI/WeaselPanel.cpp       | 11 +++++++++--
 WeaselUI/WeaselPanel.h         |  2 ++
 rewrite-build.txt              |  2 +-
 test/rewrite_pipeline_test.cpp |  9 +++++++++
 5 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index 7100e84..f51b8f0 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -144,7 +144,7 @@ try {
   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-zero-width-caret-follow-20260930; profile: $profileName"
+  Write-Host "Build: rewrite-ui-smooth-follow-20261001; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 8eb003e..659638b 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -113,6 +113,7 @@ void WeaselPanel::_ResizeWindow() {
 }
 
 void WeaselPanel::_CreateLayout() {
+  ++m_layoutGeneration;
   if (m_layout != NULL)
     delete m_layout;
 
@@ -146,7 +147,7 @@ void WeaselPanel::_CreateLayout() {
 void WeaselPanel::Refresh() {
   m_ctx = m_sourceCtx;
   if (!m_editOnly && IsWindow()) {
-    if (m_status.composing) ::SetTimer(m_hWnd, POSITION_TIMER, 50, nullptr);
+    if (m_status.composing) ::SetTimer(m_hWnd, POSITION_TIMER, 16, nullptr);
     else ::KillTimer(m_hWnd, POSITION_TIMER);
   }
   if (!m_editOnly) m_ctx.rewrite.clear();
@@ -1464,7 +1465,13 @@ void WeaselPanel::_UpdateRewriteWindow() {
   }
   m_editPanel->m_editLeadingInset = 0;
   m_editPanel->m_inputPos = (m_lastCaretRect.bottom <= m_lastCaretRect.top) ? m_inputPos : m_lastCaretRect;
-  m_editPanel->Refresh();
+  UINT targetDpiX = 96, targetDpiY = 96;
+  if (m_hMonitor) GetDpiForMonitor(m_hMonitor, MDT_EFFECTIVE_DPI, &targetDpiX, &targetDpiY);
+  // Pure movement reuses the measured text and painted layered surface.
+  // Rebuild only for content, style or DPI changes.
+  if (!m_editPanel->m_layout || m_editPanel->m_ctx != m_editUI->ctx() ||
+      m_editPanel->m_ostyle != style || m_editPanel->dpi != targetDpiX)
+    m_editPanel->Refresh();
   CRect candidate; GetWindowRect(&candidate);
   CRect visible = m_layout->GetContentRect(); visible.OffsetRect(candidate.TopLeft());
   if (m_candidateCount) m_lastCandidateSurface = visible;
diff --git a/WeaselUI/WeaselPanel.h b/WeaselUI/WeaselPanel.h
index 9a9e421..a9a0555 100644
--- a/WeaselUI/WeaselPanel.h
+++ b/WeaselUI/WeaselPanel.h
@@ -70,6 +70,7 @@ class WeaselPanel
   bool GetIsReposition() { return m_istorepos; }
   void RedrawWindow();
   HWND RewriteWindow() const { return m_editPanel ? m_editPanel->m_hWnd : nullptr; }
+  size_t RewriteLayoutGeneration() const { return m_editPanel ? m_editPanel->m_layoutGeneration : 0; }
   CRect SurfaceRect() const {
     CRect window; GetWindowRect(&window);
     CRect surface = m_layout ? m_layout->GetContentRect() : CRect();
@@ -146,6 +147,7 @@ class WeaselPanel
   const bool m_editOnly;
   std::unique_ptr<weasel::UI> m_editUI;
   std::unique_ptr<WeaselPanel> m_editPanel;
+  size_t m_layoutGeneration = 0;
   int m_editLeadingInset = 0;
   int m_joinSide = 0;
   int m_joinCandidateWidth = 0, m_joinEditorWidth = 0;
diff --git a/rewrite-build.txt b/rewrite-build.txt
index 5591701..079075c 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-zero-width-caret-follow-20260930
+Build-ID: rewrite-ui-smooth-follow-20261001
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: compact joined tone-pinyin label; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index 4aec3dc..287bc77 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -229,10 +229,12 @@ int main() {
     }
     panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     auto hostCandidate = panel.SurfaceRect(); auto hostEditor = panel.RewriteSurfaceRect();
+    const auto layoutGeneration = panel.RewriteLayoutGeneration();
     SetWindowPos(inputHost, nullptr, 150, 150, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER);
     panel.OnPositionTimer(WM_TIMER, 20240316, 0, handled);
     hostCandidate.OffsetRect(20, 30); hostEditor.OffsetRect(20, 30);
     assert(panel.SurfaceRect() == hostCandidate && panel.RewriteSurfaceRect() == hostEditor);
+    assert(panel.RewriteLayoutGeneration() == layoutGeneration);
     assert(panel.RewriteTextRect().left == panel.CandidateTextRect().left);
     panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     // Both surfaces follow horizontal movement and even a one-pixel vertical change.
@@ -241,6 +243,13 @@ int main() {
     movedCandidate.OffsetRect(30, 1); movedEditor.OffsetRect(30, 1);
     assert(panel.SurfaceRect() == movedCandidate);
     assert(panel.RewriteSurfaceRect() == movedEditor);
+    assert(panel.RewriteLayoutGeneration() == layoutGeneration);
+    for (int frame = 1; frame <= 24; ++frame)
+      panel.MoveTo(CRect(230 + frame, 201 + frame, 230 + frame, 225 + frame), inputHost);
+    assert(panel.RewriteLayoutGeneration() == layoutGeneration);
+    auto updated = indexed; updated.cinfo = normal.cinfo;
+    host.ctx() = updated; panel.Refresh();
+    assert(panel.RewriteLayoutGeneration() > layoutGeneration);
     assert(panel.RewriteTextRect().left == panel.CandidateTextRect().left);
     host.ctx() = normal; panel.Refresh(); panel.MoveTo(CRect(200, 200, 200, 224));
     CRect after; panel.GetWindowRect(&after);
-- 
2.53.0.windows.2

