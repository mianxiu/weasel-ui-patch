+BOOL WeaselTSF::_SetRewriteDisplayAttribute(TfEditCookie ec, ITfContext* context,
+                                           ITfRange* range, LONG start, LONG end) {
+  if (!range || start < 0 || end <= start ||
+      _gaDisplayAttributeRewrite == TF_INVALID_GUIDATOM) return FALSE;
