diff --git a/include/InlineRewrite.h b/include/InlineRewrite.h
new file mode 100644
index 0000000..2323fb2
--- /dev/null
+++ b/include/InlineRewrite.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "RewriteState.h"
+#include <algorithm>
+
+namespace weasel {
+// A range in the existing UTF-16 preedit, never a selection or committed text.
+struct InlineRewriteRange {
+  size_t start = 0, end = 0;
+  explicit operator bool() const { return start < end; }
+};
+
+inline InlineRewriteRange ProjectInlineRewrite(const RewriteState& r,
+                                               const std::wstring& preedit) {
+  if (!r.active() || r.input.empty() || r.input.size() > 4096) return {};
+  std::vector<std::pair<size_t, size_t>> spans;
+  size_t p = 0;
+  while (p < r.ranges.size()) {
+    size_t a = 0, b = 0;
+    // Units() has already validated the grammar and ASCII byte boundaries.
+    RewriteState::Number(r.ranges, p, a);
+    ++p;
+    RewriteState::Number(r.ranges, p, b);
+    spans.emplace_back(a, b);
+    if (p < r.ranges.size()) ++p;
+  }
+  size_t target = 1;
+  if (!r.index.empty()) {
+    p = 0;
+    if (!RewriteState::Number(r.index, p, target)) return {};
+  }
+  if (r.stage == L"head_replace") {
+    target = spans.size();
+    for (size_t i = 0; i < spans.size(); ++i)
+      if (r.replacement.size() <= spans[i].second) { target = i + 1; break; }
+  }
+  if (target == 0 || target > spans.size()) return {};
+  size_t a = spans[target - 1].first, b = spans[target - 1].second;
+  std::wstring expected = r.original;
+  if (r.stage == L"index_replace") {
+    expected.replace(a, b - a, r.replacement);
+    b = a + r.replacement.size();
+  } else if (r.stage == L"head_replace") {
+    expected = r.replacement + r.original.substr((std::min)(r.replacement.size(), r.original.size()));
+    if (target == spans.size()) b = expected.size();
+  }
+  if (expected != r.input || a >= b || b > r.input.size()) return {};
+
+  // Accept only exact raw codes, optionally separated by display-only spaces.
+  // Expanded pinyin, Hanzi previews, surrogates and decorations fall back.
+  std::vector<size_t> positions;
+  p = 0;
+  for (auto c : r.input) {
+    while (p < preedit.size() && preedit[p] == L' ' && c != L' ') ++p;
+    if (p == preedit.size() || preedit[p] != c) return {};
+    positions.push_back(p++);
+  }
+  while (p < preedit.size() && preedit[p] == L' ') ++p;
+  if (p != preedit.size()) return {};
+  return {positions[a], positions[b - 1] + 1};
+}
+}  // namespace weasel
diff --git a/include/InlineRewriteUpdate.h b/include/InlineRewriteUpdate.h
new file mode 100644
index 0000000..10b84c9
--- /dev/null
+++ b/include/InlineRewriteUpdate.h
@@ -0,0 +1,31 @@
+#pragma once
+#include "InlineRewrite.h"
+
+namespace weasel {
+// Shared edit policy; the TSF adapter owns locks, ranges and COM calls.
+// Keeping the operations explicit lets tests assert that property-only keys
+// never write text or move a host selection.
+template <class Editor>
+bool UpdateInlinePreedit(Editor& editor, const RewriteState& state,
+                         std::wstring preedit, int cursor,
+                         bool enabled, bool rawEnabled) {
+  if (!editor.IsCurrent()) return false;
+  const bool rewriting = enabled && state.active();
+  // Keep raw display stable while the user types an out-of-range multi-digit
+  // index. It has no target, but must not rewrite preedit on each index key.
+  const bool unchangedInput = (state.stage == L"armed" || state.stage == L"index") &&
+                              state.input == state.original;
+  const bool raw = rewriting && rawEnabled &&
+                   (unchangedInput || bool(ProjectInlineRewrite(state, state.input)));
+  if (raw) { preedit = state.input; cursor = -1; }
+  const bool attributesOnly = rewriting && editor.SameText(preedit);
+  if (!attributesOnly && !editor.WriteText(preedit)) return false;
+  editor.SetRaw(raw);
+  if (editor.ResetAttributes() && rewriting) {
+    const auto target = ProjectInlineRewrite(state, preedit);
+    if (target) editor.Highlight(target);
+  }
+  // Attribute failure still leaves the panel visible; it must not move caret.
+  return attributesOnly || editor.SetCaret(cursor, preedit.size());
+}
+}  // namespace weasel
