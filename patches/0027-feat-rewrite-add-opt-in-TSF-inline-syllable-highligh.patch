diff --git a/test/inline_attribute_test.cpp b/test/inline_attribute_test.cpp
new file mode 100644
index 0000000..cdbc97f
--- /dev/null
+++ b/test/inline_attribute_test.cpp
@@ -0,0 +1,48 @@
+#include <windows.h>
+#include <msctf.h>
+#include <cassert>
+#include <iostream>
+
+// Load the built DLL without registering/activating an IME or touching Rime.
+int wmain(int argc, wchar_t** argv) {
+  assert(argc == 2);
+  assert(SUCCEEDED(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED)));
+  auto dll = LoadLibraryW(argv[1]);
+  assert(dll);
+  auto getClass = reinterpret_cast<HRESULT(STDAPICALLTYPE*)(REFCLSID, REFIID, void**)>(
+      GetProcAddress(dll, "DllGetClassObject"));
+  assert(getClass);
+  const GUID clsid = {0xa3f4cded,0xb1e9,0x41ee,{0x9c,0xa6,0x7b,0x4d,0x0d,0xe6,0xcb,0x0a}};
+  const GUID rewrite = {0x7e70395b,0x566d,0x4e4d,{0xa3,0x52,0x54,0x36,0xb4,0x4e,0x87,0xa1}};
+  IClassFactory* factory = nullptr;
+  assert(SUCCEEDED(getClass(clsid, IID_IClassFactory, reinterpret_cast<void**>(&factory))));
+  ITfDisplayAttributeProvider* provider = nullptr;
+  assert(SUCCEEDED(factory->CreateInstance(nullptr, IID_ITfDisplayAttributeProvider,
+                                           reinterpret_cast<void**>(&provider))));
+  IEnumTfDisplayAttributeInfo* items = nullptr;
+  assert(provider->EnumDisplayAttributeInfo(&items) == S_OK);
+  ITfDisplayAttributeInfo* attrs[3] = {};
+  ULONG count = 0;
+  assert(items->Next(3, attrs, &count) == S_FALSE && count == 2);
+  GUID actual;
+  assert(attrs[1]->GetGUID(&actual) == S_OK && IsEqualGUID(actual, rewrite));
+  TF_DISPLAYATTRIBUTE target;
+  assert(attrs[1]->GetAttributeInfo(&target) == S_OK);
+  assert(target.crBk.type == TF_CT_SYSCOLOR && target.crBk.nIndex == COLOR_HIGHLIGHT);
+  assert(target.crText.type == TF_CT_SYSCOLOR && target.crText.nIndex == COLOR_HIGHLIGHTTEXT);
+  assert(target.bAttr == TF_ATTR_TARGET_NOTCONVERTED);
+  assert(items->Reset() == S_OK && items->Skip(1) == S_OK);
+  IEnumTfDisplayAttributeInfo* clone = nullptr;
+  assert(items->Clone(&clone) == S_OK);
+  ITfDisplayAttributeInfo* item = nullptr;
+  assert(clone->Next(1, &item, &count) == S_OK && count == 1);
+  assert(item->GetGUID(&actual) == S_OK && IsEqualGUID(actual, rewrite));
+  item->Release(); clone->Release();
+  assert(items->Skip(2) == S_FALSE);
+  assert(provider->GetDisplayAttributeInfo(rewrite, &item) == S_OK);
+  item->Release();
+  attrs[0]->Release(); attrs[1]->Release(); items->Release(); provider->Release(); factory->Release();
+  FreeLibrary(dll);
+  CoUninitialize();
+  std::cout << "PASS: built TSF DLL attribute lookup, enumeration, clone and system colors\n";
+}
diff --git a/test/inline_rewrite_test.cpp b/test/inline_rewrite_test.cpp
new file mode 100644
index 0000000..29666c2
--- /dev/null
+++ b/test/inline_rewrite_test.cpp
@@ -0,0 +1,101 @@
+#include <InlineRewrite.h>
+#include <InlineRewriteUpdate.h>
+#include <cassert>
+#include <iostream>
+
+using weasel::ProjectInlineRewrite;
+struct Editor {
+  std::wstring text;
+  int writes = 0, carets = 0, resets = 0, highlights = 0;
+  bool current = true, writable = true, attributes = true, raw = false;
+  weasel::InlineRewriteRange target;
+  bool IsCurrent() { return current; }
+  bool SameText(const std::wstring& value) { return text == value; }
+  bool WriteText(const std::wstring& value) { ++writes; if (!writable) return false; text = value; return true; }
+  void SetRaw(bool value) { raw = value; }
+  bool ResetAttributes() { ++resets; target = {}; return attributes; }
+  void Highlight(weasel::InlineRewriteRange value) { ++highlights; target = value; }
+  bool SetCaret(int, size_t) { ++carets; return true; }
+};
+void range(const weasel::RewriteState& r, const std::wstring& text, size_t a, size_t b) {
+  auto result = ProjectInlineRewrite(r, text);
+  assert(result.start == a && result.end == b);
+}
+int main() {
+  weasel::RewriteState r;
+  r.stage = L"armed";
+  r.original = r.input = L"jxjirzbj";
+  r.ranges = L"0-2,2-4,4-6,6-8";
+  range(r, r.input, 0, 2);
+  r.stage = L"index"; r.index = L"3";
+  range(r, r.input, 4, 6);
+  range(r, L"jx ji rz bj", 6, 8);
+  range(r, L"  jx ji rz bj  ", 8, 10);
+  assert(!ProjectInlineRewrite(r, L"jiang jin ren zhi"));
+  assert(!ProjectInlineRewrite(r, L"测试"));
+  assert(!ProjectInlineRewrite(r, L"jxjirzbj¹"));
+  assert(!ProjectInlineRewrite(r, L"jxji\U0001F600rzbj"));
+  r.index = L"32"; assert(!ProjectInlineRewrite(r, r.input));
+  r.index = L"0"; assert(!ProjectInlineRewrite(r, r.input));
+  r.index = L"3"; r.stage = L"index_replace";
+  for (auto replacement : {L"j", L"jm", L"abcd"}) {
+    r.replacement = replacement;
+    r.input = L"jxji" + r.replacement + L"bj";
+    range(r, r.input, 4, 4 + r.replacement.size());
+  }
+  r.replacement.clear(); r.input = L"jxjibj";
+  assert(!ProjectInlineRewrite(r, r.input));
+  r.stage = L"head_replace"; r.index.clear();
+  r.replacement = L"abc"; r.input = L"abcirzbj";
+  range(r, r.input, 2, 4);
+  r.replacement = L"abcdefghij"; r.input = r.replacement;
+  range(r, r.input, 6, 10);
+  r.input += L"x"; assert(!ProjectInlineRewrite(r, r.input));
+  r.stage.clear(); assert(!ProjectInlineRewrite(r, r.input));
+  // Raw separators remain part of input; ranges may skip them.
+  r.stage = L"index"; r.index = L"2";
+  r.original = r.input = L"ab'cd"; r.ranges = L"0-2,3-5";
+  range(r, r.input, 3, 5);
+  r.ranges = L"0-2,1-5"; assert(!ProjectInlineRewrite(r, r.input));
+  r.ranges = L"0-2,3-6"; assert(!ProjectInlineRewrite(r, r.input));
+  r.original = r.input = L""; r.ranges.clear();
+  for (int i = 0; i < 32; ++i) {
+    r.original += L"ab";
+    if (i) r.ranges += L",";
+    r.ranges += std::to_wstring(i * 2) + L"-" + std::to_wstring(i * 2 + 2);
+  }
+  r.input = r.original; r.index = L"32";
+  range(r, r.input, 62, 64);
+  r.index = L"99999999"; assert(!ProjectInlineRewrite(r, r.input));
+  r.index = L"3";
+  Editor editor;
+  editor.text = r.input;
+  assert(weasel::UpdateInlinePreedit(editor, r, r.input, 0, true, false));
+  assert(editor.writes == 0 && editor.carets == 0 && editor.target.start == 4);
+  r.index = L"12";
+  assert(weasel::UpdateInlinePreedit(editor, r, r.input, 0, true, false));
+  assert(editor.writes == 0 && editor.carets == 0 && editor.target.start == 22);
+  editor.attributes = false;
+  assert(weasel::UpdateInlinePreedit(editor, r, r.input, 0, true, false));
+  assert(editor.writes == 0 && editor.carets == 0 && !editor.target);
+  editor.current = false;
+  const int resets = editor.resets;
+  assert(!weasel::UpdateInlinePreedit(editor, r, L"new composition", 0, true, true));
+  assert(editor.resets == resets && editor.writes == 0);
+  editor.current = editor.attributes = true;
+  editor.text = L"formatted preedit";
+  assert(weasel::UpdateInlinePreedit(editor, r, editor.text, 0, true, false));
+  assert(!editor.target && editor.writes == 0 && !editor.raw);
+  assert(weasel::UpdateInlinePreedit(editor, r, editor.text, 0, true, true));
+  assert(editor.raw && editor.text == r.input && editor.writes == 1 && editor.carets == 1);
+  r.index = L"999";
+  assert(weasel::UpdateInlinePreedit(editor, r, L"formatted preedit", 0, true, true));
+  assert(editor.raw && !editor.target && editor.writes == 1 && editor.carets == 1);
+  r.stage.clear();
+  assert(weasel::UpdateInlinePreedit(editor, r, L"formatted preedit", 0, true, true));
+  assert(!editor.raw && !editor.target && editor.text == L"formatted preedit");
+  editor.writable = false;
+  assert(!weasel::UpdateInlinePreedit(editor, r, L"different", 0, true, true));
+  std::cout << "PASS: inline ranges, unchanged-text index changes, replacements, separators, invalid input and UTF-16 fallback\n";
+  std::cout << "PASS: edit operations, no text/caret writes for index keys, stale composition guard, attribute failure, explicit raw mode and exit\n";
+}
