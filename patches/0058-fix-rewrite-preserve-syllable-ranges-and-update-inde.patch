+    ["ń"]="n", ["ň"]="n", ["ǹ"]="n", ["ḿ"]="m",
+}
+local finals = {}
+for final in ("a o e ai ei ao ou an en ang eng ong i ia ie iao iu ian in iang ing iong u ua uo uai ui uan un uang ueng v ve van vn er"):gmatch("%S+") do
+    finals[final] = true
+end
+local function is_pinyin(token)
+    local plain = ""
+    for _, code in utf8.codes(token) do
+        local char = utf8.char(code)
+        if code >= 0x300 and code <= 0x36f then -- decomposed tone marks
+        else plain = plain .. (plain_vowels[char] or char) end
+    end
+    if plain == "m" or plain == "n" or plain == "ng" then return true end
+    plain = plain:gsub("^[zcs]h", ""):gsub("^[bpmfdtnlgkhjqxrzcswy]", "")
+    return finals[plain] == true
+end
+
+local function pronunciation(comment)
+    local parts = {}
+    for token in (comment or ""):gmatch("[^%s'|]+") do
+        token = token:gsub("[%[%]]", ""):match("^[^;]+") or ""
+        local valid = token ~= ""
+        for _, c in utf8.codes(token) do
+            if not ((c >= 97 and c <= 122) or (c >= 0xc0 and c <= 0x24f)
+                    or (c >= 0x300 and c <= 0x36f)) then valid = false end
+        end
+        if not valid or not is_pinyin(token) then return {} end
+        parts[#parts + 1] = token
+    end
+    return parts
+end
+
+local function split_pinyin(value)
+    local parts = {}
+    for token in (value .. "|"):gmatch("([^|]*)|") do parts[#parts + 1] = token end
