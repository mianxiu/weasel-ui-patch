-                if token ~= "" then parts[#parts + 1] = token end
-            end
-            local line = cand.text .. "\t" .. table.concat(parts, "|") .. "\n"
-            if #parts > 0 and #records + #line <= 8000 then
-                records = records .. line
-                set_prop(ctx, PROP_HINTS, records)
+        local genuine = cand:get_genuine()
+        local parts = pronunciation(genuine.comment)
+        if #parts == 0 and env.reverse then
+            local ok, reading = pcall(function() return env.reverse:lookup(cand.text) end)
+            if ok then parts = pronunciation(reading) end
+        end
+        local pinyin = table.concat(parts, "|")
+        local line = cand.text .. "\t" .. pinyin .. "\n"
+        -- Do not discard readings just because a candidate is beyond position 32.
+        if #parts > 0 and #records + #line <= 8000 then
+            records = records .. line
+            set_prop(ctx, PROP_HINTS, records)
+        end
+        if first then
+            first = false
+            local stage = get_prop(ctx, PROP_STAGE)
+            local ranges = parse_ranges(get_prop(ctx, PROP_RANGES))
+            if stage == "index_replace" or stage == "head_replace" then
+                local original = split_pinyin(get_prop(ctx, PROP_PENDING))
