From b12d0e9c41ee347c8ccbd17a4b02f016d2acd7f1 Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Fri, 2 Oct 2026 22:30:36 +0800
Subject: [PATCH] Tighten code top margin and gap without changing candidate
 padding

---
 REWRITE-UI.md                  | 1 +
 WeaselUI/HorizontalLayout.cpp  | 4 +++-
 WeaselUI/VerticalLayout.cpp    | 4 +++-
 rewrite-build.txt              | 2 +-
 test/rewrite_pipeline_test.cpp | 7 +++++++
 5 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/REWRITE-UI.md b/REWRITE-UI.md
index 78520ac..82445f3 100644
--- a/REWRITE-UI.md
+++ b/REWRITE-UI.md
@@ -1,3 +1,4 @@
+> **2026-10-02 编码上下空隙收紧：** 非行内编码／Tab 行上方的外部留白、到主候选的行距各减半；仅调整编码行布局，中文候选尺寸、上下高亮 padding、底部边距、字号和圆角参数保持原值。
 > **2026-10-02 仅缩小编码留白：** 恢复中文主候选的高亮 padding 5、外边距 8、行距 6 和原有圆角比例；仅普通编码单行槽与 Tab 音节高亮使用半量上下 padding。连接圆角和普通编码／Tab 切换框高稳定继续保留。
 > **2026-10-02 上下留白减半：** 四款 Azure Pill 皮肤的上下高亮 padding 从 5 改为 2（整数像素向下取整），外部 margin_y 从 8 改为 4，行距从 6 改为 3；Tab 额外连接留白从 4 改为 2。普通编码与 Tab 行高仍保持一致，连接圆角保留。
 > **2026-10-02 非行内 Tab 连接高亮修复：** 单行槽增加上下留白后，选中音节背景延伸至主候选边缘，恢复相交区域的连接圆角；不移动文字或修改候选框高度。仅最后一行音节可与主候选首行相连，横向不相交的选择继续独立显示。
diff --git a/WeaselUI/HorizontalLayout.cpp b/WeaselUI/HorizontalLayout.cpp
index 59a9f49..1b46eb3 100644
--- a/WeaselUI/HorizontalLayout.cpp
+++ b/WeaselUI/HorizontalLayout.cpp
@@ -57,6 +57,7 @@ void HorizontalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
 
   /* Preedit */
   if (!IsInlinePreedit() && _context.HasPanelPreedit()) {
+    if (!_configuredInlinePreedit) height -= real_margin_y / 2;
     size = GetPreeditSize(dc, _context.preedit, pDWR->pPreeditTextFormat, pDWR);
     int szx = pgw, szy = max(size.cy, pgh);
     if (!_configuredInlinePreedit) {
@@ -74,7 +75,8 @@ void HorizontalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
                       : 0;
     _preeditRect.SetRect(w, height + yoffset + (szy - size.cy) / 2, w + size.cx,
                          height + yoffset + (szy - size.cy) / 2 + size.cy);
-    height += szy + 2 * yoffset + _style.spacing;
+    const int preeditGap = _configuredInlinePreedit ? _style.spacing : _style.spacing / 2;
+    height += szy + 2 * yoffset + preeditGap;
     width = max(width, (_context.rewrite.active() ? offsetX + real_margin_x :
                         real_margin_x * 2) + size.cx + szx);
     if (ShouldDisplayStatusIcon())
diff --git a/WeaselUI/VerticalLayout.cpp b/WeaselUI/VerticalLayout.cpp
index 850b3ff..76028ed 100644
--- a/WeaselUI/VerticalLayout.cpp
+++ b/WeaselUI/VerticalLayout.cpp
@@ -48,6 +48,7 @@ void weasel::VerticalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
   CSize size;
   /* Preedit */
   if (!IsInlinePreedit() && _context.HasPanelPreedit()) {
+    if (!_configuredInlinePreedit) height -= real_margin_y / 2;
     size = GetPreeditSize(dc, _context.preedit, pDWR->pPreeditTextFormat, pDWR);
     int szx = pgw, szy = max(size.cy, pgh);
     if (!_configuredInlinePreedit) {
@@ -65,7 +66,8 @@ void weasel::VerticalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
                       : 0;
     _preeditRect.SetRect(real_margin_x, height + yoffset + (szy - size.cy) / 2,
                          real_margin_x + size.cx, height + yoffset + (szy - size.cy) / 2 + size.cy);
-    height += szy + 2 * yoffset + _style.spacing;
+    const int preeditGap = _configuredInlinePreedit ? _style.spacing : _style.spacing / 2;
+    height += szy + 2 * yoffset + preeditGap;
     width = max(width, real_margin_x * 2 + size.cx + szx);
     if (ShouldDisplayStatusIcon())
       width += STATUS_ICON_SIZE;
diff --git a/rewrite-build.txt b/rewrite-build.txt
index aa3336d..9a599e9 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-code-only-padding-20261002
+Build-ID: rewrite-ui-tight-code-row-20261002
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: integrated Tab preedit row with ordinary prefix numbers; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index 5a3b437..8087028 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -303,6 +303,13 @@ int main() {
           tabLayout.reset(new weasel::HorizontalLayout(fixedStyle, tab, status, fixedDwr));
         }
         normalLayout->DoLayout(dc, fixedDwr); tabLayout->DoLayout(dc, fixedDwr);
+        auto candidatesOnly = ordinary; candidatesOnly.preedit.clear();
+        std::unique_ptr<weasel::Layout> candidateLayout;
+        if (mode == 0) candidateLayout.reset(new weasel::VerticalLayout(fixedStyle, candidatesOnly, status, fixedDwr));
+        else candidateLayout.reset(new weasel::HorizontalLayout(fixedStyle, candidatesOnly, status, fixedDwr));
+        candidateLayout->DoLayout(dc, fixedDwr);
+        assert(normalLayout->GetCandidateRect(0).Height() == candidateLayout->GetCandidateRect(0).Height());
+        assert(normalLayout->GetPreeditRect().top < candidateLayout->GetCandidateTextRect(0).top);
         assert(normalLayout->GetContentSize().cy == tabLayout->GetContentSize().cy);
         assert(normalLayout->GetCandidateRect(0).top == tabLayout->GetCandidateRect(0).top);
         const auto before = tabLayout->GetPreeditRect();
-- 
2.53.0.windows.2

