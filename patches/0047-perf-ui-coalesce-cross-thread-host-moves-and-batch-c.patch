+bool WeaselPanel::_TranslateSurfaces(const CPoint& delta, const CRect& caret) {
+  // Moving existing layered surfaces needs no context copies, layout or repaint.
+  // Bounds/monitor/placement changes still use the full positioning path.
+  if (!m_layout || m_style.layout_type == UIStyle::LAYOUT_VERTICAL_FULLSCREEN ||
+      m_style.layout_type == UIStyle::LAYOUT_HORIZONTAL_FULLSCREEN ||
+      MonitorFromRect(caret, MONITOR_DEFAULTTONEAREST) != m_hMonitor ||
+      (m_sticky && (abs(delta.x) > 50 || abs(delta.y) > 50))) return false;
+  MONITORINFO monitor = {sizeof(MONITORINFO)};
+  if (!GetMonitorInfo(m_hMonitor, &monitor)) return false;
+  CRect candidate; GetWindowRect(&candidate); candidate.OffsetRect(delta);
+  CRect editor;
+  const bool moveEditor = m_editPanel && m_editPanel->IsWindow() && m_editPanel->IsWindowVisible();
+  if (m_sourceCtx.rewrite.active() && !moveEditor) return false;
+  if (moveEditor) { m_editPanel->GetWindowRect(&editor); editor.OffsetRect(delta); }
+  const auto inside = [&](const CRect& rect) {
+    return rect.left >= monitor.rcWork.left && rect.top >= monitor.rcWork.top &&
+           rect.right <= monitor.rcWork.right && rect.bottom <= monitor.rcWork.bottom;
+  };
+  if (!inside(candidate) || (moveEditor && !inside(editor))) return false;
+  const UINT flags = SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOREDRAW;
+  // Both are top-level popups; batch the two surfaces into one positioning operation.
+  HDWP batch = ::BeginDeferWindowPos(moveEditor ? 2 : 1);
+  if (batch) batch = ::DeferWindowPos(batch, m_hWnd, nullptr,
+      candidate.left, candidate.top, 0, 0, flags);
+  if (batch && moveEditor) batch = ::DeferWindowPos(batch, m_editPanel->m_hWnd, nullptr,
+      editor.left, editor.top, 0, 0, flags);
+  if (!batch || !::EndDeferWindowPos(batch)) return false;
+  m_lastCaretRect = caret;
+  m_inputPos.OffsetRect(delta);
+  m_hostOrigin += delta;
+  if (!m_lastCandidateSurface.IsRectEmpty()) m_lastCandidateSurface.OffsetRect(delta);
+  if (moveEditor) m_editPanel->m_inputPos.OffsetRect(delta);
+  ++m_positionFastMoves;
+  return true;
+}
