diff --git a/WeaselUI/DirectWriteResources.cpp b/WeaselUI/DirectWriteResources.cpp
index da4a9c7..b9925ec 100644
--- a/WeaselUI/DirectWriteResources.cpp
+++ b/WeaselUI/DirectWriteResources.cpp
@@ -98,7 +98,7 @@ HRESULT DirectWriteResources::InitResources(const wstring& label_font_face,
   if (_style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT)
     baseline = linespacing / 2;
 
-  auto init_font = [&](const wstring& fontface, int fontpoint,
+  auto init_font = [&](const wstring& fontface, float fontpoint,
                        ComPtr<IDWriteTextFormat1>& _pTextFormat,
                        DWRITE_WORD_WRAPPING wrap) {
     vector<wstring> fontFaceStrVector;
@@ -137,8 +137,25 @@ HRESULT DirectWriteResources::InitResources(const wstring& label_font_face,
   };
   init_font(font_face, font_point, pTextFormat, wrapping);
   init_font(font_face, font_point, pPreeditTextFormat, wrapping_preedit);
-  init_font(font_face, (std::max)(8, (int)(font_point * 0.60f)),
-            pRewriteTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
+  const float rewritePoint = (std::max)(10.f, font_point * 0.80f);
+  init_font(font_face, rewritePoint, pRewriteTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
+  // Measure the real fallback glyphs: digits should match lowercase x-height.
+  const auto glyphMetrics = [&](ComPtr<IDWriteTextFormat1>& format, const wchar_t* glyph) {
+    std::pair<float,float> result{format->GetFontSize() * .7f, format->GetFontSize()};
+    ComPtr<IDWriteTextLayout> text;
+    if (SUCCEEDED(pDWFactory->CreateTextLayout(glyph, 1, format.Get(), 1000, 1000, &text))) {
+      DWRITE_OVERHANG_METRICS ink{}; DWRITE_LINE_METRICS line{}; UINT32 count = 0;
+      if (SUCCEEDED(text->GetOverhangMetrics(&ink)))
+        result.first = (std::max)(1.f, 1000.f + ink.top + ink.bottom);
+      if (SUCCEEDED(text->GetLineMetrics(&line, 1, &count)) && count) result.second = line.baseline;
+    }
+    return result;
+  };
+  const auto lower = glyphMetrics(pRewriteTextFormat, L"s");
+  const auto digit = glyphMetrics(pRewriteTextFormat, L"0");
+  const float ratio = (std::max)(.55f, (std::min)(1.f, lower.first / digit.first));
+  init_font(font_face, rewritePoint * ratio, pRewriteLabelTextFormat, DWRITE_WORD_WRAPPING_NO_WRAP);
+  rewriteLabelBaselineOffset = lower.second - glyphMetrics(pRewriteLabelTextFormat, L"0").second;
   init_font(label_font_face, label_font_point, pLabelTextFormat, wrapping);
   init_font(comment_font_face, comment_font_point, pCommentTextFormat,
             wrapping);
