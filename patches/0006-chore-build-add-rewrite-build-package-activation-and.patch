diff --git a/enable-rewrite-ui.ps1 b/enable-rewrite-ui.ps1
new file mode 100644
index 0000000..26d6cef
--- /dev/null
+++ b/enable-rewrite-ui.ps1
@@ -0,0 +1,44 @@
+[CmdletBinding()]
+param(
+  [string]$UserDataRoot = (Join-Path $env:APPDATA 'Rime'),
+  [switch]$Apply,
+  [switch]$DisableDebug
+)
+$ErrorActionPreference = 'Stop'
+# Transform complete lines only; generated build files belong to librime.
+$uiPath = Join-Path $UserDataRoot 'weasel.custom.yaml'
+$schemaPath = Join-Path $UserDataRoot 'wanxiang_pro.custom.yaml'
+$ui = [IO.File]::ReadAllLines($uiPath)
+$schema = [IO.File]::ReadAllLines($schemaPath)
+if (@($ui | Where-Object { $_ -ceq 'patch:' }).Count -ne 1) {
+  throw 'Expected exactly one top-level patch map in weasel.custom.yaml.'
+}
+if ($ui -match '^[ \t]+rewrite_ui:') { throw 'Nested rewrite_ui map requires manual reconciliation.' }
+$debugValue = if ($DisableDebug) { 'false' } else { 'true' }
+$newUi = @(
+  foreach ($line in $ui) {
+    if ($line -match '^  ["'']?rewrite_ui/(enabled|debug)["'']?:') { continue }
+    $line
+    if ($line -ceq 'patch:') {
+      '  rewrite_ui/enabled: true'
+      "  rewrite_ui/debug: $debugValue"
+    }
+  }
+)
+$legacy = '^  engine/filters/@before last:[ \t]*lua_filter@\*indexed_rewrite_tab_ui_v2[ \t]*$'
+$newSchema = @($schema | Where-Object { $_ -notmatch $legacy })
+if (-not ($newSchema -cmatch '^  engine/processors/@before 0: lua_processor@\*indexed_rewrite_pro$') -or
+    -not ($newSchema -cmatch '^  key_binder/bindings/\+:$') -or
+    -not ($newSchema -cmatch '^  speller/algebra:$')) {
+  throw 'Expected intact rewrite processor, Tab bindings and algebra patches.'
+}
+Write-Output 'Validated: only two UI switches and the legacy filter line change.'
+if (!$Apply) { Write-Output 'Preview only. No files changed.'; return }
+$stamp = (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [Guid]::NewGuid().ToString('N').Substring(0,8)
+Copy-Item -LiteralPath $uiPath -Destination "$uiPath.rewrite-backup-$stamp"
+Copy-Item -LiteralPath $schemaPath -Destination "$schemaPath.rewrite-backup-$stamp"
+$utf8 = New-Object Text.UTF8Encoding($false)
+[IO.File]::WriteAllLines($uiPath, [string[]]$newUi, $utf8)
+[IO.File]::WriteAllLines($schemaPath, [string[]]$newSchema, $utf8)
+Write-Output "Source configuration updated. Backup suffix: rewrite-backup-$stamp"
+Write-Output 'Run WeaselDeployer.exe /deploy and verify generated configuration before testing.'
diff --git a/package-rewrite.ps1 b/package-rewrite.ps1
new file mode 100644
index 0000000..af06568
--- /dev/null
+++ b/package-rewrite.ps1
@@ -0,0 +1,46 @@
+$ErrorActionPreference = 'Stop'
+Set-Location $PSScriptRoot
+$destination = Join-Path $PSScriptRoot 'dist/Weasel-Rewrite-UI'
+New-Item -ItemType Directory -Force $destination, "$destination/Win32", "$destination/licenses" | Out-Null
+$rootFiles = @('WeaselServer.exe', 'WeaselDeployer.exe', 'WeaselSetup.exe',
+               'weasel.dll', 'weaselx64.dll', 'rime.dll', 'WinSparkle.dll')
+foreach ($name in $rootFiles) { Copy-Item "output/$name" "$destination/$name" -Force }
+foreach ($name in @('WeaselServer.exe', 'WeaselDeployer.exe', 'rime.dll', 'WinSparkle.dll')) {
+  Copy-Item "output/Win32/$name" "$destination/Win32/$name" -Force
+}
+Copy-Item REWRITE-UI.md "$destination/README.md" -Force
+Copy-Item rewrite-ui.custom.example.yaml $destination -Force
+Copy-Item Apply-Patch.cmd,Apply-Patch.ps1,rewrite-build.txt $destination -Force
+Copy-Item LICENSE.txt "$destination/licenses/Weasel-GPL-3.0.txt" -Force
+Copy-Item librime/LICENSE "$destination/licenses/librime-BSD.txt" -Force
+Copy-Item deps/boost_1_84_0/LICENSE_1_0.txt "$destination/licenses/Boost.txt" -Force
+Copy-Item deps/rime-x64/version-info.txt "$destination/librime-version-info.txt" -Force
+
+# Package the actual working source, including files not yet committed.
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$sourceZip = Join-Path $destination 'rewrite-source.zip'
+$sourceStream = [IO.File]::Open($sourceZip, [IO.FileMode]::Create)
+$sourceArchive = [IO.Compression.ZipArchive]::new($sourceStream, [IO.Compression.ZipArchiveMode]::Create)
+try {
+  $files = @(git ls-files) + @(
+    'include/RewriteState.h', 'WeaselUI/RewriteLayout.h', 'WeaselSetup/SetupTrace.h', 'build-rewrite.cmd',
+    'weasel.props', 'REWRITE-UI.md', 'rewrite-ui.custom.example.yaml',
+    'package-rewrite.ps1', 'Apply-Patch.cmd', 'Apply-Patch.ps1', 'rewrite-build.txt', 'test/patch_shutdown_test.ps1', 'test/rewrite_state_test.cpp',
+    'test/rewrite_pipeline_test.cpp', 'test/rewrite_rime_test.cpp',
+    'test/rime-fixture/default.yaml', 'test/rime-fixture/rewrite_test.schema.yaml')
+  foreach ($file in ($files | Sort-Object -Unique)) {
+    if ($file -match '^(output|lib|lib64)/' -or !(Test-Path -LiteralPath $file -PathType Leaf)) { continue }
+    [IO.Compression.ZipFileExtensions]::CreateEntryFromFile(
+      $sourceArchive, (Join-Path $PSScriptRoot $file), $file.Replace('\', '/')) | Out-Null
+  }
+} finally { $sourceArchive.Dispose(); $sourceStream.Dispose() }
+
+$hashes = Get-ChildItem $destination -Recurse -File | Where-Object { $_.Name -ne 'SHA256SUMS.txt' } |
+  ForEach-Object {
+    $hash = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash.ToLowerInvariant()
+    $relative = [IO.Path]::GetRelativePath($destination, $_.FullName)
+    "$hash  $relative"
+  }
+$hashes | Set-Content "$destination/SHA256SUMS.txt" -Encoding utf8
+Compress-Archive -Path "$destination/*" -DestinationPath 'dist/Weasel-Rewrite-UI.zip' -Force
+Get-Item 'dist/Weasel-Rewrite-UI.zip' | Select-Object FullName, Length
diff --git a/retry-registration.ps1 b/retry-registration.ps1
new file mode 100644
index 0000000..b3fc75c
--- /dev/null
+++ b/retry-registration.ps1
@@ -0,0 +1,23 @@
+$ErrorActionPreference = 'Stop'
+Start-Transcript -Path (Join-Path $PSScriptRoot 'retry-registration.log') -Force
+try {
+  $root = 'C:\Program Files\Rime\weasel-0.17.4'
+  $old = Get-Process -Id 60476 -ErrorAction SilentlyContinue
+  if ($old) {
+    if ($old.Path -ine (Join-Path $root 'WeaselSetup.exe')) { throw 'Unexpected old process path' }
+    $old.Kill()
+    if (!$old.WaitForExit(5000)) { throw 'Old setup still running' }
+  }
+  Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'output/WeaselSetup.exe') -Destination (Join-Path $root 'WeaselSetup.exe') -Force
+  $env:WEASEL_SETUP_LOG = Join-Path $PSScriptRoot 'setup-stage.log'
+  $setup = Start-Process -FilePath (Join-Path $root 'WeaselSetup.exe') -ArgumentList '/s' -WindowStyle Hidden -PassThru
+  Write-Host "Setup PID: $($setup.Id)"
+  if (!$setup.WaitForExit(45000)) { throw 'Registration still running; inspect setup-stage.log before proceeding.' }
+  Write-Host "Setup exit: $($setup.ExitCode)"
+  if ($setup.ExitCode -ne 0) { throw 'Registration failed' }
+  foreach ($pair in @(@('weaselx64.dll','C:\Windows\System32\weasel.dll'),@('weasel.dll','C:\Windows\SysWOW64\weasel.dll'))) {
+    if ((Get-FileHash (Join-Path $root $pair[0])).Hash -ne (Get-FileHash $pair[1]).Hash) { throw "System DLL mismatch: $($pair[1])" }
+  }
+  Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'rewrite-build.txt') -Destination $root -Force
+  Write-Host 'SUCCESS: setup exited 0 and both system DLL hashes match.'
+} finally { Stop-Transcript }
