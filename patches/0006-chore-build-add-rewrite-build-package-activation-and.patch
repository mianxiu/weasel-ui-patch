--- /dev/null
+++ b/Apply-Patch.cmd
@@ -0,0 +1,9 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Apply-Patch.ps1"
+set "patch_result=%errorlevel%"
+echo.
+if not "%patch_result%"=="0" echo Patch failed. Read the message above; do not delete the backup.
+pause
+exit /b %patch_result%
diff --git a/Apply-Patch.ps1 b/Apply-Patch.ps1
new file mode 100644
index 0000000..7c75488
--- /dev/null
+++ b/Apply-Patch.ps1
@@ -0,0 +1,183 @@
+[CmdletBinding()]
+param([string]$Target, [switch]$CheckOnly, [string]$UserSid)
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 2
+
+function Read-WeaselRoot {
+  foreach ($view in @([Microsoft.Win32.RegistryView]::Registry32, [Microsoft.Win32.RegistryView]::Registry64)) {
+    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, $view)
+    try {
+      $key = $base.OpenSubKey('Software\Rime\Weasel')
+      if ($key) {
+        try { $value = $key.GetValue('WeaselRoot'); if ($value) { return [string]$value } }
+        finally { $key.Dispose() }
+      }
+    } finally { $base.Dispose() }
+  }
+  throw 'Existing Weasel installation not found. Use -Target with the installed Weasel directory.'
+}
+function Copy-Verified([string]$Source, [string]$Destination) {
+  Copy-Item -LiteralPath $Source -Destination $Destination -Force
+  if ((Get-FileHash -LiteralPath $Source).Hash -ne (Get-FileHash -LiteralPath $Destination).Hash) {
+    throw "Copy verification failed: $Destination"
+  }
+}
+function Start-WeaselCommand([string]$FilePath, [string]$Argument) {
+  $startInfo = New-Object System.Diagnostics.ProcessStartInfo
+  $startInfo.FileName = $FilePath
+  $startInfo.Arguments = $Argument
+  $startInfo.WorkingDirectory = Split-Path -Parent $FilePath
+  $startInfo.UseShellExecute = $false
+  return [System.Diagnostics.Process]::Start($startInfo)
+}
+function Register-Weasel([string]$Root, [string]$ProfileArgument) {
+  $process = Start-WeaselCommand (Join-Path $Root 'WeaselSetup.exe') $ProfileArgument
+  while (!$process.WaitForExit(10000)) {
+    Write-Host "Waiting for Windows input-method registration (PID $($process.Id))... Do not run another installer."
+  }
+  if ($process.ExitCode -ne 0) { throw "WeaselSetup failed: $($process.ExitCode)" }
+}
+
+function Stop-WeaselForPatch([string]$ServerPath) {
+  Write-Host 'Stopping Weasel (up to 10 seconds)...'
+  # Start-Process -Wait can wait for descendants, not just the /q helper.
+  $helper = Start-WeaselCommand $ServerPath '/q'
+  if (!$helper.WaitForExit(10000)) {
+    # Only terminate the helper created by this script, never a process tree.
+    $helper.Kill()
+    if (!$helper.WaitForExit(5000)) { throw 'Shutdown helper could not be stopped. No binaries were replaced.' }
+  }
+  $remaining = @(Get-Process WeaselServer -ErrorAction SilentlyContinue)
+  foreach ($server in $remaining) {
+    if (!$server.Path -or $server.Path -ine $ServerPath) {
+      throw 'A different or inaccessible Weasel process is running. No binaries were replaced.'
+    }
+  }
+  if ($remaining.Count) {
+    Write-Host 'Weasel did not exit normally. Save/finish any current input first.' -ForegroundColor Yellow
+    $answer = Read-Host 'Force-stop this installation? Unsaved input/learning may be lost. Type YES to continue'
+    if ($answer -cne 'YES') { throw 'Cancelled. No binaries were replaced. Exit Weasel and retry.' }
+    foreach ($server in $remaining) {
+      if (!$server.HasExited) { $server.Kill() }
+      if (!$server.WaitForExit(5000)) { throw 'Weasel could not be stopped. No binaries were replaced.' }
+    }
+  }
+  if (@(Get-Process WeaselServer -ErrorAction SilentlyContinue).Count) {
+    throw 'Weasel restarted. Close applications using the input method, then retry. No binaries were replaced.'
+  }
+  Write-Host 'Weasel stopped.'
+}
+
+try {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  if ($UserSid -and $UserSid -ne $identity.User.Value) {
+    throw 'Elevation changed the Windows user. Sign in as the installing user and run again.'
+  }
+  $arch = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
+  if ($arch -eq 'ARM64') { throw 'This package supports x64/x86 Windows only.' }
+  if (!$Target) { $Target = Read-WeaselRoot }
+  $Target = (Resolve-Path -LiteralPath $Target).Path.TrimEnd('\')
+  $package = (Resolve-Path -LiteralPath $PSScriptRoot).Path.TrimEnd('\')
+  if ($Target -eq $package -or $Target.StartsWith($package + '\', [StringComparison]::OrdinalIgnoreCase) -or
+      $package.StartsWith($Target + '\', [StringComparison]::OrdinalIgnoreCase)) {
+    throw 'Extract the patch outside the installed Weasel directory before running it.'
+  }
+  if (!(Test-Path -LiteralPath (Join-Path $Target 'data') -PathType Container)) {
+    throw 'Target is not an existing Weasel installation (data directory missing).'
+  }
+  $mapping = [ordered]@{
+    'WeaselServer.exe' = 'WeaselServer.exe'; 'WeaselDeployer.exe' = 'WeaselDeployer.exe'
+    'WeaselSetup.exe' = 'WeaselSetup.exe'; 'weasel.dll' = 'weasel.dll'
+    'rime.dll' = 'rime.dll'; 'WinSparkle.dll' = 'WinSparkle.dll'
+  }
+  if ([Environment]::Is64BitOperatingSystem) { $mapping['weaselx64.dll'] = 'weaselx64.dll' }
+  else {
+    foreach ($name in @('WeaselServer.exe','WeaselDeployer.exe','rime.dll','WinSparkle.dll')) { $mapping[$name] = 'Win32\' + $name }
+  }
+  $hashes = @{}
+  foreach ($line in (Get-Content -LiteralPath (Join-Path $package 'SHA256SUMS.txt'))) {
+    if ($line -match '^([a-fA-F0-9]{64})\s+(.+)$') { $hashes[$Matches[2].Replace('/', '\')] = $Matches[1] }
+  }
+  foreach ($name in $mapping.Keys) {
+    if (!(Test-Path -LiteralPath (Join-Path $Target $name) -PathType Leaf)) {
+      throw "Required original file missing: $name. Use manual replacement for this installation."
+    }
+    $relative = $mapping[$name]
+    $source = Join-Path $package $relative
+    if (!$hashes.ContainsKey($relative) -or (Get-FileHash -LiteralPath $source).Hash -ne $hashes[$relative]) {
+      throw "Package hash check failed: $relative"
+    }
+  }
+  $profile = Get-ItemProperty 'HKCU:\Software\Rime\Weasel' -ErrorAction SilentlyContinue
+  $profileName = 'hans'
+  if ($profile -and $profile.PSObject.Properties['Profile'] -and $profile.Profile) { $profileName = $profile.Profile }
+  elseif ($profile -and $profile.PSObject.Properties['Hant'] -and $profile.Hant) { $profileName = 'hant' }
+  $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
+  if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
+  Write-Host "Target: $Target"
+  Write-Host "Build: rewrite-ui-software-render-20260928; profile: $profileName"
+  Write-Host 'Patch installer: revision 3 (command-line whitespace fix)'
+  Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
+  if ($CheckOnly) { Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
+
+  $principal = New-Object Security.Principal.WindowsPrincipal($identity)
+  if (!$principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    $scriptPath = Join-Path $package 'Apply-Patch.ps1'
+    $elevationArgs = '-NoProfile -ExecutionPolicy Bypass -File "{0}" -Target "{1}" -UserSid "{2}"' -f $scriptPath, $Target, $identity.User.Value
+    $child = Start-Process powershell.exe -Verb RunAs -ArgumentList $elevationArgs -PassThru -Wait
+    exit $child.ExitCode
+  }
+
+  # Refuse a mixed installation instead of terminating unrelated applications.
+  $serverPath = Join-Path $Target 'WeaselServer.exe'
+  $servers = @(Get-Process WeaselServer -ErrorAction SilentlyContinue)
+  foreach ($server in $servers) {
+    if (!$server.Path -or $server.Path -ine $serverPath) {
+      throw 'Another Weasel installation is running. Exit it before applying this patch.'
+    }
+  }
+  $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
+  $backup = Join-Path $Target ('rewrite-backup-' + $stamp + '-' + [Guid]::NewGuid().ToString('N').Substring(0,8))
+  New-Item -ItemType Directory -Path $backup | Out-Null
+  foreach ($name in $mapping.Keys) { Copy-Verified (Join-Path $Target $name) (Join-Path $backup $name) }
+  if (Test-Path -LiteralPath (Join-Path $Target 'rewrite-build.txt')) {
+    Copy-Verified (Join-Path $Target 'rewrite-build.txt') (Join-Path $backup 'rewrite-build.txt')
+  }
+  @("Original directory: $Target", "Profile: $profileName", "Date: $stamp",
+    'Restore all saved binaries to the original directory and run the saved WeaselSetup with the same profile argument.',
+    "Registration argument: $($arguments[$profileName])", 'Reboot after restoring. User configuration was not modified.') |
+    Set-Content -LiteralPath (Join-Path $backup 'RESTORE.txt') -Encoding UTF8
+  Write-Host "Backup: $backup"
+  $changed = $false
+  try {
+    if ($servers.Count) {
+      Stop-WeaselForPatch $serverPath
+    }
+    Write-Host 'Replacing and verifying program files...'
+    $changed = $true
+    foreach ($name in $mapping.Keys) { Copy-Verified (Join-Path $package $mapping[$name]) (Join-Path $Target $name) }
+    Write-Host 'Registering input method...'
+    Register-Weasel $Target $arguments[$profileName]
+    Copy-Verified (Join-Path $package 'rewrite-build.txt') (Join-Path $Target 'rewrite-build.txt')
+    Write-Host 'SUCCESS. Restart Windows before testing; existing applications still hold old DLLs.' -ForegroundColor Green
+    Write-Host 'Installed identifier: rewrite-build.txt. Rewrite UI remains opt-in in weasel.custom.yaml.'
+  } catch {
+    $failure = $_
+    if ($changed) {
+      try {
+        foreach ($name in $mapping.Keys) { Copy-Verified (Join-Path $backup $name) (Join-Path $Target $name) }
+        Register-Weasel $Target $arguments[$profileName]
+        Write-Host 'Original binaries restored. Reboot Windows before using Weasel.'
+      } catch {
+        Write-Host "Automatic recovery failed. Restore files from: $backup" -ForegroundColor Red
+        Write-Host $_
+      }
+    }
+    throw $failure
+  }
+  Read-Host 'Press Enter to close' | Out-Null
+} catch {
+  Write-Host "ERROR: $_" -ForegroundColor Red
+  if (!$CheckOnly) { Read-Host 'Press Enter to close' | Out-Null }
+  exit 1
+}
