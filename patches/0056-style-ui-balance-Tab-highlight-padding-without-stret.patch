diff --git a/WeaselUI/JoinedRewritePath.h b/WeaselUI/JoinedRewritePath.h
index 689d749..296f89a 100644
--- a/WeaselUI/JoinedRewritePath.h
+++ b/WeaselUI/JoinedRewritePath.h
@@ -84,9 +84,9 @@ inline bool AlignLeadingRewriteHighlight(CRect candidate, CRect& syllable,
   if (!overlap.IntersectRect(candidate, syllable)) return false;
   syllable.left = candidate.left;
   if (syllable.CenterPoint().y >= candidate.CenterPoint().y)
-    syllable.bottom = (std::max)((int)syllable.bottom, (int)body.bottom - verticalInset);
+    syllable.bottom = (std::min)((int)syllable.bottom, (int)body.bottom - verticalInset);
   else
-    syllable.top = (std::min)((int)syllable.top, (int)body.top + verticalInset);
+    syllable.top = (std::max)((int)syllable.top, (int)body.top + verticalInset);
   return true;
 }
 // Only merge actual intersections; never bridge empty space between highlights.
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
