From e029f83d5c0dd869445b233793e2c712eb52a56d Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Thu, 1 Oct 2026 10:35:15 +0800
Subject: [PATCH 56/66] style(ui): balance Tab highlight padding without
 stretching its bottom

---
 INSTALL-PATCH.md               | 2 ++
 Install-Binaries.ps1           | 2 +-
 REWRITE-UI.md                  | 2 ++
 WeaselUI/JoinedRewritePath.h   | 4 ++--
 WeaselUI/WeaselPanel.cpp       | 2 ++
 rewrite-build.txt              | 2 +-
 rime/skins/README.md           | 2 ++
 test/rewrite_pipeline_test.cpp | 2 +-
 8 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/INSTALL-PATCH.md b/INSTALL-PATCH.md
index 254bbd8..c6cc248 100644
--- a/INSTALL-PATCH.md
+++ b/INSTALL-PATCH.md
@@ -1,3 +1,5 @@
+> **2026-10-01 Tab 填充留白修正：** 选中音节背景在现有文字布局外增加左右 4px、上下 2px 填充留白，按 DPI 缩放；首音节仍与主候选左边缘对齐，但不再把底部背景拉伸到外框内侧。保持文字位置、窗口高度、圆角连接与稳定定位。
+
 > **2026-10-01 首候选填充曲线：** 首候选与第一个 Tab 音节的高亮相交时，两行填充对齐左边缘，保留外框内留白，左侧沿用主候选圆角形成连续轮廓；右侧保留圆角台阶。后续音节和无交集的情况不拉伸背景。文字位置与定位算法保持。
 
 > **2026-10-01 Tab 紧凑与填充连接：** Tab 行去掉额外上下 1px 内边距，行间距收紧到最多 2px；选中音节与主候选高亮使用同一种强调色，有面积交集时合并为一次圆角填充，连接处做内凹圆角，无交集时独立绘制。保留上下排列规则和打字稳定定位。
diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index 6ab1cee..cc525f6 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -144,7 +144,7 @@ try {
   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-tab-leading-curve-20261001; profile: $profileName"
+  Write-Host "Build: rewrite-ui-tab-balanced-padding-20261001; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
