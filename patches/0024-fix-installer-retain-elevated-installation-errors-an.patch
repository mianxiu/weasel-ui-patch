 function Invoke-BinaryInstaller([switch]$Restore) {
+  $operation = if ($Restore) { 'recovery' } else { 'install' }
+  $adminLog = Join-Path $transaction ("program-$operation.log")
+  $adminResult = Join-Path $transaction ("program-$operation-result.json")
   $arguments = '-NoProfile -ExecutionPolicy Bypass -File "{0}" -Target "{1}" -UserSid "{2}" -BackupName "{3}"' -f
     (Join-Path $package 'Install-Binaries.ps1'), $Target, $identity.User.Value, $backupName
+  $arguments += ' -LogPath "{0}" -ResultPath "{1}"' -f $adminLog, $adminResult
   if ($Restore) { $arguments += ' -Restore' }
+  Write-Host "Administrator log: $adminLog"
   $child = Start-Process powershell.exe -Verb RunAs -ArgumentList $arguments -PassThru
   $script:binaryAttempted = $true
   try {
+    # Retain the process handle before it exits (Windows PowerShell 5.1).
+    $null = $child.Handle
     while (!$child.WaitForExit(10000)) { Write-Host 'Waiting for administrator installer...' }
-    if ($child.ExitCode -ne 0) { throw "Program installation/recovery failed ($($child.ExitCode)). See program backup." }
+    if ($child.ExitCode -ne 0) {
+      $details = "Administrator installer exited with code $($child.ExitCode)."
+      if (Test-Path -LiteralPath $adminResult) {
+        try {
+          $report = Get-Content -LiteralPath $adminResult -Raw | ConvertFrom-Json
+          $details += "`nStage: $($report.stage)`nError: $($report.error)`nRecovery: $($report.recovery)"
+        } catch { $details += "`nCould not read administrator result: $_" }
+      } elseif (Test-Path -LiteralPath $adminLog) {
+        $details += "`n" + ((Get-Content -LiteralPath $adminLog -Tail 20) -join "`n")
+      } else {
+        $details += "`nNo administrator log was created. The child may have failed before the script started."
+      }
+      throw "$details`nAdministrator log: $adminLog"
+    }
   } finally { $child.Dispose() }
 }
