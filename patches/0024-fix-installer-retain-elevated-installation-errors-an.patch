diff --git a/test/installer_diagnostics_test.ps1 b/test/installer_diagnostics_test.ps1
new file mode 100644
index 0000000..f777f79
--- /dev/null
+++ b/test/installer_diagnostics_test.ps1
@@ -0,0 +1,55 @@
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path $PSScriptRoot -Parent
+$root = Join-Path ([IO.Path]::GetTempPath()) ('rewrite-diagnostics-' + [guid]::NewGuid().ToString('N'))
+$package = Join-Path $root 'package'
+$Target = Join-Path $root 'program'
+New-Item -ItemType Directory -Path $package,(Join-Path $Target 'data') -Force | Out-Null
+Copy-Item (Join-Path $repo 'Install-Binaries.ps1') $package
+$manifest = @()
+foreach ($file in @('WeaselServer.exe','WeaselDeployer.exe','WeaselSetup.exe','weasel.dll','weaselx64.dll','rime.dll','WinSparkle.dll')) {
+  Set-Content -LiteralPath (Join-Path $package $file) -Value 'preflight fixture, never execute'
+  Copy-Item (Join-Path $package $file) $Target
+  $manifest += (Get-FileHash (Join-Path $package $file)).Hash + '  ' + $file
+}
+$manifest | Set-Content (Join-Path $package 'SHA256SUMS.txt')
+$log = Join-Path $root 'success.log'; $result = Join-Path $root 'success.json'
+& powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $package 'Install-Binaries.ps1') -Target $Target -CheckOnly -LogPath $log -ResultPath $result
+if ($LASTEXITCODE -ne 0) { throw 'Preflight subprocess failed' }
+$report = Get-Content $result -Raw | ConvertFrom-Json
+if (!$report.success -or !(Test-Path $log)) { throw 'Success report/log missing' }
+Write-Host 'PASS: real Windows PowerShell success transcript/result'
+$log = Join-Path $root 'failure.log'; $result = Join-Path $root 'failure.json'
+& powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $package 'Install-Binaries.ps1') -Target $Target -CheckOnly -UserSid 'S-1-0-0' -LogPath $log -ResultPath $result
+if ($LASTEXITCODE -ne 1) { throw 'Identity rejection did not fail' }
+$report = Get-Content $result -Raw | ConvertFrom-Json
+if ($report.success -or $report.stage -ne 'checking elevated identity' -or $report.error -notmatch 'Elevation changed') { throw 'Failure report incorrect' }
+if ((Get-Content $log -Raw) -notmatch 'Elevation changed') { throw 'Failure transcript incomplete' }
+Write-Host 'PASS: real failure retains stage, error and recovery status'
+
+$tokens=$null; $errors=$null
+$ast=[Management.Automation.Language.Parser]::ParseFile((Join-Path $repo 'Apply-Patch.ps1'),[ref]$tokens,[ref]$errors)
+if ($errors) { throw ($errors | Out-String) }
+$function=$ast.Find({param($n) $n -is [Management.Automation.Language.FunctionDefinitionAst] -and $n.Name -eq 'Invoke-BinaryInstaller'},$true)
+Invoke-Expression $function.Extent.Text
+function Start-Process {
+  param($FilePath,$Verb,$ArgumentList,[switch]$PassThru)
+  if ($ArgumentList -notmatch '-LogPath ' -or $ArgumentList -notmatch '-ResultPath ') { throw 'Diagnostic paths were not forwarded' }
+  $p=[pscustomobject]@{Handle=1; ExitCode=1}
+  $p | Add-Member ScriptMethod WaitForExit {param($milliseconds) return $true}
+  $p | Add-Member ScriptMethod Dispose { }
+  return $p
+}
+$transaction=Join-Path $root 'transaction'
+New-Item -ItemType Directory -Path $transaction | Out-Null
+$identity=[pscustomobject]@{User=[pscustomobject]@{Value='test'}}
+$backupName='rewrite-backup-' + [guid]::NewGuid().ToString('N')
+Copy-Item $result (Join-Path $transaction 'program-install-result.json')
+$message=$null
+try { Invoke-BinaryInstaller } catch { $message=$_.Exception.Message }
+if (!$message -or $message -notmatch 'Stage: checking elevated identity' -or $message -notmatch 'Elevation changed' -or $message -notmatch 'Recovery: not-needed') { throw 'Parent did not surface child error' }
+Write-Host 'PASS: parent displays precise child error'
+Remove-Item -LiteralPath (Join-Path $transaction 'program-install-result.json')
+$message=$null
+try { Invoke-BinaryInstaller } catch { $message=$_.Exception.Message }
+if (!$message -or $message -notmatch 'No administrator log') { throw 'Missing-log fallback absent' }
+Write-Host "PASS: startup failure without transcript diagnosed. Fixtures: $root"
