+inline InlineRewritePresentation PresentInlineRewrite(const RewriteState& state) {
+  InlineRewritePresentation result;
+  const auto units = state.Units();
+  if (units.empty() || state.input.empty() || state.input.size() > 4096) return result;
+  const bool unchanged = (state.stage == L"armed" || state.stage == L"index") &&
+                         state.input == state.original;
+  if (!unchanged && !ProjectInlineRewrite(state, state.input)) return result;
+  for (const auto& unit : units) {
+    // The selected label is highlighted in place. A separate changing badge
+    // would rewrite host text for every digit-only key.
+    if (unit.badge) continue;
+    if (!result.text.empty()) result.text += L' ';
+    const auto start = result.text.size();
+    result.text += unit.text;
+    if (unit.active) result.target = {start, result.text.size()};
+  }
+  result.valid = !result.text.empty();
+  return result;
+}
 }  // namespace weasel
