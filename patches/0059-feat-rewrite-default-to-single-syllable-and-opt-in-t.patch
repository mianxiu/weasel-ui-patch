diff --git a/include/RewriteState.h b/include/RewriteState.h
index 39d0622..311c09b 100644
--- a/include/RewriteState.h
+++ b/include/RewriteState.h
@@ -70,7 +70,11 @@ struct RewriteState {
     std::vector<std::wstring> pronunciations;
     std::wstring token;
     for (auto c : pinyin + L"|") {
-      if (c == L'|') { pronunciations.push_back(token); token.clear(); }
+      if (c == L'|') {
+        if (!token.empty() && token.back() == L' ') { pronunciations.clear(); break; }
+        pronunciations.push_back(token); token.clear();
+      }
+      else if (c == L' ' && !token.empty() && token.back() != L' ') token += c;
       else if ((c >= L'a' && c <= L'z') || (c >= 0xc0 && c <= 0x24f) ||
                (c >= 0x300 && c <= 0x36f)) token += c;
       else { pronunciations.clear(); break; }
