diff --git a/include/KeyEventTrace.h b/include/KeyEventTrace.h
new file mode 100644
index 0000000..a0e7c35
--- /dev/null
+++ b/include/KeyEventTrace.h
@@ -0,0 +1,126 @@
+#pragma once
+#include <windows.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+// Explicitly enabled, expiring, bounded diagnostic trace. No composition text.
+namespace weasel::keytrace {
+inline std::wstring Root() {
+  wchar_t path[32768]{};
+  if (GetEnvironmentVariableW(L"WEASEL_KEY_TRACE_TEST_DIR", path, 32768)) return path;
+  if (!GetEnvironmentVariableW(L"LOCALAPPDATA", path, 32768)) return {};
+  return std::wstring(path) + L"\\WeaselRewriteUI\\KeyTrace";
+}
+inline ULONGLONG Now() {
+  FILETIME ft; GetSystemTimeAsFileTime(&ft);
+  return (ULONGLONG(ft.dwHighDateTime) << 32) | ft.dwLowDateTime;
+}
+inline bool Enabled() {
+  struct Cache { ULONGLONG checked = 0, until = 0; };
+  static thread_local Cache cache;
+  const auto tick = GetTickCount64();
+  if (!cache.checked || tick - cache.checked >= 1000) {
+    cache.checked = tick;
+    cache.until = 0;
+    const auto root = Root();
+    if (root.empty()) return false;
+    HANDLE file = CreateFileW((root + L"\\enabled.until").c_str(), GENERIC_READ,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, 0, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+      char text[64]{}; DWORD read = 0;
+      if (ReadFile(file, text, 63, &read, nullptr)) cache.until = _strtoui64(text, nullptr, 10);
+      CloseHandle(file);
+    }
+  }
+  return cache.until > Now();
+}
+inline std::atomic<unsigned long long> sequence{0};
+inline thread_local unsigned long long current = 0;
+inline thread_local unsigned long long dropped = 0;
+inline void Write(const char* event, unsigned long long id, const void* context,
+                  WPARAM key, LPARAM flags, LONG messageTime, long long detail = 0,
+                  long long detail2 = 0) {
+  if (!Enabled()) return;
+  const auto root = Root();
+  unsigned hash = 2166136261u;
+  for (auto c : root) hash = (hash ^ c) * 16777619u;
+  wchar_t name[80]; swprintf_s(name, L"Local\\WeaselKeyTrace_%08x", hash);
+  HANDLE mutex = CreateMutexW(nullptr, FALSE, name);
+  if (!mutex) { ++dropped; return; }
+  const DWORD wait = WaitForSingleObject(mutex, 100);
+  if (wait != WAIT_OBJECT_0 && wait != WAIT_ABANDONED) { ++dropped; CloseHandle(mutex); return; }
+  const auto path = root + L"\\trace-0.log";
+  HANDLE file = CreateFileW(path.c_str(), FILE_APPEND_DATA | GENERIC_READ,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_ALWAYS, 0, nullptr);
+  bool success = false;
+  if (file != INVALID_HANDLE_VALUE) {
+    LARGE_INTEGER size{};
+    if (GetFileSizeEx(file, &size) && size.QuadPart >= 8 * 1024 * 1024 - 2048) {
+      CloseHandle(file); file = INVALID_HANDLE_VALUE;
+      bool rotated = true;
+      for (int i = 6; i >= 0; --i) {
+        const auto from = root + L"\\trace-" + std::to_wstring(i) + L".log";
+        const auto to = root + L"\\trace-" + std::to_wstring(i+1) + L".log";
+        if (!MoveFileExW(from.c_str(), to.c_str(), MOVEFILE_REPLACE_EXISTING) &&
+            GetLastError() != ERROR_FILE_NOT_FOUND) { rotated = false; break; }
+      }
+      if (rotated) file = CreateFileW(path.c_str(), FILE_APPEND_DATA | GENERIC_READ,
+          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_ALWAYS, 0, nullptr);
+    }
+    if (file != INVALID_HANDLE_VALUE) {
+      wchar_t executable[MAX_PATH]{}; GetModuleFileNameW(nullptr, executable, MAX_PATH);
+      const wchar_t* app = wcsrchr(executable, L'\\'); app = app ? app+1 : executable;
+      char appUtf8[MAX_PATH*3]{};
+      WideCharToMultiByte(CP_UTF8, 0, app, -1, appUtf8, sizeof(appUtf8), nullptr, nullptr);
+      char line[2048];
+      const int length = sprintf_s(line,
+          "utc_ft=%llu tick=%llu pid=%lu tid=%lu app=%s event=%s id=%llu ctx=%p vk=%llu flags=%08lx msg=%ld detail=%lld detail2=%lld dropped=%llu\r\n",
+          Now(), GetTickCount64(), GetCurrentProcessId(), GetCurrentThreadId(), appUtf8, event, id, context,
+          (unsigned long long)key, (unsigned long)flags, messageTime, detail, detail2, dropped);
+      DWORD written = 0;
+      success = length > 0 && WriteFile(file, line, length, &written, nullptr) && written == length;
+      CloseHandle(file);
+    }
+  }
+  if (success) dropped = 0; else ++dropped;
+  ReleaseMutex(mutex); CloseHandle(mutex);
+}
+struct Scope {
+  const char* event; const void* context; WPARAM key; LPARAM flags;
+  BOOL* eaten; unsigned long long id = 0, parent = 0; bool active = false;
+  Scope(const char* phase, const void* ctx, WPARAM vk, LPARAM lp, BOOL* result,
+        bool pending, bool matched) : event(phase), context(ctx), key(vk), flags(lp), eaten(result) {
+    active = Enabled();
+    if (!active) return;
+    id = ++sequence; parent = current; current = id;
+    Write(event, id, context, key, flags, GetMessageTime(), pending, matched);
+    Write("parent", id, context, key, flags, GetMessageTime(), parent);
+  }
+  ~Scope() {
+    if (!active) return;
+    Write("return", id, context, key, flags, GetMessageTime(), *eaten);
+    current = parent;
+  }
+};
+inline LRESULT CALLBACK MessageHook(int code, WPARAM action, LPARAM data) {
+  if (code >= 0 && action == PM_REMOVE && Enabled()) {
+    const auto& msg = *reinterpret_cast<MSG*>(data);
+    if (msg.message == WM_KEYDOWN || msg.message == WM_KEYUP ||
+        msg.message == WM_SYSKEYDOWN || msg.message == WM_SYSKEYUP)
+      Write("queue", 0, msg.hwnd, msg.wParam, msg.lParam, msg.time, msg.message);
+  }
+  return CallNextHookEx(nullptr, code, action, data);
+}
+inline thread_local HHOOK hook = nullptr;
+inline thread_local unsigned hookUsers = 0;
+inline HHOOK AcquireMessageHook() {
+  if (!hook) hook = SetWindowsHookExW(WH_GETMESSAGE, MessageHook, nullptr, GetCurrentThreadId());
+  if (hook) ++hookUsers;
+  return hook;
+}
+inline void ReleaseMessageHook() {
+  if (hookUsers && !--hookUsers) { UnhookWindowsHookEx(hook); hook = nullptr; }
+}
+}  // namespace weasel::keytrace
