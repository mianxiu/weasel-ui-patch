diff --git a/Record-Key-Trace.cmd b/Record-Key-Trace.cmd
new file mode 100644
index 0000000..64db34b
--- /dev/null
+++ b/Record-Key-Trace.cmd
@@ -0,0 +1,6 @@
+@echo off
+cd /d "%~dp0"
+set "TRACE_ACTION=%~1"
+if "%TRACE_ACTION%"=="" set "TRACE_ACTION=Status"
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Record-Key-Trace.ps1" -Action %TRACE_ACTION%
+pause
diff --git a/Record-Key-Trace.ps1 b/Record-Key-Trace.ps1
new file mode 100644
index 0000000..3f6332d
--- /dev/null
+++ b/Record-Key-Trace.ps1
@@ -0,0 +1,32 @@
+[CmdletBinding()]
+param([ValidateSet('Start','Stop','Status','Capture')][string]$Action='Status')
+$ErrorActionPreference='Stop'
+$root=Join-Path $env:LOCALAPPDATA 'WeaselRewriteUI\KeyTrace'
+$marker=Join-Path $root 'enabled.until'
+New-Item -ItemType Directory -Force $root | Out-Null
+if($Action -eq 'Start'){
+  $until=[DateTime]::UtcNow.AddHours(24)
+  [IO.File]::WriteAllText($marker,$until.ToFileTimeUtc().ToString(),[Text.Encoding]::ASCII)
+  Write-Host ('Recording until '+$until.ToLocalTime().ToString('yyyy-MM-dd HH:mm:ss'))
+  Write-Host 'Reopen input applications after installing the diagnostic DLL.'
+  Write-Host 'Logs contain key codes; keep them private. Maximum: 8 files x 8 MiB.'
+}elseif($Action -eq 'Stop' -or $Action -eq 'Capture'){
+  [IO.File]::WriteAllText($marker,'0',[Text.Encoding]::ASCII)
+  Write-Host 'Recording stopped (takes effect within one second).'
+  if($Action -eq 'Capture'){
+    Start-Sleep -Seconds 2
+    $stamp=Get-Date -Format 'yyyyMMdd-HHmmss'
+    $archive=Join-Path $root ('key-trace-'+$stamp+'.zip')
+    $logs=@(Get-ChildItem -LiteralPath $root -Filter 'trace-*.log' -File)
+    if(!$logs.Count){throw 'No trace logs found. Reopen the affected app and enable recording.'}
+    ('Capture time: '+[DateTime]::Now.ToString('o')) | Set-Content (Join-Path $root 'capture-time.txt')
+    Compress-Archive -LiteralPath (@($logs.FullName)+(Join-Path $root 'capture-time.txt')) -DestinationPath $archive
+    Write-Host ('Saved: '+$archive)
+  }
+}else{
+  $until=0L
+  if(Test-Path -LiteralPath $marker){[long]::TryParse([IO.File]::ReadAllText($marker).Trim(),[ref]$until)|Out-Null}
+  if($until -gt [DateTime]::UtcNow.ToFileTimeUtc()){Write-Host ('Recording until '+[DateTime]::FromFileTimeUtc($until).ToLocalTime())}
+  else{Write-Host 'Recording is off'}
+}
+Write-Host ('Log folder: '+$root)
