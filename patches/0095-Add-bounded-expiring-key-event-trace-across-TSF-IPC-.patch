+#include <windows.h>
+#include <KeyEventTrace.h>
+#include <cassert>
+#include <fstream>
+#include <iostream>
+#include <thread>
+#include <vector>
+using namespace weasel::keytrace;
+void marker(ULONGLONG until) {
+  std::ofstream file(Root() + L"\\enabled.until");
+  file << until;
+}
+int main() {
+  assert(!Root().empty());
+  marker(0); assert(!Enabled());
+  Write("off",0,nullptr,0,0,0);
+  assert(GetFileAttributesW((Root()+L"\\trace-0.log").c_str()) == INVALID_FILE_ATTRIBUTES);
+  marker(Now()+600000000); Sleep(1100); assert(Enabled());
+  BOOL eaten = TRUE;
+  { Scope scope("OnKeyDown", reinterpret_cast<void*>(123), 'C', 0x002e0001, &eaten, true, false);
+    Write("send",current,reinterpret_cast<void*>(123),'C',0x002e0001,GetMessageTime());
+  }
+  MSG msg{}; PeekMessageW(&msg,nullptr,0,0,PM_NOREMOVE);
+  const auto first = AcquireMessageHook(); assert(first);
+  assert(AcquireMessageHook() == first && hookUsers == 2);
+  assert(PostThreadMessageW(GetCurrentThreadId(),WM_KEYDOWN,'C',0x002e0001));
+  assert(PeekMessageW(&msg,nullptr,WM_KEYDOWN,WM_KEYDOWN,PM_REMOVE));
+  ReleaseMessageHook(); assert(hook && hookUsers == 1);
+  ReleaseMessageHook(); assert(!hook && !hookUsers);
+  std::ifstream file(Root()+L"\\trace-0.log");
+  const std::string data((std::istreambuf_iterator<char>(file)),{});
+  assert(data.find("event=queue") != data.npos && data.find("event=send") != data.npos);
+  assert(data.find("event=return") != data.npos && data.find("detail=1") != data.npos);
+  file.close();
+  std::vector<std::thread> workers;
+  for(int i=0;i<4;++i) workers.emplace_back([]{for(int j=0;j<100;++j)Write("parallel",0,nullptr,'C',0,0);});
+  for(auto& worker:workers)worker.join();
+  for(int i=0;i<10;++i) {
+    HANDLE fill=CreateFileW((Root()+L"\\trace-0.log").c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);
+    assert(fill!=INVALID_HANDLE_VALUE);
+    LARGE_INTEGER size; size.QuadPart=8*1024*1024-2048;
+    assert(SetFilePointerEx(fill,size,nullptr,FILE_BEGIN) && SetEndOfFile(fill));CloseHandle(fill);
+    Write("rotate",0,nullptr,'C',0,0);
+  }
+  for(int i=0;i<8;++i) {
+    WIN32_FILE_ATTRIBUTE_DATA info{};
+    assert(GetFileAttributesExW((Root()+L"\\trace-"+std::to_wstring(i)+L".log").c_str(),GetFileExInfoStandard,&info));
+    assert(info.nFileSizeHigh==0 && info.nFileSizeLow<=8*1024*1024);
+  }
+  assert(GetFileAttributesW((Root()+L"\\trace-8.log").c_str())==INVALID_FILE_ATTRIBUTES);
+  marker(Now()-1); Sleep(1100); assert(!Enabled());
+  std::cout<<"Expiry, disabled mode, callback correlation, real message hook, concurrent writes and 64 MiB rotation passed\n";
+}
