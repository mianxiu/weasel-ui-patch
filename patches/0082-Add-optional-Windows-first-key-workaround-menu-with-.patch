diff --git a/test/optional_ime_fix_test.ps1 b/test/optional_ime_fix_test.ps1
new file mode 100644
index 0000000..6f6ae22
--- /dev/null
+++ b/test/optional_ime_fix_test.ps1
@@ -0,0 +1,48 @@
+$ErrorActionPreference = 'Stop'
+$testDirectory = Join-Path $env:TEMP ('weasel-optional-ime-test-' + [guid]::NewGuid().ToString('N'))
+. (Join-Path (Split-Path $PSScriptRoot) 'Fix-IME-First-Key.ps1') -BackupDirectory $testDirectory
+# Replace only the registry adapter. Never touch the real Windows setting.
+function Get-IMERegistryState { return $script:MockState }
+function Set-IMERegistryState($state) {
+  if ($script:FailWrite) { throw 'Simulated registry access denied' }
+  $script:MockState = [pscustomobject]@{existed=$state.existed;kind=$state.kind;value=$state.value}
+}
+function Assert($condition, $message) { if (!$condition) { throw $message } }
+function Expect-Failure($operation) {
+  $failed = $false
+  try { & $operation } catch { $failed = $true }
+  Assert $failed 'Expected failure'
+}
+foreach ($original in @(
+  [pscustomobject]@{existed=$true;kind='DWord';value=1},
+  [pscustomobject]@{existed=$false;kind='';value=$null}
+)) {
+  $script:MockState = $original
+  Invoke-IMEWorkaround Reset
+  Assert ($script:MockState.value -eq 0) 'Reset failed'
+  $before = [IO.File]::ReadAllText($script:BackupFile)
+  Invoke-IMEWorkaround Reset
+  Assert ([IO.File]::ReadAllText($script:BackupFile) -ceq $before) 'Repeated reset replaced original backup'
+  $script:MockState = [pscustomobject]@{existed=$true;kind='DWord';value=2}
+  Expect-Failure { Invoke-IMEWorkaround Restore }
+  Assert ($script:MockState.value -eq 2) 'Restore overwrote external change'
+  Expect-Failure { Invoke-IMEWorkaround Reset }
+  Assert ([IO.File]::ReadAllText($script:BackupFile) -ceq $before) 'Failure changed backup'
+  $script:MockState = [pscustomobject]@{existed=$true;kind='DWord';value=0}
+  Invoke-IMEWorkaround Restore
+  Assert (Test-IMEStateEqual $script:MockState $original) 'Original state not restored'
+  Assert (!(Test-Path -LiteralPath $script:BackupFile)) 'Active backup not archived'
+}
+$script:MockState = [pscustomobject]@{existed=$true;kind='DWord';value=1}
+$script:FailWrite = $true
+Expect-Failure { Invoke-IMEWorkaround Reset }
+Assert ($script:MockState.value -eq 1) 'Failed write changed value'
+Assert (Test-Path -LiteralPath $script:BackupFile) 'Write failure lost backup'
+$script:FailWrite = $false
+Invoke-IMEWorkaround Reset
+$saved = Read-IMEBackup
+$saved.sid = 'S-1-invalid'
+[IO.File]::WriteAllText($script:BackupFile, ($saved | ConvertTo-Json -Depth 5))
+Expect-Failure { Invoke-IMEWorkaround Restore }
+Assert ($script:MockState.value -eq 0) 'Foreign backup changed registry'
+Write-Host 'Optional IME reset/restore, absent value, repeated reset, external change and failure tests passed.'
