diff --git a/Fix-IME-First-Key.ps1 b/Fix-IME-First-Key.ps1
new file mode 100644
index 0000000..6c1ea73
--- /dev/null
+++ b/Fix-IME-First-Key.ps1
@@ -0,0 +1,134 @@
+﻿param(
+  [ValidateSet('Menu','TouchKeyboard','Reset','Restore','Status')]
+  [string]$Action = 'Menu',
+  [string]$BackupDirectory = (Join-Path $env:LOCALAPPDATA 'WeaselRewriteUI\OptionalIMEFix')
+)
+$ErrorActionPreference = 'Stop'
+$script:RegistryPath = 'Software\Microsoft\InputMethod\Settings\Common'
+$script:ValueName = 'TouchKeyboardHasEverShown'
+$script:BackupFile = Join-Path $BackupDirectory 'touch-keyboard-state.json'
+$script:UserSid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
+
+function Get-IMERegistryState {
+  $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey($script:RegistryPath)
+  try {
+    if (!$key -or $key.GetValueNames() -notcontains $script:ValueName) {
+      return [pscustomobject]@{ existed = $false; kind = ''; value = $null }
+    }
+    $kind = $key.GetValueKind($script:ValueName).ToString()
+    if ($kind -ne 'DWord') { throw 'Unexpected registry type; no changes made.' }
+    return [pscustomobject]@{ existed = $true; kind = $kind; value = $key.GetValue($script:ValueName) }
+  } finally { if ($key) { $key.Dispose() } }
+}
+
+function Set-IMERegistryState($state) {
+  $key = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($script:RegistryPath)
+  try {
+    if ($state.existed) {
+      $key.SetValue($script:ValueName, [int]$state.value, [Microsoft.Win32.RegistryValueKind]::DWord)
+    } else { $key.DeleteValue($script:ValueName, $false) }
+  } finally { $key.Dispose() }
+}
+
+function Test-IMEStateEqual($left, $right) {
+  return ($left.existed -eq $right.existed -and
+    (!$left.existed -or ($left.kind -eq $right.kind -and $left.value -eq $right.value)))
+}
+
+function Read-IMEBackup {
+  $saved = [IO.File]::ReadAllText($script:BackupFile) | ConvertFrom-Json
+  if ($saved.schema -ne 1 -or $saved.sid -ne $script:UserSid -or
+      $saved.path -ne $script:RegistryPath -or $saved.name -ne $script:ValueName -or
+      $saved.original.existed -isnot [bool] -or
+      ($saved.original.existed -and ($saved.original.kind -ne 'DWord' -or
+                                    $saved.original.value -isnot [int]))) {
+    throw 'Invalid backup or backup belongs to another user; no changes made.'
+  }
+  return $saved
+}
+
+function Invoke-IMEWorkaround([string]$Operation) {
+  $reset = [pscustomobject]@{ existed = $true; kind = 'DWord'; value = 0 }
+  switch ($Operation) {
+    'Status' {
+      Get-IMERegistryState | Format-List
+      Write-Host ('Active backup: ' + (Test-Path -LiteralPath $script:BackupFile))
+    }
+    'TouchKeyboard' {
+      $exe = Join-Path $env:CommonProgramFiles 'microsoft shared\ink\TabTip.exe'
+      if (!(Test-Path -LiteralPath $exe -PathType Leaf)) { throw 'Windows touch keyboard was not found.' }
+      Start-Process -FilePath $exe -WindowStyle Normal
+      Write-Host 'Touch keyboard requested. Close it manually, then retry typing.'
+      Write-Host 'If no keyboard appears, open it using the touch keyboard icon on the taskbar.'
+      Write-Host 'This does not reset the registry or add a startup task.'
+    }
+    'Reset' {
+      $current = Get-IMERegistryState
+      if (Test-Path -LiteralPath $script:BackupFile) {
+        $saved = Read-IMEBackup
+        if (!(Test-IMEStateEqual $current $reset) -and
+            !(Test-IMEStateEqual $current $saved.original)) {
+          throw 'Registry changed after the backup. Existing backup preserved; no changes made.'
+        }
+      } else {
+        New-Item -ItemType Directory -Path $BackupDirectory -Force | Out-Null
+        $saved = [ordered]@{ schema = 1; sid = $script:UserSid;
+          path = $script:RegistryPath; name = $script:ValueName; original = $current }
+        $temporary = $script:BackupFile + '.' + [guid]::NewGuid().ToString('N') + '.tmp'
+        [IO.File]::WriteAllText($temporary, ($saved | ConvertTo-Json -Depth 5),
+                              (New-Object Text.UTF8Encoding($false)))
+        Move-Item -LiteralPath $temporary -Destination $script:BackupFile
+      }
+      Set-IMERegistryState $reset
+      if (!(Test-IMEStateEqual (Get-IMERegistryState) $reset)) { throw 'Reset verification failed; backup preserved.' }
+      Write-Host 'SUCCESS: TouchKeyboardHasEverShown = 0 (current user only).'
+      Write-Host ('Backup: ' + $script:BackupFile)
+      Write-Host 'Fully exit and reopen the affected apps, then test copying and switching windows.'
+      Write-Host 'This is a community workaround; it may need repeating after using the touch keyboard or updating Windows.'
+    }
+    'Restore' {
+      if (!(Test-Path -LiteralPath $script:BackupFile)) { throw 'No active backup found; no changes made.' }
+      $saved = Read-IMEBackup
+      $current = Get-IMERegistryState
+      if (!(Test-IMEStateEqual $current $reset) -and
+          !(Test-IMEStateEqual $current $saved.original)) {
+        throw 'Registry changed independently. Restore stopped to preserve that change.'
+      }
+      Set-IMERegistryState $saved.original
+      if (!(Test-IMEStateEqual (Get-IMERegistryState) $saved.original)) { throw 'Restore verification failed; backup preserved.' }
+      $restoredFile = $script:BackupFile + '.restored-' + [guid]::NewGuid().ToString('N')
+      Move-Item -LiteralPath $script:BackupFile -Destination $restoredFile
+      Write-Host 'SUCCESS: original registry value restored (or removed if originally absent).'
+    }
+    default { throw 'Unknown operation.' }
+  }
+}
+
+if ($MyInvocation.InvocationName -ne '.') {
+  try {
+    if ($Action -ne 'Menu') { Invoke-IMEWorkaround $Action }
+    else {
+      Write-Host '可选修复：Windows 首字母直出 / 无候选（社区临时绕过办法）'
+      Write-Host '1. 打开触摸键盘（出现后手动关闭，再测试输入）'
+      Write-Host '2. 备份原值，再将触摸键盘注册表状态重置为 0'
+      Write-Host '3. 恢复重置前的注册表状态'
+      Write-Host '4. 查看当前状态（只读）'
+      Write-Host '0. 退出'
+      Write-Host '请使用当前 Windows 账户普通运行；不添加自启动，不修改系统文件。'
+      $choice = Read-Host '请选择 0-4'
+      switch ($choice) {
+        '1' { Invoke-IMEWorkaround 'TouchKeyboard' }
+        '2' { Invoke-IMEWorkaround 'Reset' }
+        '3' { Invoke-IMEWorkaround 'Restore' }
+        '4' { Invoke-IMEWorkaround 'Status' }
+        '0' { }
+        default { throw 'Invalid choice; no changes made.' }
+      }
+    }
+    exit 0
+  } catch {
+    Write-Host ('FAILED: ' + $_.Exception.Message) -ForegroundColor Red
+    Write-Host 'If access is denied, close this window; no automatic elevation is attempted.'
+    exit 1
+  }
+}
