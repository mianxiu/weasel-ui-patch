From f21385c8ba3681e4b7f5b338b1bdf55e16d64541 Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Wed, 30 Sep 2026 23:46:03 +0800
Subject: [PATCH 42/47] fix(ui): capture root host before composition and test
 actual position timer

---
 Install-Binaries.ps1           |  2 +-
 WeaselUI/WeaselPanel.cpp       |  7 +++++--
 rewrite-build.txt              |  2 +-
 test/rewrite_pipeline_test.cpp | 18 ++++++++++++++++--
 4 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index 1be3384..4b434a6 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -144,7 +144,7 @@ try {
   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-host-follow-compact-editor-20260930; profile: $profileName"
+  Write-Host "Build: rewrite-ui-root-host-follow-20260930; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 0deb6b9..fb96445 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -147,7 +147,7 @@ void WeaselPanel::Refresh() {
   m_ctx = m_sourceCtx;
   if (!m_editOnly && IsWindow()) {
     if (m_status.composing) ::SetTimer(m_hWnd, POSITION_TIMER, 50, nullptr);
-    else { ::KillTimer(m_hWnd, POSITION_TIMER); m_positionHost = nullptr; }
+    else ::KillTimer(m_hWnd, POSITION_TIMER);
   }
   if (!m_editOnly) m_ctx.rewrite.clear();
   bool should_show_icon =
@@ -1272,7 +1272,7 @@ void WeaselPanel::MoveTo(RECT const& rc, HWND host) {
     return;  // avoid handling nullptr in _RepositionWindow
   // Some text stores do not publish TSF layout changes while their window is dragged.
   // Track the focused client origin without changing the inline composition text.
-  if (!m_editOnly && m_status.composing) {
+  if (!m_editOnly) {
     if (!host) {
       GUITHREADINFO info = {sizeof(GUITHREADINFO)};
       const auto foreground = ::GetForegroundWindow();
@@ -1280,6 +1280,9 @@ void WeaselPanel::MoveTo(RECT const& rc, HWND host) {
       if (thread && ::GetGUIThreadInfo(thread, &info)) host = info.hwndFocus;
       if (!host) host = foreground;
     }
+    // XAML focus islands need not move with the visible application window.
+    // Track the root application, and capture it even before composing becomes true.
+    if (host) host = ::GetAncestor(host, GA_ROOT);
     CPoint origin(0, 0);
     if (host && ::ClientToScreen(host, &origin)) {
       m_positionHost = host; m_hostOrigin = origin;
diff --git a/rewrite-build.txt b/rewrite-build.txt
index 260effb..37a7072 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-host-follow-compact-editor-20260930
+Build-ID: rewrite-ui-root-host-follow-20260930
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: compact joined tone-pinyin label; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index aa0f2e5..e11455a 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -183,12 +183,26 @@ int main() {
     HWND inputHost = CreateWindowEx(0, L"STATIC", L"position host", WS_POPUP,
         100, 100, 400, 300, nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
     assert(inputHost);
+    // Position notifications can arrive before the composing status update.
+    HWND focusChild = CreateWindowEx(0, L"STATIC", L"focus island", WS_CHILD,
+        0, 0, 200, 100, inputHost, nullptr, GetModuleHandle(nullptr), nullptr);
+    host.status().composing = false; panel.Refresh();
+    panel.MoveTo(CRect(200, 200, 201, 224), focusChild);
+    host.status().composing = true; panel.Refresh();
     panel.ShowWindow(SW_SHOWNA);
-    panel.MoveTo(CRect(200, 200, 201, 224), inputHost);
     auto normalSurface = panel.SurfaceRect();
     SetWindowPos(inputHost, nullptr, 130, 120, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER);
     BOOL handled = FALSE;
-    panel.OnPositionTimer(WM_TIMER, 20240316, 0, handled);
+    // Pump the actual timer message, rather than calling its handler directly.
+    const auto deadline = GetTickCount64() + 250;
+    while (GetTickCount64() < deadline) {
+      MSG message;
+      while (PeekMessage(&message, nullptr, 0, 0, PM_REMOVE)) {
+        TranslateMessage(&message); DispatchMessage(&message);
+      }
+      Sleep(5);
+    }
+    handled = TRUE;
     normalSurface.OffsetRect(30, 20);
     assert(handled && panel.SurfaceRect() == normalSurface);
     panel.MoveTo(CRect(200, 200, 201, 224), inputHost);
-- 
