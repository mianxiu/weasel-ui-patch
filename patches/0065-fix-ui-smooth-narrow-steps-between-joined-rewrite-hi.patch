--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-preedit-cleanup-20261001
+Build-ID: rewrite-ui-smooth-highlight-20261001
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: integrated Tab preedit row with ordinary prefix numbers; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index d561d4a..08abfb1 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -102,6 +102,26 @@ int main() {
         assert(!weasel::AlignLeadingRewriteHighlight(candidate,separate,body,3*scale));
         assert(separate == before);
       }
+      // Near-aligned right edges used to shrink both curves to a tiny 1-2px
+      // radius. Preserve the long vertical tangent above and below the join.
+      for (int scale : {1, 2}) for (bool above : {false, true}) {
+        for (int step : {2, 4, 8}) {
+          CRect candidate(20*scale, 40*scale, 150*scale, 80*scale);
+          CRect syllable(92*scale, (above ? 12 : 77)*scale,
+                         (150-step)*scale, (above ? 43 : 108)*scale);
+          Gdiplus::GraphicsPath path;
+          assert(weasel::BuildJoinedRewriteHighlight(path,candidate,syllable,
+                                                     13.f*scale,6.f*scale,4.f*scale));
+          const float seam = (float)(above ? candidate.top : candidate.bottom);
+          const float side = above ? -1.f : 1.f;
+          // The outer turn starts before the old half-step radius allowed.
+          assert(!path.IsVisible(149.9f*scale, seam - side*3.f*scale));
+          assert(path.IsVisible(100.f*scale, seam));
+          // Keep all paint inside the original bounds; the text/layout is untouched.
+          Gdiplus::RectF bounds; path.GetBounds(&bounds);
+          assert(bounds.X >= candidate.left && bounds.GetRight() <= candidate.right);
+        }
+      }
       UINT bytes = 0, count = 0; Gdiplus::GetImageEncodersSize(&count, &bytes);
       std::vector<BYTE> codecs(bytes);
       auto* encoders = reinterpret_cast<Gdiplus::ImageCodecInfo*>(codecs.data());
@@ -124,6 +144,13 @@ int main() {
         Gdiplus::Pen border(Gdiplus::Color(255, 130, 130, 130), 1);
         graphics.FillPath(&fill, &outline); graphics.DrawPath(&border, &outline);
         assert(preview.Save(above ? L"deps/joined-outline-above.png" : L"deps/joined-outline-below.png", &png) == Gdiplus::Ok);
+        graphics.Clear(Gdiplus::Color(255,255,255,255));
+        Gdiplus::GraphicsPath highlight;
+        weasel::BuildJoinedRewriteHighlight(highlight, CRect(24,40,150,104),
+            CRect(92,above ? 4 : 101,146,above ? 43 : 152),13,6,4);
+        Gdiplus::SolidBrush blue(Gdiplus::Color(255,38,105,255));
+        graphics.FillPath(&blue,&highlight);
+        assert(preview.Save(above ? L"deps/joined-highlight-above.png" : L"deps/joined-highlight-below.png", &png) == Gdiplus::Ok);
       }
     }
     Gdiplus::GdiplusShutdown(token);
