diff --git a/WeaselUI/JoinedRewritePath.h b/WeaselUI/JoinedRewritePath.h
index 296f89a..db8bfb0 100644
--- a/WeaselUI/JoinedRewritePath.h
+++ b/WeaselUI/JoinedRewritePath.h
@@ -62,15 +62,20 @@ inline void BuildJoinedRewritePath(Gdiplus::GraphicsPath& path, CRect body, CRec
     const float incoming = (float)(abs(c.x - p.x) + abs(c.y - p.y));
     const float outgoing = (float)(abs(n.x - c.x) + abs(n.y - c.y));
     const bool leadingCorner = leadingRadius >= 0 && body.left == tag.left && c.x == body.left;
-    const float radius = (std::max)(0.f, (std::min)(leadingCorner ? leadingRadius : isCorner(c, body) ? bodyRadius :
-        isCorner(c, tag) ? tagRadius : neckRadius, (std::min)(incoming, outgoing) / 2));
+    const float radius = (std::max)(0.f, leadingCorner ? leadingRadius :
+        isCorner(c, body) ? bodyRadius : isCorner(c, tag) ? tagRadius : neckRadius);
+    // A narrow step must not collapse the vertical curve to half its width.
+    // Round with independent tangent lengths (an elliptical quarter arc).
+    // Adjacent curves share the short edge without overlapping or moving text.
+    const float incomingRadius = (std::min)(radius, incoming / 2);
+    const float outgoingRadius = (std::min)(radius, outgoing / 2);
     const Gdiplus::PointF u((c.x - p.x) / incoming, (c.y - p.y) / incoming);
     const Gdiplus::PointF v((n.x - c.x) / outgoing, (n.y - c.y) / outgoing);
-    const Gdiplus::PointF start(c.x - u.X * radius, c.y - u.Y * radius);
-    const Gdiplus::PointF end(c.x + v.X * radius, c.y + v.Y * radius);
+    const Gdiplus::PointF start(c.x - u.X * incomingRadius, c.y - u.Y * incomingRadius);
+    const Gdiplus::PointF end(c.x + v.X * outgoingRadius, c.y + v.Y * outgoingRadius);
     if (i) path.AddLine(last, start); else firstPoint = start;
-    path.AddBezier(start, {start.X + u.X * radius * kappa, start.Y + u.Y * radius * kappa},
-        {end.X - v.X * radius * kappa, end.Y - v.Y * radius * kappa}, end);
+    path.AddBezier(start, {start.X + u.X * incomingRadius * kappa, start.Y + u.Y * incomingRadius * kappa},
+        {end.X - v.X * outgoingRadius * kappa, end.Y - v.Y * outgoingRadius * kappa}, end);
     last = end;
   }
   path.AddLine(last, firstPoint);
