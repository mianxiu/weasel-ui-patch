From f7f90190e1fb721e9746ae33b9b1e9834c207ecf Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Wed, 30 Sep 2026 23:57:20 +0800
Subject: [PATCH 43/62] fix(ui): accept zero-width TSF caret rectangles for
 popup following

---
 Install-Binaries.ps1           |  2 +-
 WeaselUI/WeaselPanel.cpp       | 10 +++++-----
 rewrite-build.txt              |  2 +-
 test/rewrite_pipeline_test.cpp | 18 +++++++++---------
 4 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index 4b434a6..7100e84 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -144,7 +144,7 @@ try {
   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-root-host-follow-20260930; profile: $profileName"
+  Write-Host "Build: rewrite-ui-zero-width-caret-follow-20260930; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index fb96445..8eb003e 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -1258,7 +1258,7 @@ LRESULT WeaselPanel::OnDpiChanged(UINT uMsg,
 LRESULT WeaselPanel::OnPositionTimer(UINT, WPARAM id, LPARAM, BOOL& handled) {
   handled = id == POSITION_TIMER;
   if (!handled || m_editOnly || !m_status.composing || !IsWindowVisible() ||
-      !::IsWindow(m_positionHost) || m_lastCaretRect.IsRectEmpty()) return 0;
+      !::IsWindow(m_positionHost) || (m_lastCaretRect.bottom <= m_lastCaretRect.top)) return 0;
   CPoint origin(0, 0);
   if (!::ClientToScreen(m_positionHost, &origin) || origin == m_hostOrigin) return 0;
   CRect caret = m_lastCaretRect;
@@ -1290,7 +1290,7 @@ void WeaselPanel::MoveTo(RECT const& rc, HWND host) {
   }
   // Keep the raw caret separate from m_inputPos, which positioning mutates.
   if (m_sourceCtx.rewrite.active() && !m_candidateCount &&
-      !m_lastCaretRect.IsRectEmpty() && !m_lastCandidateSurface.IsRectEmpty())
+      (m_lastCaretRect.bottom > m_lastCaretRect.top) && !m_lastCandidateSurface.IsRectEmpty())
     m_lastCandidateSurface.OffsetRect(rc.left - m_lastCaretRect.left,
                                      rc.bottom - m_lastCaretRect.bottom);
   m_lastCaretRect = rc;
@@ -1463,7 +1463,7 @@ void WeaselPanel::_UpdateRewriteWindow() {
     m_editPanel->ModifyStyleEx(0, WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW);
   }
   m_editPanel->m_editLeadingInset = 0;
-  m_editPanel->m_inputPos = m_lastCaretRect.IsRectEmpty() ? m_inputPos : m_lastCaretRect;
+  m_editPanel->m_inputPos = (m_lastCaretRect.bottom <= m_lastCaretRect.top) ? m_inputPos : m_lastCaretRect;
   m_editPanel->Refresh();
   CRect candidate; GetWindowRect(&candidate);
   CRect visible = m_layout->GetContentRect(); visible.OffsetRect(candidate.TopLeft());
@@ -1474,9 +1474,9 @@ void WeaselPanel::_UpdateRewriteWindow() {
   work.DeflateRect((std::max)(m_layout->offsetX, m_editPanel->m_layout->offsetX),
                    (std::max)(m_layout->offsetY, m_editPanel->m_layout->offsetY));
   const auto placement = PositionDetachedRewrite(visible, childContent.Size(),
-      m_lastCaretRect.IsRectEmpty() ? m_inputPos : m_lastCaretRect, work, -DPI_SCALE(2),
+      (m_lastCaretRect.bottom <= m_lastCaretRect.top) ? m_inputPos : m_lastCaretRect, work, -DPI_SCALE(2),
       editorOffset);
-  const auto caret = m_lastCaretRect.IsRectEmpty() ? m_inputPos : m_lastCaretRect;
+  const auto caret = (m_lastCaretRect.bottom <= m_lastCaretRect.top) ? m_inputPos : m_lastCaretRect;
   m_lastCandidateSurface = placement.candidate;
   m_sticky = placement.candidate.bottom <= caret.top;
   const bool reverse = m_sticky && m_style.vertical_auto_reverse &&
diff --git a/rewrite-build.txt b/rewrite-build.txt
index 37a7072..5591701 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-root-host-follow-20260930
+Build-ID: rewrite-ui-zero-width-caret-follow-20260930
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: compact joined tone-pinyin label; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index e11455a..4aec3dc 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -178,7 +178,7 @@ int main() {
     host.ctx() = normal;
     WeaselPanel panel(host);
     assert(panel.Create(nullptr) != nullptr);
-    panel.Refresh(); panel.MoveTo(CRect(200, 200, 201, 224));
+    panel.Refresh(); panel.MoveTo(CRect(200, 200, 200, 224));
     // A real host window moves without publishing a new caret rectangle.
     HWND inputHost = CreateWindowEx(0, L"STATIC", L"position host", WS_POPUP,
         100, 100, 400, 300, nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
@@ -187,7 +187,7 @@ int main() {
     HWND focusChild = CreateWindowEx(0, L"STATIC", L"focus island", WS_CHILD,
         0, 0, 200, 100, inputHost, nullptr, GetModuleHandle(nullptr), nullptr);
     host.status().composing = false; panel.Refresh();
-    panel.MoveTo(CRect(200, 200, 201, 224), focusChild);
+    panel.MoveTo(CRect(200, 200, 200, 224), focusChild);
     host.status().composing = true; panel.Refresh();
     panel.ShowWindow(SW_SHOWNA);
     auto normalSurface = panel.SurfaceRect();
@@ -205,13 +205,13 @@ int main() {
     handled = TRUE;
     normalSurface.OffsetRect(30, 20);
     assert(handled && panel.SurfaceRect() == normalSurface);
-    panel.MoveTo(CRect(200, 200, 201, 224), inputHost);
+    panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     CRect before; panel.GetWindowRect(&before);
     CRect locked;
     for (auto editing : {armed, indexed, replaced, snapshot(L"index_replace", L"3", std::wstring(120, L'a'))}) {
       editing.cinfo = normal.cinfo;
       host.ctx() = editing;
-      panel.Refresh(); panel.MoveTo(CRect(200, 200, 201, 224));
+      panel.Refresh(); panel.MoveTo(CRect(200, 200, 200, 224));
       CRect actual; panel.GetWindowRect(&actual);
       assert(actual.Size() == before.Size());
       assert(panel.RewriteWindow() != nullptr);
@@ -227,29 +227,29 @@ int main() {
       if (locked.IsRectEmpty()) locked = actual;
       assert(actual == locked);
     }
-    panel.MoveTo(CRect(200, 200, 201, 224), inputHost);
+    panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     auto hostCandidate = panel.SurfaceRect(); auto hostEditor = panel.RewriteSurfaceRect();
     SetWindowPos(inputHost, nullptr, 150, 150, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER);
     panel.OnPositionTimer(WM_TIMER, 20240316, 0, handled);
     hostCandidate.OffsetRect(20, 30); hostEditor.OffsetRect(20, 30);
     assert(panel.SurfaceRect() == hostCandidate && panel.RewriteSurfaceRect() == hostEditor);
     assert(panel.RewriteTextRect().left == panel.CandidateTextRect().left);
-    panel.MoveTo(CRect(200, 200, 201, 224), inputHost);
+    panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     // Both surfaces follow horizontal movement and even a one-pixel vertical change.
     auto movedCandidate = panel.SurfaceRect(); auto movedEditor = panel.RewriteSurfaceRect();
-    panel.MoveTo(CRect(230, 201, 231, 225));
+    panel.MoveTo(CRect(230, 201, 230, 225));
     movedCandidate.OffsetRect(30, 1); movedEditor.OffsetRect(30, 1);
     assert(panel.SurfaceRect() == movedCandidate);
     assert(panel.RewriteSurfaceRect() == movedEditor);
     assert(panel.RewriteTextRect().left == panel.CandidateTextRect().left);
-    host.ctx() = normal; panel.Refresh(); panel.MoveTo(CRect(200, 200, 201, 224));
+    host.ctx() = normal; panel.Refresh(); panel.MoveTo(CRect(200, 200, 200, 224));
     CRect after; panel.GetWindowRect(&after);
     assert(after.Size() == before.Size());
     assert(!IsWindowVisible(panel.RewriteWindow()));
     // Force normal placement above a caret near the bottom of the work area.
     MONITORINFO monitor = {sizeof(MONITORINFO)};
     GetMonitorInfo(MonitorFromWindow(panel.m_hWnd, MONITOR_DEFAULTTONEAREST), &monitor);
-    CRect bottomCaret(200, monitor.rcWork.bottom - 25, 201, monitor.rcWork.bottom - 5);
+    CRect bottomCaret(200, monitor.rcWork.bottom - 25, 200, monitor.rcWork.bottom - 5);
     panel.MoveTo(bottomCaret);
     auto editing = indexed; editing.cinfo = normal.cinfo;
     host.ctx() = editing; panel.Refresh(); panel.MoveTo(bottomCaret);
-- 
2.53.0.windows.2

