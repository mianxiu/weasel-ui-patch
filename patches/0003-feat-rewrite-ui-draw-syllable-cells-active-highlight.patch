diff --git a/WeaselUI/RewriteLayout.h b/WeaselUI/RewriteLayout.h
new file mode 100644
index 0000000..6d8eabb
--- /dev/null
+++ b/WeaselUI/RewriteLayout.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "Layout.h"
+
+namespace weasel {
+struct RewriteCell {
+  RewriteState::Unit unit;
+  CRect back, text;
+};
+struct RewriteLayout {
+  CSize size = CSize(0, 0);
+  std::vector<RewriteCell> cells;
+};
+// Used by both measurement and paint, including DPI and wrapping decisions.
+inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
+                                    PDWR dwr) {
+  RewriteLayout result;
+  const auto& style = layout._style;
+  const bool vertical = style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT;
+  const int px = (std::max)(1, style.hilite_padding_x);
+  const int py = (std::max)(1, style.hilite_padding_y);
+  const int gap = (std::max)(2, style.hilite_spacing);
+  const int limit = vertical ? style.max_height : style.max_width;
+  int advance = 0, cross = 0, line = 0;
+  for (const auto& unit : state.Units()) {
+    CSize text(0, 0);
+    layout.GetTextSizeDW(unit.text, unit.text.size(), dwr->pPreeditTextFormat,
+                         dwr, &text);
+    const int w = text.cx + px * 2, h = text.cy + py * 2;
+    const int span = vertical ? h : w;
+    if (limit > 0 && advance > 0 && advance + span > limit) {
+      cross += line + gap;
+      advance = 0;
+      line = 0;
+    }
+    const int x = vertical ? cross : advance;
+    const int y = vertical ? advance : cross;
+    result.cells.push_back({unit, CRect(x, y, x + w, y + h),
+                           CRect(x + px, y + py, x + px + text.cx, y + py + text.cy)});
+    result.size.cx = (std::max<LONG>)(result.size.cx, x + w);
+    result.size.cy = (std::max<LONG>)(result.size.cy, y + h);
+    advance += span + gap;
+    line = (std::max)(line, vertical ? w : h);
+  }
+  return result;
+}
+}  // namespace weasel
