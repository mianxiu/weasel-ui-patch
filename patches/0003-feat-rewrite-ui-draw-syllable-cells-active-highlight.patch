+bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
+  auto layout = MeasureRewrite(*m_layout, m_ctx.rewrite, pDWR);
+  for (auto cell : layout.cells) {
+    cell.back.OffsetRect(rc.left, rc.top);
+    cell.text.OffsetRect(rc.left, rc.top);
+    if (background) {
+      if (cell.unit.active || cell.unit.badge) {
+        unsigned int color = m_style.hilited_back_color;
+        if (cell.unit.badge)
+          color = (color & 0x00ffffff) | (((color >> 24) / 3) << 24);
+        _HighlightText(dc, cell.back, color, 0, DPI_SCALE(m_style.round_corner),
+                       BackType::TEXT, IsToRoundStruct());
+      }
+    } else {
+      int color = cell.unit.active ? m_style.hilited_text_color : m_style.text_color;
+      _TextOut(cell.text, cell.unit.text, cell.unit.text.size(), color,
+               pDWR->pPreeditTextFormat.Get());
+    }
+  }
+  return !layout.cells.empty();
+}
