Subject: [PATCH] feat(installer): install all patches and skin previews in one
 transaction

---
 Apply-Patch.ps1                     | 27 +++++++++++++++++++++------
 INSTALL-PATCH.md                    |  7 ++++---
 Install-Binaries.ps1                |  3 ++-
 package-rewrite.ps1                 |  2 +-
 rewrite-build.txt                   |  3 ++-
 rime/skins/README.md                |  2 +-
 test/installer_transaction_test.ps1 | 29 +++++++++++++++++++++++++++--
 7 files changed, 58 insertions(+), 15 deletions(-)

diff --git a/Apply-Patch.ps1 b/Apply-Patch.ps1
index 0309f95..f4e9228 100644
--- a/Apply-Patch.ps1
+++ b/Apply-Patch.ps1
@@ -117,7 +117,14 @@ try {
     if ((Get-FileHash -LiteralPath $path).Hash -ne $hash) { throw "Package integrity check failed: $relative" }
     $manifest[$relative] = $hash
   }
-  foreach ($required in @('Install-Binaries.ps1','RewriteConfig.exe','rime\lua\indexed_rewrite_pro.lua','rewrite-build.txt')) {
+  $skinIds = @('azure_pill','azure_pill_navy','azure_pill_black','azure_pill_green')
+  $userFiles = @('weasel.custom.yaml','wanxiang_pro.custom.yaml','lua\indexed_rewrite_pro.lua')
+  $requiredFiles = @('Install-Binaries.ps1','RewriteConfig.exe','rime\lua\indexed_rewrite_pro.lua','rewrite-build.txt')
+  foreach ($id in $skinIds) {
+    $requiredFiles += "skins\$id.yaml", "skins\preview\color_scheme_$id.png"
+    $userFiles += "preview\color_scheme_$id.png"
+  }
+  foreach ($required in $requiredFiles) {
     if (!$manifest.ContainsKey($required)) { throw "Manifest missing $required" }
   }
   Write-Host '正在执行安装前预检：下方 CHECK ONLY 属于正常流程，不代表安装失败。'
@@ -132,14 +139,16 @@ try {
   $stage = Join-Path ([IO.Path]::GetTempPath()) $backupName
   New-Item -ItemType Directory -Path $stage | Out-Null
   $inputSnapshot = @{}
-  foreach ($relative in @('weasel.custom.yaml','wanxiang_pro.custom.yaml','lua\indexed_rewrite_pro.lua')) {
+  foreach ($relative in $userFiles) {
     $path = Join-Path $UserDataRoot $relative
     $inputSnapshot[$relative] = if (Test-Path -LiteralPath $path -PathType Leaf) { (Get-FileHash -LiteralPath $path).Hash } else { $null }
   }
   Invoke-Wait (Join-Path $package 'RewriteConfig.exe') ('prepare "{0}" "{1}"' -f $UserDataRoot, $stage)
+  Invoke-Wait (Join-Path $package 'RewriteConfig.exe') ('skins "{0}" "{1}" "{0}"' -f $stage, (Join-Path $package 'skins'))
   Write-Host "Program directory: $Target"
   Write-Host "User directory: $UserDataRoot"
-  Write-Host 'Will merge YAML, install Lua, enable Rewrite UI, disable debug logging, deploy and restart.'
+  Write-Host 'Will install all program patches, Lua, YAML, four skins and previews, then deploy and restart.'
+  Write-Host 'Existing skin selection and layout are preserved; older accent IDs are migrated automatically.'
   Write-Host 'Unrelated YAML values are preserved; comments/formatting are normalized. Originals are backed up.'
   if ($CheckOnly) { Write-Host "CHECK PASSED. Installed files unchanged. Staged configuration: $stage"; exit 0 }
 
@@ -147,7 +156,7 @@ try {
   New-Item -ItemType Directory -Path $transaction | Out-Null
   Start-Transcript -Path (Join-Path $transaction 'install.log') | Out-Null
   $transcribing = $true
-  foreach ($relative in @('weasel.custom.yaml','wanxiang_pro.custom.yaml','lua\indexed_rewrite_pro.lua')) {
+  foreach ($relative in $userFiles) {
     $destination = Join-Path $UserDataRoot $relative
     $saved = Join-Path $transaction $relative
     $existed = Test-Path -LiteralPath $destination -PathType Leaf
@@ -180,17 +189,23 @@ try {
   foreach ($name in @('weasel.custom.yaml','wanxiang_pro.custom.yaml')) { Copy-Checked (Join-Path $stage $name) (Join-Path $UserDataRoot $name) }
   New-Item -ItemType Directory -Path (Join-Path $UserDataRoot 'lua') -Force | Out-Null
   Copy-Checked (Join-Path $package 'rime\lua\indexed_rewrite_pro.lua') (Join-Path $UserDataRoot 'lua\indexed_rewrite_pro.lua')
+  New-Item -ItemType Directory -Path (Join-Path $UserDataRoot 'preview') -Force | Out-Null
+  foreach ($id in $skinIds) {
+    Copy-Checked (Join-Path $package "skins\preview\color_scheme_$id.png") (Join-Path $UserDataRoot "preview\color_scheme_$id.png")
+  }
   Invoke-Wait (Join-Path $Target 'WeaselDeployer.exe') '/deploy'
   Invoke-Wait (Join-Path $package 'RewriteConfig.exe') ('verify "{0}"' -f $UserDataRoot)
+  Invoke-Wait (Join-Path $package 'RewriteConfig.exe') ('skins-verify "{0}" "{1}"' -f $UserDataRoot, (Join-Path $package 'skins'))
   Start-UserServer
-  Write-Host 'SUCCESS: program files, Lua and YAML installed; deployment verified; Rewrite UI enabled.' -ForegroundColor Green
+  Write-Host 'SUCCESS: all program patches, Lua, YAML, four skins and previews installed; deployment verified.' -ForegroundColor Green
   Write-Host 'Fully exit and reopen applications (including background processes) to load the new TSF DLLs. Sign out or restart Windows if they do not refresh.'
   Write-Host "Backups and log: $transaction"
   Write-Host ''
-  Write-Host '安装成功：程序文件、Lua 和 YAML 已安装，部署校验通过，Rewrite UI 已启用。' -ForegroundColor Green
+  Write-Host '安装成功：全部程序补丁、Lua、YAML、四种皮肤及预览图已安装，部署校验通过。' -ForegroundColor Green
   Write-Host '下一步：'
   Write-Host '  1. 完全退出并重新打开测试应用（包括后台进程），加载新版输入法 DLL；仍未刷新再注销或重启。'
   Write-Host '  2. 输入拼音后按 Tab，检查候选框内声调全拼、普通前置序号、末尾编辑字符及 Esc 恢复。'
+  Write-Host '  3. 重新打开界面风格设定，可选择全部四种圆角配色并查看预览。'
   Write-Host '开头的 CHECK ONLY 只是安装前预检；本次安装已完成。'
   Write-Host '备份已保留，无需删除。按任意键只关闭此窗口，不会自动重启 Windows。'
   exit 0
diff --git a/INSTALL-PATCH.md b/INSTALL-PATCH.md
index 7cbddf5..b1b26ca 100644
--- a/INSTALL-PATCH.md
+++ b/INSTALL-PATCH.md
@@ -1,4 +1,4 @@
-> **2026-10-01 皮肤列表与预览：** 普通双击包内 `Apply-Skin-All.cmd`，一次安装蓝色、深蓝、深黑、深绿四种皮肤及预览图，保留当前配色和布局。部署完成后重新打开「界面风格设定」即可选择；四种配色使用独立 ID，不再互相覆盖。单独切换脚本同时安装对应预览图。预览图为候选配色示意，实际大小随 DPI 和配置变化。
+> **2026-10-01 皮肤列表与预览：** 普通双击包内 `Apply-Patch.cmd`，自动更新全部程序补丁，并一次安装蓝色、深蓝、深黑、深绿四种皮肤及预览图，保留当前配色和布局。部署完成后重新打开「界面风格设定」即可选择；四种配色使用独立 ID，不再互相覆盖。单独切换脚本同时安装对应预览图。预览图为候选配色示意，实际大小随 DPI 和配置变化。
 
 > **2026-10-01 窄台阶连续曲线：** 上一版窄连接仍由两个压扁的圆角组成，中间横向切线看起来像尖折。现在宽度不超过连接圆角直径的台阶改用一条 S 形贝塞尔曲线，与上下竖边相切；保留原始背景范围、文字位置、窗口高度和无交集时的独立填充。
 
@@ -82,7 +82,8 @@ Tab 编辑时，原候选框增加一行万象词典声调全拼，候选保持
 - 停止小狼毫，安装对应架构程序和 TSF DLL，检查注册结果与 DLL 哈希。
 - 安装 `lua/indexed_rewrite_pro.lua`，注册重写 processor，设置两个 Tab 绑定。
 - 移除配置中的旧 `indexed_rewrite_tab_ui_v2` filter 引用。
-- 设置 `rewrite_ui/enabled: true`、`rewrite_ui/debug: false`。
+- 设置 `rewrite_ui/enabled: true`、`rewrite_ui/debug: false`。
+- 安装全部四种圆角皮肤及预览图，保留当前配色、布局，并兼容旧配色 ID。
 - 执行重新部署，检查实际生成的配置，再以原用户身份启动小狼毫。
 
 既有主题、双拼、辅助码、其他快捷键及词库保留。YAML 会重新排版，注释不保留；原始文件完整保存在备份中。不会强制把你的拼音方案改成小鹤，也不会下载万象词库。请在小狼毫方案菜单中使用万象 Pro。
@@ -103,7 +104,7 @@ powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\Apply-Patch.ps1 -Check
 
 ## 失败与恢复
 
-用户目录中的 `rewrite-backup-随机编号` 保存原 YAML、原 Lua、`files.json`、`RESTORE.txt` 和 `install.log`。程序目录中同名备份保存原二进制。
+用户目录中的 `rewrite-backup-随机编号` 保存原 YAML、原 Lua、原皮肤预览图、`files.json`、`RESTORE.txt` 和 `install.log`。程序目录中同名备份保存原二进制。
 
 revision 5 起，管理员阶段另外保存 `program-install.log` 与 `program-install-result.json`，主窗口会显示失败阶段、具体错误及恢复结果。若有自动恢复，另存 `program-recovery.log`。反馈故障时优先提供主窗口的 `Stage`、`Error`、`Recovery` 三行。
 
