diff --git a/test/installer_transaction_test.ps1 b/test/installer_transaction_test.ps1
index bd40685..bfe89b2 100644
--- a/test/installer_transaction_test.ps1
+++ b/test/installer_transaction_test.ps1
@@ -29,12 +29,17 @@ function Invoke-Wait {
     $script:events.Add('deploy')
     if ($script:scenario -eq 'deploy-fails' -and !$script:alreadyFailed) { $script:alreadyFailed=$true; throw 'Mock deployment error' }
   } else {
+    if ($Arguments -like 'skins-verify *') {
+      $script:events.Add('verify-skins')
+      if ($script:scenario -eq 'skins-verify-fails') { throw 'Mock missing deployed palette' }
+      return
+    }
     $script:events.Add('verify')
     if ($script:scenario -eq 'verify-fails') { throw 'Mock stale compiled config' }
   }
 }
 function Start-UserServer { $script:events.Add('start-server') }
-foreach ($scenario in @('success','uac-cancel','copy-fails','deploy-fails','verify-fails')) {
+foreach ($scenario in @('success','uac-cancel','copy-fails','preview-copy-fails','deploy-fails','verify-fails','skins-verify-fails')) {
   $testRoot = Join-Path ([IO.Path]::GetTempPath()) ('rewrite-transaction-' + [guid]::NewGuid().ToString('N'))
   $UserDataRoot = Join-Path $testRoot 'user'
   $package = Join-Path $testRoot 'package'
@@ -47,19 +52,39 @@ foreach ($scenario in @('success','uac-cancel','copy-fails','deploy-fails','veri
   Set-Content (Join-Path $stage 'weasel.custom.yaml') 'new UI'
   if ($scenario -ne 'copy-fails') { Set-Content (Join-Path $stage 'wanxiang_pro.custom.yaml') 'new schema' }
   Set-Content (Join-Path $package 'rime/lua/indexed_rewrite_pro.lua') 'new Lua'
+  $skinIds = @('azure_pill','azure_pill_navy','azure_pill_black','azure_pill_green')
+  $userFiles = @('weasel.custom.yaml','wanxiang_pro.custom.yaml','lua\indexed_rewrite_pro.lua')
+  New-Item -ItemType Directory -Path (Join-Path $UserDataRoot 'preview'),(Join-Path $package 'skins/preview') -Force | Out-Null
+  Set-Content (Join-Path $UserDataRoot 'preview/color_scheme_azure_pill.png') 'original preview'
+  $originalPreviewHash = (Get-FileHash (Join-Path $UserDataRoot 'preview/color_scheme_azure_pill.png')).Hash
+  foreach ($id in $skinIds) {
+    $relative = "preview\color_scheme_$id.png"
+    $userFiles += $relative
+    $inputSnapshot[$relative] = if ($id -eq 'azure_pill') { $originalPreviewHash } else { $null }
+    if ($scenario -ne 'preview-copy-fails' -or $id -ne 'azure_pill_green') {
+      Set-Content (Join-Path $package "skins/$relative") "new preview $id"
+    }
+  }
   $backupName='rewrite-backup-' + [guid]::NewGuid().ToString('N')
   $binaryAttempted=$false; $binariesInstalled=$false; $configChanged=$false; $transcribing=$false
   $savedFiles=@(); $alreadyFailed=$false
   $events = New-Object 'System.Collections.Generic.List[string]'
   try { . $install } catch { . $recovery }
   if ($scenario -eq 'success') {
-    Assert (($events -join ',') -eq 'install-binaries,deploy,verify,start-server') 'Wrong successful operation order'
+    Assert (($events -join ',') -eq 'install-binaries,deploy,verify,verify-skins,start-server') 'Wrong successful operation order'
     Assert ((Get-Content (Join-Path $UserDataRoot 'weasel.custom.yaml') -Raw).Trim() -eq 'new UI') 'New UI not installed'
     Assert (Test-Path (Join-Path $UserDataRoot 'lua/indexed_rewrite_pro.lua')) 'Lua not installed'
+    foreach ($id in $skinIds) {
+      Assert ((Get-Content (Join-Path $UserDataRoot "preview/color_scheme_$id.png") -Raw).Trim() -eq "new preview $id") 'Preview not installed'
+    }
   } else {
     Assert ((Get-FileHash (Join-Path $UserDataRoot 'weasel.custom.yaml')).Hash -eq $originalHash) 'Original UI not byte-exactly restored'
     Assert (!(Test-Path (Join-Path $UserDataRoot 'wanxiang_pro.custom.yaml'))) 'New schema not removed on rollback'
     Assert (!(Test-Path (Join-Path $UserDataRoot 'lua/indexed_rewrite_pro.lua'))) 'New Lua not removed on rollback'
+    Assert ((Get-FileHash (Join-Path $UserDataRoot 'preview/color_scheme_azure_pill.png')).Hash -eq $originalPreviewHash) 'Original preview not restored'
+    foreach ($id in @('azure_pill_navy','azure_pill_black','azure_pill_green')) {
+      Assert (!(Test-Path (Join-Path $UserDataRoot "preview/color_scheme_$id.png"))) 'New preview not removed on rollback'
+    }
     if ($scenario -eq 'uac-cancel') { Assert (($events -join ',') -eq 'install-binaries') 'UAC cancel must not restart or deploy' }
     else { Assert ($events.Contains('restore-binaries')) 'Binary recovery not requested' }
   }
