diff --git a/Apply-Skin.ps1 b/Apply-Skin.ps1
new file mode 100644
index 0000000..67df548
--- /dev/null
+++ b/Apply-Skin.ps1
@@ -0,0 +1,110 @@
+﻿[CmdletBinding()]
+param([string]$UserDataRoot, [string]$Target, [switch]$CheckOnly)
+$ErrorActionPreference = 'Stop'
+$changed = $false; $saved = $null; $locked = $false; $mutex = $null
+function Run-Deploy {
+  $p = Start-Process -FilePath (Join-Path $Target 'WeaselDeployer.exe') -ArgumentList '/deploy' -WindowStyle Hidden -PassThru
+  try {
+    $null = $p.Handle
+    while (!$p.WaitForExit(10000)) { Write-Host '正在部署皮肤…' }
+    if ($p.ExitCode -ne 0) { throw "部署失败：$($p.ExitCode)" }
+  } finally { $p.Dispose() }
+}
+try {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  $principal = New-Object Security.Principal.WindowsPrincipal($identity)
+  if (!$CheckOnly -and $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw '请普通双击 Apply-Skin.cmd，无需以管理员身份运行。'
+  }
+  $mutex = New-Object Threading.Mutex($false, 'Local\WeaselRewritePatchInstaller')
+  try { $locked = $mutex.WaitOne(0) } catch [Threading.AbandonedMutexException] { $locked = $true }
+  if (!$locked) { throw '另一个补丁或皮肤安装器正在运行。' }
+  $manifest = Join-Path $PSScriptRoot 'SHA256SUMS.txt'
+  if (Test-Path -LiteralPath $manifest) {
+    foreach ($line in Get-Content -LiteralPath $manifest) {
+      if ($line -notmatch '^([a-fA-F0-9]{64})\s+(.+)$') { throw '皮肤包校验表无效。' }
+      $expected = $Matches[1]
+      $file = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot $Matches[2]))
+      if (!$file.StartsWith($PSScriptRoot.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) { throw '皮肤包路径无效。' }
+      if ((Get-FileHash -LiteralPath $file).Hash -ne $expected) { throw '皮肤包文件校验失败。' }
+    }
+  }
+  $registered = Join-Path $env:APPDATA 'Rime'
+  $settings = Get-ItemProperty 'HKCU:\Software\Rime\Weasel' -ErrorAction SilentlyContinue
+  if ($settings -and $settings.PSObject.Properties['RimeUserDir'] -and $settings.RimeUserDir) {
+    $registered = [Environment]::ExpandEnvironmentVariables([string]$settings.RimeUserDir)
+  }
+  if (!$UserDataRoot) { $UserDataRoot = $registered }
+  $UserDataRoot = (Resolve-Path -LiteralPath $UserDataRoot).Path
+  if (!$CheckOnly -and $UserDataRoot -ine (Resolve-Path -LiteralPath $registered).Path) {
+    throw '用户目录与注册的 Rime 目录不同，无法安全部署。'
+  }
+  $helper = Join-Path $PSScriptRoot 'RewriteConfig.exe'
+  if (!(Test-Path $helper)) { $helper = Join-Path $PSScriptRoot 'output/RewriteConfig.exe' }
+  $theme = Join-Path $PSScriptRoot 'skins/azure_pill.yaml'
+  if (!(Test-Path $theme)) { $theme = Join-Path $PSScriptRoot 'rime/skins/azure_pill.yaml' }
+  $stage = Join-Path ([IO.Path]::GetTempPath()) ('azure-pill-' + [guid]::NewGuid().ToString('N'))
+  $destination = Join-Path $UserDataRoot 'weasel.custom.yaml'
+  $originalHash = if (Test-Path -LiteralPath $destination) { (Get-FileHash -LiteralPath $destination).Hash } else { $null }
+  & $helper skin $UserDataRoot $theme $stage
+  if ($LASTEXITCODE) { throw '皮肤配置合并失败。' }
+  if ($CheckOnly) { Write-Host "CHECK PASSED：未修改用户配置。合并预览：$stage"; exit 0 }
+  if (!$Target) {
+    foreach ($view in @([Microsoft.Win32.RegistryView]::Registry32, [Microsoft.Win32.RegistryView]::Registry64)) {
+      $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, $view)
+      try {
+        $key = $base.OpenSubKey('Software\Rime\Weasel')
+        if ($key) { try { $Target = [string]$key.GetValue('WeaselRoot') } finally { $key.Dispose() } }
+      } finally { $base.Dispose() }
+      if ($Target) { break }
+    }
+  }
+  if (!$Target) { throw '未找到小狼毫安装目录。' }
+  $Target = (Resolve-Path -LiteralPath $Target).Path
+  foreach ($name in @('WeaselDeployer.exe','WeaselServer.exe')) {
+    if (!(Test-Path -LiteralPath (Join-Path $Target $name))) { throw "缺少 $name" }
+  }
+  if (@(Get-Process WeaselDeployer,WeaselSetup -ErrorAction SilentlyContinue).Count) { throw '另一个部署或安装进程正在运行。' }
+  $destination = Join-Path $UserDataRoot 'weasel.custom.yaml'
+  $currentHash = if (Test-Path -LiteralPath $destination) { (Get-FileHash -LiteralPath $destination).Hash } else { $null }
+  if ($currentHash -ne $originalHash) { throw '配置在预览期间发生变化，请重新运行。' }
+  $existed = Test-Path -LiteralPath $destination
+  $saved = $destination + '.azure-pill-backup-' + [guid]::NewGuid().ToString('N')
+  if ($existed) { Copy-Item -LiteralPath $destination -Destination $saved }
+  $changed = $true
+  Copy-Item -LiteralPath (Join-Path $stage 'weasel.custom.yaml') -Destination $destination -Force
+  Run-Deploy
+  & $helper skin-verify $UserDataRoot
+  if ($LASTEXITCODE) { throw '部署后的皮肤校验失败。' }
+  $server = Join-Path $Target 'WeaselServer.exe'
+  $p = Start-Process -FilePath $server -ArgumentList '/q' -WindowStyle Hidden -PassThru
+  try {
+    $null = $p.Handle
+    if (!$p.WaitForExit(10000)) { throw '退出请求尚未结束，请从托盘手动重启小狼毫。' }
+  } finally { $p.Dispose() }
+  $deadline = [DateTime]::UtcNow.AddSeconds(10)
+  do {
+    $running = @(Get-Process WeaselServer -ErrorAction SilentlyContinue | Where-Object {$_.Path -ieq $server})
+    if (!$running.Count) { break }
+    Start-Sleep -Milliseconds 100
+  } while ([DateTime]::UtcNow -lt $deadline)
+  if ($running.Count) { throw '小狼毫尚未退出，请从托盘手动重启后再运行。' }
+  Start-Process -FilePath $server -WindowStyle Hidden | Out-Null
+  Write-Host 'SUCCESS：蓝白圆角皮肤已启用，部署校验通过，服务已重启。无需重启 Windows。'
+  if ($existed) { Write-Host "原配置备份：$saved" }
+} catch {
+  Write-Host "SKIN FAILED：$($_.Exception.Message)" -ForegroundColor Red
+  if ($changed) {
+    try {
+      if ($existed) { Copy-Item -LiteralPath $saved -Destination $destination -Force }
+      else { Remove-Item -LiteralPath $destination }
+      Run-Deploy
+      Start-Process -FilePath (Join-Path $Target 'WeaselServer.exe') -WindowStyle Hidden | Out-Null
+      Write-Host '原配置已恢复并重新部署。'
+    } catch { Write-Host "恢复未完成，请保留备份：$saved" }
+  }
+  exit 1
+} finally {
+  if ($locked) { $mutex.ReleaseMutex() }
+  if ($mutex) { $mutex.Dispose() }
+}
diff --git a/INSTALL-PATCH.md b/INSTALL-PATCH.md
