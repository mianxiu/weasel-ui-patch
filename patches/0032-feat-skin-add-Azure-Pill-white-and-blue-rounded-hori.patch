--- /dev/null
+++ b/Apply-Skin.cmd
@@ -0,0 +1,8 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Apply-Skin.ps1"
+set "skin_result=%errorlevel%"
+echo.
+pause
