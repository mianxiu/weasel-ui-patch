@@ -0,0 +1,34 @@
+$ErrorActionPreference = 'Stop'
+Set-Location $PSScriptRoot
+$final = Join-Path $PSScriptRoot 'dist/Weasel-Azure-Pill'
+$stage = $final + '-stage-' + [guid]::NewGuid().ToString('N')
+New-Item -ItemType Directory -Path (Join-Path $stage 'skins') -Force | Out-Null
+Copy-Item Apply-Skin.cmd,Apply-Skin.ps1,output/RewriteConfig.exe -Destination $stage
+Copy-Item rime/skins/azure_pill.yaml -Destination (Join-Path $stage 'skins')
+Copy-Item rime/skins/README.md -Destination (Join-Path $stage 'README.md')
+Copy-Item librime/deps/yaml-cpp/LICENSE -Destination (Join-Path $stage 'yaml-cpp-MIT.txt')
+Copy-Item LICENSE.txt -Destination (Join-Path $stage 'Weasel-GPL-3.0.txt')
+Add-Type -AssemblyName System.IO.Compression.FileSystem
+$stream = [IO.File]::Open((Join-Path $stage 'skin-helper-source.zip'), [IO.FileMode]::Create)
+$archive = [IO.Compression.ZipArchive]::new($stream, [IO.Compression.ZipArchiveMode]::Create)
+try {
+  $files = @(Get-Item tools/rewrite-config.cpp,build-rewrite-config.cmd,LICENSE.txt,librime/deps/yaml-cpp/LICENSE) +
+           @(Get-ChildItem librime/deps/yaml-cpp/include,librime/deps/yaml-cpp/src -Recurse -File)
+  foreach ($file in $files) {
+    $relative = [IO.Path]::GetRelativePath($PSScriptRoot, $file.FullName).Replace('\','/')
+    [IO.Compression.ZipFileExtensions]::CreateEntryFromFile($archive, $file.FullName, $relative) | Out-Null
+  }
+} finally { $archive.Dispose(); $stream.Dispose() }
+$manifest = Get-ChildItem $stage -Recurse -File | ForEach-Object {
+  (Get-FileHash -LiteralPath $_.FullName).Hash.ToLowerInvariant() + '  ' + [IO.Path]::GetRelativePath($stage, $_.FullName)
+}
+$manifest | Set-Content (Join-Path $stage 'SHA256SUMS.txt') -Encoding utf8
+Compress-Archive -Path "$stage/*" -DestinationPath 'dist/Weasel-Azure-Pill.zip' -Force
+if (Test-Path -LiteralPath $final) {
+  $resolved = (Resolve-Path -LiteralPath $final).Path
+  if ($resolved -ne [IO.Path]::GetFullPath($final) -or
+      (Get-Item -LiteralPath $resolved).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Unsafe skin destination' }
+  Move-Item -LiteralPath $resolved -Destination ($final + '-previous-' + [guid]::NewGuid().ToString('N'))
+}
+Move-Item -LiteralPath $stage -Destination $final
+Get-Item 'dist/Weasel-Azure-Pill.zip' | Select-Object FullName,Length
