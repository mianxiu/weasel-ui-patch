+// A skin changes only the named UI leaves; preserve unrelated nested settings.
+void clearNestedSkinLeaf(YAML::Node root, const std::string& path) {
+  for (size_t cut = path.find('/'); cut != std::string::npos;
+       cut = path.find('/', cut + 1)) {
+    auto prefix = path.substr(0, cut);
+    if (!root[prefix]) continue;
+    auto node = root[prefix];
+    size_t start = cut + 1;
+    while (true) {
+      require(node.IsMap(), "Skin conflicts with non-map UI path: " + prefix);
+      auto end = path.find('/', start);
+      auto part = path.substr(start, end - start);
+      if (end == std::string::npos) { node.remove(part); break; }
+      if (!node[part]) break;
+      node.reset(node[part]);
+      start = end + 1;
+    }
+  }
+}
+void skin(const fs::path& user, const fs::path& theme, const fs::path& stage) {
+  auto ui = load(user / L"weasel.custom.yaml", true);
+  auto target = patch(ui);
+  auto skinDoc = load(theme);
+  auto values = patch(skinDoc);
+  require(values.size() > 0, "Skin is empty");
+  for (auto item : values) {
+    auto key = item.first.Scalar();
+    require(key.rfind("style/", 0) == 0 || key == "preset_color_schemes/azure_pill",
+            "Unsupported skin setting: " + key);
+    clearNestedSkinLeaf(target, key);
+    target[key] = YAML::Clone(item.second);
+  }
+  fs::create_directories(stage);
+  save(ui, stage / L"weasel.custom.yaml");
+}
