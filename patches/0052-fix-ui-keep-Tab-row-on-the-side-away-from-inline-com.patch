diff --git a/WeaselUI/StandardLayout.cpp b/WeaselUI/StandardLayout.cpp
index 50f39a8..ec8ce09 100644
--- a/WeaselUI/StandardLayout.cpp
+++ b/WeaselUI/StandardLayout.cpp
@@ -399,3 +399,37 @@ bool StandardLayout::ShouldDisplayStatusIcon() const {
             _style.layout_type == UIStyle::LAYOUT_VERTICAL_FULLSCREEN) &&
            !_context.aux.empty());
 }
