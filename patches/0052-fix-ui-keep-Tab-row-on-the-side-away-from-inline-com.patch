+// Move the measured row inside the existing body without resizing or reflowing.
+// Ordinary composition is unaffected; the Tab row occupies the far side of the caret.
+bool StandardLayout::ArrangeRewriteRow(bool below) {
+  if (!_context.rewrite.active() || candidates_count == 0 ||
+      _style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT || below == _rewriteBelow)
+    return false;
+  if (below) {
+    int first = _candidateRects[0].top, last = _candidateRects[0].bottom;
+    for (int i = 1; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+      first = (std::min)(first, (int)_candidateRects[i].top);
+      last = (std::max)(last, (int)_candidateRects[i].bottom);
+    }
+    if (!_auxiliaryRect.IsRectEmpty()) first = (std::min)(first, (int)_auxiliaryRect.top);
+    _rewriteCandidateShift = first - _preeditRect.top;
+    _rewriteTextShift = last - _preeditRect.bottom;
+  }
+  const int candidateDelta = below ? -_rewriteCandidateShift : _rewriteCandidateShift;
+  const int textDelta = below ? _rewriteTextShift : -_rewriteTextShift;
+  _preeditRect.OffsetRect(0, textDelta);
+  _prePageRect.OffsetRect(0, textDelta); _nextPageRect.OffsetRect(0, textDelta);
+  if (!_auxiliaryRect.IsRectEmpty()) _auxiliaryRect.OffsetRect(0, candidateDelta);
+  for (int i = 0; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+    _candidateRects[i].OffsetRect(0, candidateDelta);
+    _candidateLabelRects[i].OffsetRect(0, candidateDelta);
+    _candidateTextRects[i].OffsetRect(0, candidateDelta);
+    _candidateCommentRects[i].OffsetRect(0, candidateDelta);
+  }
+  _highlightRect.OffsetRect(0, candidateDelta);
+  if (!_statusIconRect.IsRectEmpty()) _statusIconRect.OffsetRect(0, textDelta);
+  // The shared body keeps its full corner radii; all highlights stay inset.
+  _rewriteBelow = below;
+  return true;
+}
