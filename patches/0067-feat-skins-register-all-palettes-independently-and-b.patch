diff --git a/tools/generate-skin-previews.ps1 b/tools/generate-skin-previews.ps1
new file mode 100644
index 0000000..4ee0bed
--- /dev/null
+++ b/tools/generate-skin-previews.ps1
@@ -0,0 +1,50 @@
+﻿$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Drawing
+$skins = Join-Path (Split-Path $PSScriptRoot -Parent) 'rime/skins'
+$output = Join-Path $skins 'preview'
+New-Item -ItemType Directory -Path $output -Force | Out-Null
+function Rounded-Path([float]$x, [float]$y, [float]$w, [float]$h, [float]$radius) {
+  $path = New-Object Drawing.Drawing2D.GraphicsPath
+  $d = $radius * 2
+  $path.AddArc($x, $y, $d, $d, 180, 90)
+  $path.AddArc($x+$w-$d, $y, $d, $d, 270, 90)
+  $path.AddArc($x+$w-$d, $y+$h-$d, $d, $d, 0, 90)
+  $path.AddArc($x, $y+$h-$d, $d, $d, 90, 90)
+  $path.CloseFigure()
+  return ,$path
+}
+foreach ($file in Get-ChildItem -LiteralPath $skins -Filter 'azure_pill*.yaml') {
+  $yaml = [IO.File]::ReadAllText($file.FullName)
+  $id = [regex]::Match($yaml, 'style/color_scheme: (\w+)').Groups[1].Value
+  $name = [regex]::Match($yaml, 'name: "([^"]+)"').Groups[1].Value
+  $rgba = [regex]::Match($yaml, 'hilited_candidate_back_color: 0x([0-9A-Fa-f]{8})').Groups[1].Value
+  $accent = [Drawing.Color]::FromArgb(255, [Convert]::ToInt32($rgba.Substring(0,2),16), [Convert]::ToInt32($rgba.Substring(2,2),16), [Convert]::ToInt32($rgba.Substring(4,2),16))
+  $bitmap = New-Object Drawing.Bitmap(480, 260)
+  $g = [Drawing.Graphics]::FromImage($bitmap)
+  $owned = @($g, $bitmap)
+  try {
+    $g.SmoothingMode = 'AntiAlias'
+    $g.TextRenderingHint = 'AntiAliasGridFit'
+    $g.Clear([Drawing.Color]::FromArgb(240,240,240))
+    $font = New-Object Drawing.Font('Microsoft YaHei UI', 16, [Drawing.FontStyle]::Regular, [Drawing.GraphicsUnit]::Pixel)
+    $small = New-Object Drawing.Font('Microsoft YaHei UI', 13, [Drawing.FontStyle]::Regular, [Drawing.GraphicsUnit]::Pixel)
+    $brush = New-Object Drawing.SolidBrush($accent)
+    $border = New-Object Drawing.Pen([Drawing.Color]::FromArgb(206,206,206))
+    $shadow = New-Object Drawing.SolidBrush([Drawing.Color]::FromArgb(25,0,0,0))
+    $outer = Rounded-Path 18 86 444 82 16
+    $shadowPath = Rounded-Path 18 91 444 82 16
+    $selected = Rounded-Path 30 103 100 48 13
+    $owned += @($font,$small,$brush,$border,$shadow,$outer,$shadowPath,$selected)
+    $g.DrawString($name, $font, [Drawing.Brushes]::Black, 22, 25)
+    $g.DrawString('输入：pi fu', $small, [Drawing.Brushes]::DimGray, 22, 60)
+    $g.FillPath($shadow,$shadowPath)
+    $g.FillPath([Drawing.Brushes]::White,$outer)
+    $g.DrawPath($border,$outer)
+    $g.FillPath($brush,$selected)
+    $g.DrawString('1. 皮肤', $font, [Drawing.Brushes]::White, 42, 117)
+    $g.DrawString('2. 预览', $font, [Drawing.Brushes]::Black, 154, 117)
+    $g.DrawString('3. 配色', $font, [Drawing.Brushes]::Black, 275, 117)
+    $g.DrawString('候选配色示意 · 实际大小随 DPI 和配置变化', $small, [Drawing.Brushes]::DimGray, 22, 206)
+    $bitmap.Save((Join-Path $output "color_scheme_$id.png"), [Drawing.Imaging.ImageFormat]::Png)
+  } finally { foreach ($item in $owned) { $item.Dispose() } }
+}
