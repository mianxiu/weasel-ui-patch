new file mode 100644
index 0000000..ce05dd9
--- /dev/null
+++ b/Apply-Skin-All.cmd
@@ -0,0 +1,8 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Apply-Skin.ps1" -All
