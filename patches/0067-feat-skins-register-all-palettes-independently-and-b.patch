@@ -70,10 +71,30 @@ void UIStyleSettingsDialog::Preview(int index) {
       settings_->GetColorSchemePreview(preset_[index].color_scheme_id));
   if (file_path.empty())
     return;
+  // A missing image must not leave the previous skin visible.
   image_.Destroy();
-  // it is from ansi coding, not utf8
-  image_.Load(acptow(file_path).c_str());
-  if (!image_.IsNull()) {
-    preview_.SetBitmap(image_);
-  }
+  image_.Load(u8tow(file_path).c_str());
+  preview_.Invalidate();
+}
+
+LRESULT UIStyleSettingsDialog::OnDrawPreview(UINT, WPARAM, LPARAM lparam,
+                                            BOOL& handled) {
+  auto draw = reinterpret_cast<DRAWITEMSTRUCT*>(lparam);
+  if (draw->CtlID != IDC_PREVIEW) { handled = FALSE; return 0; }
+  FillRect(draw->hDC, &draw->rcItem, GetSysColorBrush(COLOR_3DFACE));
+  if (image_.IsNull()) return TRUE;
+  const int available_width = draw->rcItem.right - draw->rcItem.left;
+  const int available_height = draw->rcItem.bottom - draw->rcItem.top;
+  const double scale = (std::min)(double(available_width) / image_.GetWidth(),
+                                 double(available_height) / image_.GetHeight());
+  const int width = int(image_.GetWidth() * scale);
+  const int height = int(image_.GetHeight() * scale);
+  const int old_mode = SetStretchBltMode(draw->hDC, HALFTONE);
+  POINT old_origin;
+  SetBrushOrgEx(draw->hDC, 0, 0, &old_origin);
+  image_.Draw(draw->hDC, draw->rcItem.left + (available_width - width) / 2,
+              draw->rcItem.top + (available_height - height) / 2, width, height);
+  SetBrushOrgEx(draw->hDC, old_origin.x, old_origin.y, NULL);
+  SetStretchBltMode(draw->hDC, old_mode);
+  return TRUE;
 }
