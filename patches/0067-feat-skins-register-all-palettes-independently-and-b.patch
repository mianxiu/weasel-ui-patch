+$all = [IO.File]::ReadAllText((Join-Path $root 'all/weasel.custom.yaml'))
+foreach ($value in @('style/color_scheme: old','font_point: 30','margin_x: 42','terminal.exe','rewrite_ui/enabled: true',
+                     'preset_color_schemes/azure_pill:', 'preset_color_schemes/azure_pill_navy:',
+                     'preset_color_schemes/azure_pill_black:', 'preset_color_schemes/azure_pill_green:')) {
+  if (!$all.Contains($value)) { throw "Bulk install missing or changed: $value" }
+}
+& $helper skins (Join-Path $root 'all') (Join-Path $repo 'rime/skins') (Join-Path $root 'all-second')
+if ($LASTEXITCODE) { throw 'Repeated bulk skin merge failed' }
+if ([IO.File]::ReadAllText((Join-Path $root 'all-second/weasel.custom.yaml')) -ne $all) { throw 'Bulk install is not idempotent' }
+Write-Host 'PASS: independent IDs, bulk installation preserves current style, and is idempotent.'
