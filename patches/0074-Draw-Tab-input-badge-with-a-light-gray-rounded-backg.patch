diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index d314e02..3233e05 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -900,7 +900,13 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
     const CRect clip = cell.unit.badge ? editor : syllables;
     if (stable && background) cell.labelBack.IntersectRect(cell.labelBack, clip);
     if (background) {
-      if (cell.unit.active) {
+      if (cell.unit.badge) {
+        auto back = cell.back; back.OffsetRect(rc.left, rc.top);
+        back.InflateRect(DPI_SCALE(4), DPI_SCALE(m_style.hilite_padding_y));
+        if (stable) back.IntersectRect(back, clip);
+        _HighlightText(dc, back, 0xffe8e8e8, 0, DPI_SCALE(6),
+                       BackType::TEXT, IsToRoundStruct());
+      } else if (cell.unit.active) {
         auto back = cell.back; back.OffsetRect(rc.left, rc.top);
         // Pad the painted fill, without changing text layout or window height.
         back.InflateRect(DPI_SCALE(4), DPI_SCALE(m_style.hilite_padding_y));
@@ -937,7 +943,8 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
         }
       }
     } else {
-      int color = cell.unit.active ? m_style.hilited_candidate_text_color : m_style.text_color;
+      int color = cell.unit.badge ? 0xff555555 :
+          (cell.unit.active ? m_style.hilited_candidate_text_color : m_style.text_color);
       if (stable) pDWR->pRenderTarget->PushAxisAlignedClip(
           D2D1::RectF((float)clip.left, (float)clip.top, (float)clip.right, (float)clip.bottom),
           D2D1_ANTIALIAS_MODE_ALIASED);
