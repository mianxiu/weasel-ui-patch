-void WeaselPanel::MoveTo(RECT const& rc) {
+LRESULT WeaselPanel::OnPositionTimer(UINT, WPARAM id, LPARAM, BOOL& handled) {
+  handled = id == POSITION_TIMER;
+  if (!handled || m_editOnly || !m_status.composing || !IsWindowVisible() ||
+      !::IsWindow(m_positionHost) || m_lastCaretRect.IsRectEmpty()) return 0;
+  CPoint origin(0, 0);
+  if (!::ClientToScreen(m_positionHost, &origin) || origin == m_hostOrigin) return 0;
+  CRect caret = m_lastCaretRect;
+  caret.OffsetRect(origin - m_hostOrigin);
+  MoveTo(caret, m_positionHost);
+  return 0;
+}
+
+void WeaselPanel::MoveTo(RECT const& rc, HWND host) {
   if (!m_layout)
     return;  // avoid handling nullptr in _RepositionWindow
+  // Some text stores do not publish TSF layout changes while their window is dragged.
+  // Track the focused client origin without changing the inline composition text.
+  if (!m_editOnly && m_status.composing) {
+    if (!host) {
+      GUITHREADINFO info = {sizeof(GUITHREADINFO)};
+      const auto foreground = ::GetForegroundWindow();
+      const auto thread = ::GetWindowThreadProcessId(foreground, nullptr);
+      if (thread && ::GetGUIThreadInfo(thread, &info)) host = info.hwndFocus;
+      if (!host) host = foreground;
+    }
+    CPoint origin(0, 0);
+    if (host && ::ClientToScreen(host, &origin)) {
+      m_positionHost = host; m_hostOrigin = origin;
+    }
+  }
   // Keep the raw caret separate from m_inputPos, which positioning mutates.
   if (m_sourceCtx.rewrite.active() && !m_candidateCount &&
       !m_lastCaretRect.IsRectEmpty() && !m_lastCandidateSurface.IsRectEmpty())
@@ -1406,7 +1439,7 @@ void WeaselPanel::_UpdateRewriteWindow() {
