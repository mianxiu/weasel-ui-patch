diff --git a/Collect-IME-Diagnostics.cmd b/Collect-IME-Diagnostics.cmd
new file mode 100644
index 0000000..a114a2b
--- /dev/null
+++ b/Collect-IME-Diagnostics.cmd
@@ -0,0 +1,7 @@
+@echo off
+setlocal
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Collect-IME-Diagnostics.ps1" %*
+set "diagnostic_result=%errorlevel%"
+echo.
+pause
+exit /b %diagnostic_result%
diff --git a/Collect-IME-Diagnostics.ps1 b/Collect-IME-Diagnostics.ps1
new file mode 100644
index 0000000..fd5998a
--- /dev/null
+++ b/Collect-IME-Diagnostics.ps1
@@ -0,0 +1,114 @@
+param([string]$OutputDirectory = (Join-Path $PSScriptRoot 'diagnostics'))
+$ErrorActionPreference = 'Stop'
+$notes = New-Object 'System.Collections.Generic.List[string]'
+function Read-RegistryValues([string]$Path, [string[]]$Names) {
+  $result = [ordered]@{}
+  foreach ($name in $Names) {
+    try {
+      $item = Get-ItemProperty -LiteralPath $Path -Name $name -ErrorAction Stop
+      $result[$name] = $item.$name
+    } catch { $result[$name] = $null }
+  }
+  return $result
+}
+function Get-PEBuildStamp([byte[]]$Bytes) {
+  if ($Bytes.Length -lt 64) { return $null }
+  $offset = [BitConverter]::ToInt32($Bytes, 60)
+  if ($offset -lt 0 -or $offset + 12 -gt $Bytes.Length) { return $null }
+  return [BitConverter]::ToUInt32($Bytes, $offset + 8)
+}
+function Read-FileIdentity([string]$Path, [bool]$Hash = $true) {
+  if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
+  $file = Get-Item -LiteralPath $Path
+  return [ordered]@{
+    name = $file.Name; version = $file.VersionInfo.FileVersion
+    productVersion = $file.VersionInfo.ProductVersion; size = $file.Length
+    buildStamp = Get-PEBuildStamp ([IO.File]::ReadAllBytes($Path))
+    sha256 = $(if ($Hash) { (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash } else { $null })
+  }
+}
+# Read only the PE header of an already loaded Weasel DLL. This distinguishes
+# the old DLL retained by a running app from the newly replaced file on disk.
+Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+public static class WeaselDiagnosticMemory {
+ [DllImport("kernel32.dll",SetLastError=true)] public static extern IntPtr OpenProcess(uint access,bool inherit,int pid);
+ [DllImport("kernel32.dll",SetLastError=true)] public static extern bool ReadProcessMemory(IntPtr process,IntPtr address,byte[] data,int size,out IntPtr read);
+ [DllImport("kernel32.dll")] public static extern bool CloseHandle(IntPtr handle);
+}
+'@
+$os = Read-RegistryValues 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' @(
+  'ProductName','DisplayVersion','CurrentBuildNumber','UBR','BuildLabEx','EditionID','InstallationType')
+$os['family'] = $(if ([int]$os.CurrentBuildNumber -ge 22000) {'Windows 11'} else {'Windows 10'})
+$touch = Read-RegistryValues 'HKCU:\Software\Microsoft\InputMethod\Settings\Common' @(
+  'TouchKeyboardHasEverShown','TouchKeyboardLastUsedTime','TouchKeyboardLastUsedTimeStamp')
+$components = [ordered]@{}
+$components.TextInputHost = Read-FileIdentity (Join-Path $env:WINDIR 'SystemApps\MicrosoftWindows.Client.CBS_cw5n1h2txyewy\TextInputHost.exe')
+$commonFiles = [Environment]::GetFolderPath([Environment+SpecialFolder]::CommonProgramFiles)
+$components.TabTip = Read-FileIdentity (Join-Path $commonFiles 'microsoft shared\ink\TabTip.exe')
+$components.ctfmon = Read-FileIdentity (Join-Path $env:WINDIR 'System32\ctfmon.exe')
+$components.WeaselSystem64 = Read-FileIdentity (Join-Path $env:WINDIR 'System32\weasel.dll')
+$components.WeaselSystem32 = Read-FileIdentity (Join-Path $env:WINDIR 'SysWOW64\weasel.dll')
+Write-Host 'Reading Windows updates and running input-method modules...'
+$updates = @()
+try { $updates = @(Get-HotFix | Sort-Object HotFixID | ForEach-Object {
+  [ordered]@{id=$_.HotFixID;installedOn=$(if ($_.InstalledOn) {$_.InstalledOn.ToString('yyyy-MM-dd')} else {$null})}
+}) } catch { $notes.Add('Windows update enumeration unavailable.') }
+$languages = @()
+try { $languages = @(Get-WinUserLanguageList | ForEach-Object {
+  [ordered]@{language=$_.LanguageTag;inputMethods=@($_.InputMethodTips)}
+}) } catch { $notes.Add('Windows language list unavailable.') }
+$apps = @()
+foreach ($process in (Get-Process QQ,chrome,msedge,Code,WeaselServer,TextInputHost,ctfmon -ErrorAction SilentlyContinue)) {
+  $entry = [ordered]@{name=$process.ProcessName;pid=$process.Id;started=$null;version=$null;loadedWeasel=@()}
+  try { $entry.started = $process.StartTime.ToString('o') } catch { }
+  try { $entry.version = (Get-Item -LiteralPath $process.Path).VersionInfo.FileVersion } catch { }
+  try {
+    foreach ($module in $process.Modules) {
+      if ($module.ModuleName -notmatch '^weasel.*\.dll$') { continue }
+      $disk = Read-FileIdentity $module.FileName
+      $stamp = $null
+      $handle = [WeaselDiagnosticMemory]::OpenProcess(0x410,$false,$process.Id)
+      if ($handle -ne [IntPtr]::Zero) {
+        try {
+          $bytes = New-Object byte[] 4096
+          $read = [IntPtr]::Zero
+          if ([WeaselDiagnosticMemory]::ReadProcessMemory($handle,$module.BaseAddress,$bytes,4096,[ref]$read)) {
+            $stamp = Get-PEBuildStamp $bytes
+          }
+        } finally { [void][WeaselDiagnosticMemory]::CloseHandle($handle) }
+      }
+      $entry.loadedWeasel += [ordered]@{name=$module.ModuleName;memoryBuildStamp=$stamp;
+        diskBuildStamp=$disk.buildStamp;diskSha256=$disk.sha256;
+        memoryMatchesDisk=$(if ($null -ne $stamp) {$stamp -eq $disk.buildStamp} else {$null})}
+    }
+  } catch { $notes.Add('Module enumeration unavailable for '+$process.ProcessName+' PID '+$process.Id) }
+  $apps += $entry
+}
+$ui = @()
+$userDirectory = Join-Path $env:APPDATA 'Rime'
+foreach ($name in @('weasel.custom.yaml','build\weasel.yaml')) {
+  $path = Join-Path $userDirectory $name
+  if (Test-Path -LiteralPath $path) {
+    # Export selected presentation settings only, never dictionaries or text.
+    $ui += [ordered]@{file=$name;settings=@([IO.File]::ReadAllLines($path) | Where-Object {
+      $_ -match '^\s+(?:style/)?(?:inline_preedit|preedit_type|color_scheme|color_scheme_dark):'
+    })}
+  }
+}
+$workaroundBackup = $null
+$backupFile = Join-Path $env:LOCALAPPDATA 'WeaselRewriteUI\OptionalIMEFix\touch-keyboard-state.json'
+if (Test-Path -LiteralPath $backupFile) {
+  try { $workaroundBackup = ([IO.File]::ReadAllText($backupFile) | ConvertFrom-Json).original }
+  catch { $notes.Add('Optional workaround backup unreadable.') }
+}
+$report = [ordered]@{schema=1;collectedAt=[DateTimeOffset]::Now.ToString('o');
+  os=$os;touchKeyboard=$touch;components=$components;hotfixes=$updates;languages=$languages;
+  applications=$apps;weaselSettings=$ui;workaroundOriginalState=$workaroundBackup;notes=@($notes)}
+New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
+$file = Join-Path $OutputDirectory ('IME-Diagnostics-'+[DateTime]::Now.ToString('yyyyMMdd-HHmmss')+'.json')
+[IO.File]::WriteAllText($file,($report | ConvertTo-Json -Depth 10),(New-Object Text.UTF8Encoding($false)))
+Write-Host ('SUCCESS: '+$file)
+Write-Host 'Read-only report; no registry/configuration changes or process restarts.'
+Write-Host 'Run the same script on the other PC and compare the two JSON reports.'
