+﻿$ErrorActionPreference = 'Stop'
+$repo = Split-Path $PSScriptRoot -Parent
+$helper = Join-Path $repo 'output/RewriteConfig.exe'
+$theme = Join-Path $repo 'rime/skins/azure_pill.yaml'
+$root = Join-Path ([IO.Path]::GetTempPath()) ('azure-skin-test-' + [guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $root -Force | Out-Null
+[IO.File]::WriteAllText((Join-Path $root 'weasel.custom.yaml'), @'
+patch:
+  style:
+    font_point: 30
+    future_option: 77
+    layout: {type: vertical, margin_x: 42}
+  style/layout: {hilited_corner_radius: 0, unrelated: 88}
+  style/color_scheme: old
+  preset_color_schemes:
+    old: {name: old, back_color: 0x000000}
+    azure_pill: {name: previous}
+  app_options: {terminal.exe: {ascii_mode: true}}
+  rewrite_ui/enabled: true
+'@, [Text.UTF8Encoding]::new($false))
+& $helper skin $root $theme (Join-Path $root 'stage')
+if ($LASTEXITCODE) { throw 'Skin merge failed' }
+$merged = [IO.File]::ReadAllText((Join-Path $root 'stage/weasel.custom.yaml'))
+foreach ($key in @('future_option: 77','unrelated: 88','terminal.exe','rewrite_ui/enabled: true','name: old','style/font_point: 12','style/layout/type: horizontal')) {
+  if (!$merged.Contains($key)) { throw "Missing preserved or selected setting: $key" }
+}
+if ($merged -match 'font_point: 30|margin_x: 42|type: vertical|name: previous|hilited_corner_radius: 0') { throw 'Nested style still conflicts' }
+& $helper skin (Join-Path $root 'stage') $theme (Join-Path $root 'second')
+if ($LASTEXITCODE) { throw 'Repeated skin merge failed' }
+if ([IO.File]::ReadAllText((Join-Path $root 'second/weasel.custom.yaml')) -ne $merged) { throw 'Skin merge is not idempotent' }
+Write-Host 'PASS: skin merge preserves unrelated values, removes conflicting nested leaves, and is idempotent.'
