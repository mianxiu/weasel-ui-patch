@@ -28,6 +28,27 @@ class DetachedRewriteLayout : public HorizontalLayout {
   bool ShouldDisplayStatusIcon() const override { return false; }
 };
 
+inline IsToRoundStruct JoinedRewriteCorners(bool editor, bool above,
+                                             int candidateWidth, int editorWidth) {
+  IsToRoundStruct corners;
+  if (editor) {
+    if (above) {
+      corners.IsBottomLeftNeedToRound = false;
+      corners.IsBottomRightNeedToRound = editorWidth > candidateWidth;
+    } else {
+      corners.IsTopLeftNeedToRound = false;
+      corners.IsTopRightNeedToRound = editorWidth > candidateWidth;
+    }
+  } else if (above) {
+    corners.IsTopLeftNeedToRound = false;
+    corners.IsTopRightNeedToRound = editorWidth < candidateWidth;
+  } else {
+    corners.IsBottomLeftNeedToRound = false;
+    corners.IsBottomRightNeedToRound = editorWidth < candidateWidth;
+  }
+  return corners;
+}
+
 struct DetachedRewritePosition { CRect candidate, editor; };
 // Rectangles describe visible surfaces, excluding translucent shadow padding.
 inline DetachedRewritePosition PositionDetachedRewrite(CRect candidate, CSize editor,
