diff --git a/WeaselUI/DetachedRewriteLayout.h b/WeaselUI/DetachedRewriteLayout.h
new file mode 100644
index 0000000..38cf151
--- /dev/null
+++ b/WeaselUI/DetachedRewriteLayout.h
@@ -0,0 +1,57 @@
+#pragma once
+#include "HorizontalLayout.h"
+#include "RewriteLayout.h"
+
+namespace weasel {
+// An independent, single-line edit window. Candidate geometry is untouched.
+class DetachedRewriteLayout : public HorizontalLayout {
+ public:
+  using HorizontalLayout::HorizontalLayout;
+  void DoLayout(CDCHandle, PDWR dwr) override {
+    auto original = _context.rewrite;
+    original.stage = L"armed"; original.index.clear(); original.replacement.clear();
+    const auto measured = MeasureRewrite(*this, original, dwr, true);
+    const int reserve = (int)(90 * dwr->dpiScaleLayout);
+    const int limit = _style.max_width > 0 ? _style.max_width : (int)(1000 * dwr->dpiScaleLayout);
+    const int width = (std::min)(limit, (int)measured.size.cx + reserve + 2 * real_margin_x);
+    const int height = (std::max)(1, (int)measured.size.cy);
+    _preeditRect.SetRect(offsetX + real_margin_x, offsetY + real_margin_y,
+                        offsetX + (std::max)(real_margin_x + 1, width - real_margin_x),
+                        offsetY + real_margin_y + height);
+    _contentSize = CSize(width + 2 * offsetX, height + 2 * (offsetY + real_margin_y));
+    _contentRect.SetRect(offsetX, offsetY, _contentSize.cx - offsetX, _contentSize.cy - offsetY);
+    _auxiliaryRect.SetRectEmpty(); _statusIconRect.SetRectEmpty();
+    _prePageRect.SetRectEmpty(); _nextPageRect.SetRectEmpty();
+  }
+  bool IsInlinePreedit() const override { return false; }
+  bool IsStableRewrite() const override { return true; }
+  bool ShouldDisplayStatusIcon() const override { return false; }
+};
+
+struct DetachedRewritePosition { CRect candidate, editor; };
+// Rectangles describe visible surfaces, excluding translucent shadow padding.
+inline DetachedRewritePosition PositionDetachedRewrite(CRect candidate, CSize editor,
+                                                        CRect caret, CRect work, int gap) {
+  bool above = candidate.bottom <= caret.top ||
+      (candidate.top < caret.top && candidate.CenterPoint().y < caret.CenterPoint().y);
+  const int combined = candidate.Height() + editor.cy + gap * 2;
+  if (above && candidate.top - gap - editor.cy < work.top &&
+      work.bottom - caret.bottom >= combined) {
+    candidate.OffsetRect(0, caret.bottom + gap - candidate.top);
+    above = false;
+  } else if (!above && candidate.bottom + gap + editor.cy > work.bottom &&
+             caret.top - work.top >= combined) {
+    candidate.OffsetRect(0, caret.top - gap - candidate.bottom);
+    above = true;
+  }
+  const int top = above ? candidate.top - gap - editor.cy : candidate.bottom + gap;
+  CRect edit(candidate.left, top, candidate.left + editor.cx, top + editor.cy);
+  CRect group; group.UnionRect(candidate, edit);
+  const int dx = group.right > work.right ? work.right - group.right :
+                 group.left < work.left ? work.left - group.left : 0;
+  const int dy = group.top < work.top ? work.top - group.top :
+                 group.bottom > work.bottom ? work.bottom - group.bottom : 0;
+  candidate.OffsetRect(dx, dy); edit.OffsetRect(dx, dy);
+  return {candidate, edit};
+}
+}  // namespace weasel
