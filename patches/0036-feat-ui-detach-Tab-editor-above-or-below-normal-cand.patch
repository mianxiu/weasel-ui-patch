+      host.ctx() = editing;
+      panel.Refresh(); panel.MoveTo(CRect(200, 200, 201, 224));
+      CRect actual; panel.GetWindowRect(&actual);
+      assert(actual.Size() == before.Size());
+      assert(panel.RewriteWindow() != nullptr);
+      CRect editRect; GetWindowRect(panel.RewriteWindow(), &editRect);
+      assert(editRect.left == actual.left);
+      assert(editRect.top > actual.top);
+      assert(actual.top == before.top && actual.left == before.left);
+      if (locked.IsRectEmpty()) locked = actual;
+      assert(actual == locked);
+    }
+    host.ctx() = normal; panel.Refresh(); panel.MoveTo(CRect(200, 200, 201, 224));
+    CRect after; panel.GetWindowRect(&after);
+    assert(after.Size() == before.Size());
+    assert(!IsWindowVisible(panel.RewriteWindow()));
+    // Force normal placement above a caret near the bottom of the work area.
+    MONITORINFO monitor = {sizeof(MONITORINFO)};
+    GetMonitorInfo(MonitorFromWindow(panel.m_hWnd, MONITOR_DEFAULTTONEAREST), &monitor);
+    CRect bottomCaret(200, monitor.rcWork.bottom - 25, 201, monitor.rcWork.bottom - 5);
+    panel.MoveTo(bottomCaret);
+    auto editing = indexed; editing.cinfo = normal.cinfo;
+    host.ctx() = editing; panel.Refresh(); panel.MoveTo(bottomCaret);
+    CRect candidateAbove, editAbove;
+    panel.GetWindowRect(&candidateAbove); GetWindowRect(panel.RewriteWindow(), &editAbove);
+    assert(candidateAbove.top < bottomCaret.top);
+    assert(editAbove.top < candidateAbove.top);
+    assert(editAbove.left == candidateAbove.left);
+    panel.ShowWindow(SW_SHOWNA);
+    assert(IsWindowVisible(panel.RewriteWindow()));
+    auto empty = editing; empty.cinfo.clear(); empty.preedit.clear();
+    host.ctx() = empty; panel.Refresh();
+    assert(IsWindowVisible(panel.RewriteWindow()));
+    panel.ShowWindow(SW_HIDE);
+    assert(!IsWindowVisible(panel.RewriteWindow()));
+    panel.DestroyWindow();
+  }
+  std::cout << "IPC, property-only UI update, exit, layout and DPI tests passed\n";
+  _Module.Term();
+  CoUninitialize();
+}
