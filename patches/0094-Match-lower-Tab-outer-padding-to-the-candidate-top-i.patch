 2026-10-03：inline_preedit 开启和关闭时，Tab 共用字号、预留行高、上下 padding 和候选间距；普通非行内编码的布局保持原样。
 
 2026-10-03：补齐 Tab 在主候选下方时的圆角连接。仅连接紧邻候选且横向重叠的音节高亮，不改变字号、padding、文字位置和窗口高度。
+
+2026-10-03：Tab 行位于主候选下方时，底部外框留白与顶部主候选高亮的外框留白对齐；收紧框高，保持文字位置、字号和连接圆角。移动到屏幕底部切回上方排列时恢复原框高，不重新测量文本。
diff --git a/WeaselUI/StandardLayout.cpp b/WeaselUI/StandardLayout.cpp
index 8695007..0383fbe 100644
--- a/WeaselUI/StandardLayout.cpp
+++ b/WeaselUI/StandardLayout.cpp
@@ -437,6 +437,22 @@ bool StandardLayout::ArrangeRewriteRow(bool below) {
   }
   _highlightRect.OffsetRect(0, candidateDelta);
   if (!_statusIconRect.IsRectEmpty()) _statusIconRect.OffsetRect(0, textDelta);
+  // Below-row layout should have the same outer inset as the main highlight.
+  // Trim the body instead of moving text or increasing the connecting neck.
+  if (_style.layout_type == UIStyle::LAYOUT_HORIZONTAL) {
+    if (below) {
+      const int topInset = (std::max)(0, (int)_candidateRects[0].top -
+          _style.hilite_padding_y - (int)_contentRect.top);
+      const int bottomInset = (int)_contentRect.bottom - (int)_preeditRect.bottom -
+          _style.hilite_padding_y / 2;
+      const int available = (std::max)(0, (int)_contentRect.Height() - _style.min_height);
+      _rewriteBottomTrim = (std::min)(available, (std::max)(0, bottomInset - topInset));
+    }
+    const int trim = below ? -_rewriteBottomTrim : _rewriteBottomTrim;
+    _contentSize.cy += trim;
+    _contentRect.bottom += trim;
+    _bgRect.bottom += trim;
+  }
   // The shared body keeps its full corner radii; all highlights stay inset.
   _rewriteBelow = below;
   return true;
diff --git a/WeaselUI/StandardLayout.h b/WeaselUI/StandardLayout.h
