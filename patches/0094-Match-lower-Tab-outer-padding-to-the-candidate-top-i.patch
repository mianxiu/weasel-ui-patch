--- a/WeaselUI/StandardLayout.h
+++ b/WeaselUI/StandardLayout.h
@@ -70,7 +70,7 @@ class StandardLayout : public Layout {
   void UpdateStatusIconLayout(int* width, int* height);
 
   bool _rewriteBelow = false;
-  int _rewriteCandidateShift = 0, _rewriteTextShift = 0;
+  int _rewriteCandidateShift = 0, _rewriteTextShift = 0, _rewriteBottomTrim = 0;
   CSize _beforesz, _hilitedsz, _aftersz;
   weasel::TextRange _range;
   CSize _contentSize;
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index f4d8d7f..2dffcf9 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -1702,6 +1702,9 @@ void WeaselPanel::_RepositionWindow(const bool& adj, bool repaintRow) {
   if (y < rcWorkArea.top)
     y = rcWorkArea.top;  // over workarea top
   const bool rowChanged = m_layout->ArrangeRewriteRow(!m_sticky);
+  const int arrangedHeight = m_layout->GetContentSize().cy;
+  if (m_sticky) y += height - arrangedHeight;
+  height = arrangedHeight;
   if (m_ctx.rewrite.active()) m_istorepos = false;
   // memorize adjusted position (to avoid window bouncing on height change)
   m_inputPos.bottom = y;
