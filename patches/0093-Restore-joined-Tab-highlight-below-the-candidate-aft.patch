diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index bec5aef..ed1d96d 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -344,6 +344,39 @@ int main() {
           assert(enabled->GetPreeditRect() == disabled->GetPreeditRect());
           assert(enabled->GetContentSize() == disabled->GetContentSize());
           assert(enabled->GetCandidateRect(0) == disabled->GetCandidateRect(0));
+          if (mode == 1 && !multiline) {
+            // Reproduce the second-syllable highlight below the first candidate.
+            auto joinedTab = compareTab; joinedTab.rewrite.index = L"2";
+            joinedTab.cinfo.candies[0].str = L"功能以下这个";
+            weasel::HorizontalLayout joinedLayout(inlineStyle, joinedTab, status, inlineDwr);
+            joinedLayout.DoLayout(dc, inlineDwr);
+            Gdiplus::GdiplusStartupInput startup; ULONG_PTR token;
+            assert(Gdiplus::GdiplusStartup(&token, &startup, nullptr) == Gdiplus::Ok);
+            const auto originalSize = joinedLayout.GetContentSize();
+            for (bool below : {false, true}) {
+              joinedLayout.ArrangeRewriteRow(below);
+              const auto row = weasel::MeasureRewrite(joinedLayout, joinedTab.rewrite, inlineDwr);
+              const auto active = std::find_if(row.cells.begin(), row.cells.end(),
+                  [](const weasel::RewriteCell& cell) { return cell.unit.active && !cell.unit.badge; });
+              assert(active != row.cells.end());
+              auto fill = active->back;
+              const auto preedit = joinedLayout.GetPreeditRect();
+              fill.OffsetRect(preedit.left, preedit.top);
+              fill.InflateRect((int)(4 * inlineDwr->dpiScaleLayout),
+                               (int)((inlineStyle.hilite_padding_y / 2) * inlineDwr->dpiScaleLayout));
+              auto candidate = joinedLayout.GetHighlightRect();
+              candidate.InflateRect(joinedLayout._style.hilite_padding_x, joinedLayout._style.hilite_padding_y);
+              weasel::ExtendAdjacentRewriteHighlight(fill, candidate, !below, true);
+              Gdiplus::GraphicsPath path;
+              assert(weasel::BuildJoinedRewriteHighlight(path, candidate, fill, 13, 6, 4));
+              assert(joinedLayout.GetContentSize() == originalSize);
+              auto separate = fill; separate.OffsetRect(candidate.Width() * 2, 0);
+              const auto saved = separate;
+              weasel::ExtendAdjacentRewriteHighlight(separate, candidate, !below, true);
+              assert(separate == saved);
+            }
+          }
+
         }
         const auto before = tabLayout->GetPreeditRect();
         assert(!tabLayout->ArrangeRewriteRow(true));
