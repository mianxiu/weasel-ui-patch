diff --git a/WeaselUI/JoinedRewritePath.h b/WeaselUI/JoinedRewritePath.h
index 284f934..c013a2a 100644
--- a/WeaselUI/JoinedRewritePath.h
+++ b/WeaselUI/JoinedRewritePath.h
@@ -4,6 +4,14 @@
 #include <gdiplus.h>
 
 namespace weasel {
+// Bridge only the row adjacent to the candidate, keeping distant fills separate.
+inline void ExtendAdjacentRewriteHighlight(CRect& syllable, const CRect& candidate,
+                                          bool above, bool adjacent) {
+  if (!adjacent || syllable.left >= candidate.right || syllable.right <= candidate.left) return;
+  if (above) syllable.bottom = (std::max)(syllable.bottom, candidate.top + 1);
+  else syllable.top = (std::min)(syllable.top, candidate.bottom - 1);
+}
+
 // Trace the union first, then round both convex outer and concave neck corners.
 // Both layered windows draw this same path in their own coordinate systems.
 inline void BuildJoinedRewritePath(Gdiplus::GraphicsPath& path, CRect body, CRect tag,
