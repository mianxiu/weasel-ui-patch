diff --git a/WeaselUI/RewriteLayout.h b/WeaselUI/RewriteLayout.h
index 9d222c5..21fc03f 100644
--- a/WeaselUI/RewriteLayout.h
+++ b/WeaselUI/RewriteLayout.h
@@ -22,12 +22,17 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
   const int gap = margin * 2;
   const int limit = vertical ? style.max_height : style.max_width;
   int advance = 0, cross = 0, line = 0;
-  for (const auto& unit : state.Units()) {
+  const auto units = state.Units();
+  const auto hiddenNumber = [](const std::wstring& label) {
+    return label == L"1" || label == L"2" || label == L"3" || label == L"4";
+  };
+  for (size_t unitIndex = 0; unitIndex < units.size(); ++unitIndex) {
+    const auto& unit = units[unitIndex];
     CSize text(0, 0), label(0, 0);
     layout.GetTextSizeDW(unit.text, unit.text.size(), dwr->pRewriteTextFormat,
                         dwr, &text);
     std::wstring number;
-    if (!unit.label.empty() && unit.label != L"1" && unit.label != L"2" && unit.label != L"3") {
+    if (!unit.label.empty() && !hiddenNumber(unit.label)) {
       wchar_t formatted[128];
       swprintf_s(formatted, style.label_text_format.c_str(), unit.label.c_str());
       number = formatted;
@@ -56,7 +61,18 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     result.cells.push_back({shown, CRect(x, y, x + w, y + h), tr, lb, lr});
     result.size.cx = (std::max<LONG>)(result.size.cx, x + w);
     result.size.cy = (std::max<LONG>)(result.size.cy, y + h);
-    advance += span + gap; line = (std::max)(line, vertical ? w : h);
+    int hiddenMargin = 0;
+    if (unitIndex + 1 < units.size() && hiddenNumber(units[unitIndex + 1].label)) {
+      // Reserve the next hidden prefix in the inter-syllable margin, keeping
+      // the first pronunciation aligned with the candidate text.
+      wchar_t formatted[128];
+      swprintf_s(formatted, style.label_text_format.c_str(), units[unitIndex + 1].label.c_str());
+      CSize reserved(0, 0);
+      layout.GetTextSizeDW(formatted, wcslen(formatted), dwr->pRewriteLabelTextFormat, dwr, &reserved);
+      hiddenMargin = vertical ? reserved.cy + margin : reserved.cx + px * 2 + margin;
+    }
+    advance += span + gap + hiddenMargin;
+    line = (std::max)(line, vertical ? w : h);
   }
   return result;
 }
