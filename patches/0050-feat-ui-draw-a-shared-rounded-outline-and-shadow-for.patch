diff --git a/WeaselUI/JoinedRewritePath.h b/WeaselUI/JoinedRewritePath.h
new file mode 100644
index 0000000..289f268
--- /dev/null
+++ b/WeaselUI/JoinedRewritePath.h
@@ -0,0 +1,77 @@
+#pragma once
+#include <algorithm>
+#include <vector>
+#include <gdiplus.h>
+
+namespace weasel {
+// Trace the union first, then round both convex outer and concave neck corners.
+// Both layered windows draw this same path in their own coordinate systems.
+inline void BuildJoinedRewritePath(Gdiplus::GraphicsPath& path, CRect body, CRect tag,
+                                   float bodyRadius, float tagRadius, float neckRadius) {
+  std::vector<int> xs{body.left, body.right, tag.left, tag.right};
+  std::vector<int> ys{body.top, body.bottom, tag.top, tag.bottom};
+  for (auto* values : {&xs, &ys}) {
+    std::sort(values->begin(), values->end());
+    values->erase(std::unique(values->begin(), values->end()), values->end());
+  }
+  const auto filled = [&](int x, int y) {
+    if (x < 0 || y < 0 || x + 1 >= (int)xs.size() || y + 1 >= (int)ys.size()) return false;
+    const double cx = (xs[x] + xs[x + 1]) / 2.0, cy = (ys[y] + ys[y + 1]) / 2.0;
+    const auto contains = [&](CRect rect) {
+      return cx >= rect.left && cx < rect.right && cy >= rect.top && cy < rect.bottom;
+    };
+    return contains(body) || contains(tag);
+  };
+  std::vector<std::pair<CPoint, CPoint>> edges;
+  for (int y = 0; y + 1 < (int)ys.size(); ++y)
+    for (int x = 0; x + 1 < (int)xs.size(); ++x) {
+      if (!filled(x, y)) continue;
+      const int l = xs[x], r = xs[x + 1], t = ys[y], b = ys[y + 1];
+      if (!filled(x, y - 1)) edges.push_back({{l, t}, {r, t}});
+      if (!filled(x + 1, y)) edges.push_back({{r, t}, {r, b}});
+      if (!filled(x, y + 1)) edges.push_back({{r, b}, {l, b}});
+      if (!filled(x - 1, y)) edges.push_back({{l, b}, {l, t}});
+    }
+  if (edges.empty()) return;
+  std::vector<CPoint> points;
+  const CPoint first = edges.front().first;
+  CPoint point = first;
+  do {
+    points.push_back(point);
+    const auto next = std::find_if(edges.begin(), edges.end(), [&](const auto& edge) { return edge.first == point; });
+    if (next == edges.end()) return;
+    point = next->second; edges.erase(next);
+  } while (point != first);
+  std::vector<CPoint> corners;
+  for (size_t i = 0; i < points.size(); ++i) {
+    const auto previous = points[(i + points.size() - 1) % points.size()];
+    const auto current = points[i], next = points[(i + 1) % points.size()];
+    if ((current.x - previous.x) * (next.y - current.y) !=
+        (current.y - previous.y) * (next.x - current.x)) corners.push_back(current);
+  }
+  const auto isCorner = [](CPoint p, CRect r) {
+    return (p.x == r.left || p.x == r.right) && (p.y == r.top || p.y == r.bottom);
+  };
+  Gdiplus::PointF last, firstPoint;
+  constexpr float kappa = 0.55228475f;
+  path.SetFillMode(Gdiplus::FillModeWinding);
+  for (size_t i = 0; i < corners.size(); ++i) {
+    const auto p = corners[(i + corners.size() - 1) % corners.size()];
+    const auto c = corners[i], n = corners[(i + 1) % corners.size()];
+    const float incoming = (float)(abs(c.x - p.x) + abs(c.y - p.y));
+    const float outgoing = (float)(abs(n.x - c.x) + abs(n.y - c.y));
+    const float radius = (std::max)(0.f, (std::min)(isCorner(c, body) ? bodyRadius :
+        isCorner(c, tag) ? tagRadius : neckRadius, (std::min)(incoming, outgoing) / 2));
+    const Gdiplus::PointF u((c.x - p.x) / incoming, (c.y - p.y) / incoming);
+    const Gdiplus::PointF v((n.x - c.x) / outgoing, (n.y - c.y) / outgoing);
+    const Gdiplus::PointF start(c.x - u.X * radius, c.y - u.Y * radius);
+    const Gdiplus::PointF end(c.x + v.X * radius, c.y + v.Y * radius);
+    if (i) path.AddLine(last, start); else firstPoint = start;
+    path.AddBezier(start, {start.X + u.X * radius * kappa, start.Y + u.Y * radius * kappa},
+        {end.X - v.X * radius * kappa, end.Y - v.Y * radius * kappa}, end);
+    last = end;
+  }
+  path.AddLine(last, firstPoint);
+  path.CloseFigure();
+}
+}  // namespace weasel
