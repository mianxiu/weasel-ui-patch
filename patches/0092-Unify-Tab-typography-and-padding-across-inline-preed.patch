+++ b/WeaselUI/VerticalLayout.cpp
@@ -48,10 +48,11 @@ void weasel::VerticalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
   CSize size;
   /* Preedit */
   if (!IsInlinePreedit() && _context.HasPanelPreedit()) {
-    if (!_configuredInlinePreedit) height -= real_margin_y / 2;
+    const bool compactPreedit = !_configuredInlinePreedit || _context.rewrite.active();
+    if (compactPreedit) height -= real_margin_y / 2;
     size = GetPreeditSize(dc, _context.preedit, pDWR->pPreeditTextFormat, pDWR);
     int szx = pgw, szy = max(size.cy, pgh);
-    if (!_configuredInlinePreedit) {
+    if (compactPreedit) {
       // Reserve the same single-line slot for ordinary code and Tab syllables.
       // Multi-line Tab text can still grow naturally within the candidate width.
       CSize codeLine, tabLine;
@@ -66,7 +67,7 @@ void weasel::VerticalLayout::DoLayout(CDCHandle dc, PDWR pDWR) {
                       : 0;
     _preeditRect.SetRect(real_margin_x, height + yoffset + (szy - size.cy) / 2,
                          real_margin_x + size.cx, height + yoffset + (szy - size.cy) / 2 + size.cy);
-    const int preeditGap = _configuredInlinePreedit ? _style.spacing : _style.spacing / 2;
+    const int preeditGap = compactPreedit ? _style.spacing / 2 : _style.spacing;
     height += szy + 2 * yoffset + preeditGap;
     width = max(width, real_margin_x * 2 + size.cx + szx);
     if (ShouldDisplayStatusIcon())
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 6d5e86f..d332011 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -930,11 +930,10 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
           candidate = m_layout->GetHighlightRect();
           candidate.InflateRect(DPI_SCALE(m_style.hilite_padding_x),
                                 DPI_SCALE(m_style.hilite_padding_y));
-          // Non-inline mode reserves a centered preedit slot for stable height.
+          // Both inline modes reserve the same centered Tab slot.
           // Carry only the last syllable row's fill through its bottom padding;
           // the shared path still requires horizontal overlap with the candidate.
-          if (!m_style.inline_preedit &&
-              m_style.layout_type == UIStyle::LAYOUT_HORIZONTAL &&
+          if (m_style.layout_type == UIStyle::LAYOUT_HORIZONTAL &&
               rc.bottom <= m_layout->GetCandidateTextRect(0).top &&
               cell.back.bottom == layout.size.cy &&
               back.left < candidate.right && back.right > candidate.left &&
diff --git a/rewrite-build.txt b/rewrite-build.txt
index 31012d0..8897f10 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-yaml-inline-underline-20261002
+Build-ID: rewrite-ui-unified-tab-spacing-20261003
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: integrated Tab preedit row with ordinary prefix numbers; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index 8087028..bec5aef 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -312,6 +312,39 @@ int main() {
         assert(normalLayout->GetPreeditRect().top < candidateLayout->GetCandidateTextRect(0).top);
         assert(normalLayout->GetContentSize().cy == tabLayout->GetContentSize().cy);
         assert(normalLayout->GetCandidateRect(0).top == tabLayout->GetCandidateRect(0).top);
+        // Inline composition affects placement, never Tab font or padding.
+        auto inlineStyle = fixedStyle; inlineStyle.inline_preedit = true;
+        auto inlineDwr = std::make_shared<weasel::DirectWriteResources>(inlineStyle, dpi);
+        assert(inlineDwr->pRewriteTextFormat->GetFontSize() ==
+               fixedDwr->pRewriteTextFormat->GetFontSize());
+        assert(inlineDwr->pRewriteBadgeTextFormat->GetFontSize() ==
+               fixedDwr->pRewriteBadgeTextFormat->GetFontSize());
+        for (bool multiline : {false, true}) {
+          auto compareTab = tab;
+          if (multiline) {
+            compareTab.rewrite.original.clear(); compareTab.rewrite.ranges.clear();
+            compareTab.rewrite.pinyin.clear();
+            for (int i = 0; i < 32; ++i) {
+              compareTab.rewrite.original += L"ce";
+              if (i) { compareTab.rewrite.ranges += L","; compareTab.rewrite.pinyin += L"|"; }
+              compareTab.rewrite.ranges += std::to_wstring(i*2) + L"-" + std::to_wstring(i*2+2);
+              compareTab.rewrite.pinyin += L"cháng";
+            }
+            compareTab.rewrite.input = compareTab.rewrite.original;
+          }
+          std::unique_ptr<weasel::Layout> enabled, disabled;
+          if (mode == 0) {
+            enabled.reset(new weasel::VerticalLayout(inlineStyle, compareTab, status, inlineDwr));
+            disabled.reset(new weasel::VerticalLayout(fixedStyle, compareTab, status, fixedDwr));
+          } else {
+            enabled.reset(new weasel::HorizontalLayout(inlineStyle, compareTab, status, inlineDwr));
+            disabled.reset(new weasel::HorizontalLayout(fixedStyle, compareTab, status, fixedDwr));
+          }
+          enabled->DoLayout(dc, inlineDwr); disabled->DoLayout(dc, fixedDwr);
+          assert(enabled->GetPreeditRect() == disabled->GetPreeditRect());
+          assert(enabled->GetContentSize() == disabled->GetContentSize());
+          assert(enabled->GetCandidateRect(0) == disabled->GetCandidateRect(0));
+        }
         const auto before = tabLayout->GetPreeditRect();
         assert(!tabLayout->ArrangeRewriteRow(true));
         assert(tabLayout->GetPreeditRect() == before);
