From: mianxiu <mianxiu8481@gmail.com>
Date: Wed, 30 Sep 2026 22:40:53 +0800
Subject: [PATCH 37/43] fix(installer): ignore exited processes when checking
 shutdown identity

---
 Install-Binaries.ps1         | 30 ++++++------
 test/patch_shutdown_test.ps1 | 89 +++++++++++++++++++++---------------
 2 files changed, 67 insertions(+), 52 deletions(-)

diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index f42eec9..ba8924a 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -47,6 +47,18 @@ function Register-Weasel([string]$Root, [string]$ProfileArgument) {
   if ($process.ExitCode -ne 0) { throw "WeaselSetup failed: $($process.ExitCode)" }
 }
 
+function Get-VerifiedWeaselProcesses([string]$ServerPath) {
+  foreach ($server in @(Get-Process WeaselServer -ErrorAction SilentlyContinue)) {
+    if ($server.HasExited) { continue }
+    $processPath = $server.Path
+    # /q cleanup can complete between enumeration and reading Path.
+    if ($server.HasExited) { continue }
+    if (!$processPath -or $processPath -ine $ServerPath) {
+      throw "A different or inaccessible live Weasel process is running (PID $($server.Id), path: '$processPath'). No binaries were replaced."
+    }
+    $server
+  }
+}
 function Stop-WeaselForPatch([string]$ServerPath) {
   Write-Host 'Stopping Weasel (up to 10 seconds)...'
   # Start-Process -Wait can wait for descendants, not just the /q helper.
@@ -56,12 +68,7 @@ function Stop-WeaselForPatch([string]$ServerPath) {
     $helper.Kill()
     if (!$helper.WaitForExit(5000)) { throw 'Shutdown helper could not be stopped. No binaries were replaced.' }
   }
-  $remaining = @(Get-Process WeaselServer -ErrorAction SilentlyContinue)
-  foreach ($server in $remaining) {
-    if (!$server.Path -or $server.Path -ine $ServerPath) {
-      throw 'A different or inaccessible Weasel process is running. No binaries were replaced.'
-    }
-  }
+  $remaining = @(Get-VerifiedWeaselProcesses $ServerPath)
   # The /q helper can exit before the original server finishes cleanup.
   $shutdownClock = [Diagnostics.Stopwatch]::StartNew()
   foreach ($server in $remaining) {
@@ -78,7 +85,7 @@ function Stop-WeaselForPatch([string]$ServerPath) {
       if (!$server.WaitForExit(5000)) { throw 'Weasel could not be stopped. No binaries were replaced.' }
     }
   }
-  if (@(Get-Process WeaselServer -ErrorAction SilentlyContinue).Count) {
+  if (@(Get-VerifiedWeaselProcesses $ServerPath).Count) {
     throw 'Weasel restarted. Close applications using the input method, then retry. No binaries were replaced.'
   }
   Write-Host 'Weasel stopped.'
@@ -138,7 +145,7 @@ try {
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
   Write-Host "Build: rewrite-ui-detached-editor-20260930; profile: $profileName"
-  Write-Host 'Program installer: revision 5 (persistent administrator diagnostics)'
+  Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
 
@@ -150,12 +157,7 @@ try {
   # Refuse a mixed installation instead of terminating unrelated applications.
   $operationStage = 'checking running processes'
   $serverPath = Join-Path $Target 'WeaselServer.exe'
-  $servers = @(Get-Process WeaselServer -ErrorAction SilentlyContinue)
-  foreach ($server in $servers) {
-    if (!$server.Path -or $server.Path -ine $serverPath) {
-      throw 'Another Weasel installation is running. Exit it before applying this patch.'
-    }
-  }
+  $servers = @(Get-VerifiedWeaselProcesses $serverPath)
   if (!$BackupName) { throw 'BackupName is required.' }
   if ($Restore) {
     $operationStage = 'restoring program backup'
diff --git a/test/patch_shutdown_test.ps1 b/test/patch_shutdown_test.ps1
index e22c768..723a395 100644
--- a/test/patch_shutdown_test.ps1
+++ b/test/patch_shutdown_test.ps1
@@ -1,38 +1,51 @@
-$ErrorActionPreference = 'Stop'
-$tokens = $null; $errors = $null
-$ast = [Management.Automation.Language.Parser]::ParseFile(
-  (Join-Path $PSScriptRoot '../Install-Binaries.ps1'), [ref]$tokens, [ref]$errors)
-if ($errors.Count) { throw ($errors | Out-String) }
-$function = $ast.Find({param($node) $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq 'Stop-WeaselForPatch'}, $true)
-Invoke-Expression $function.Extent.Text
-function New-FakeProcess([string]$Path, [bool]$Hung) {
-  $p = [pscustomobject]@{Path=$Path; Hung=$Hung; HasExited=$false; Killed=$false}
-  $p | Add-Member ScriptMethod WaitForExit {param($milliseconds) if ($milliseconds -gt 10000) { throw 'Unbounded wait' }; if (!$this.Hung) { $this.HasExited=$true }; return $this.HasExited}
-  $p | Add-Member ScriptMethod Kill {$this.Killed=$true; $this.HasExited=$true}
-  return $p
-}
-function Start-WeaselCommand {
-  param($FilePath,$Argument)
-  if ($Argument -cne '/q') { throw 'Incorrect shutdown argument' }
-  return $script:helper
-}
-function Get-Process {param($Name,$ErrorAction) $script:remaining | Where-Object { !$_.HasExited }}
-function Read-Host {param($Prompt) if ($script:case -eq 'delayed-exit') { throw 'Prompted before service finished cleanup' }; return $script:answer}
-$path = 'C:\test\WeaselServer.exe'
-foreach ($case in @('normal','delayed-exit','hung-helper','refuse','force','foreign')) {
-  $script:helper = New-FakeProcess $path ($case -eq 'hung-helper')
-  $script:remaining = @()
-  $script:answer = 'NO'
-  if ($case -in @('refuse','force','foreign')) {
-    $script:remaining = @(New-FakeProcess $(if ($case -eq 'foreign') {'C:\other\WeaselServer.exe'} else {$path}) $true)
-  }
-  if ($case -eq 'delayed-exit') { $script:remaining = @(New-FakeProcess $path $false) }
-  if ($case -eq 'force') { $script:answer = ' yes ' }
