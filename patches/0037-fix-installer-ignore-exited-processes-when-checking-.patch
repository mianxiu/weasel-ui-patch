-}
+﻿$ErrorActionPreference = 'Stop'
+$tokens = $null; $errors = $null
+$ast = [Management.Automation.Language.Parser]::ParseFile(
+  (Join-Path $PSScriptRoot '../Install-Binaries.ps1'), [ref]$tokens, [ref]$errors)
+if ($errors.Count) { throw ($errors | Out-String) }
+foreach ($name in @('Get-VerifiedWeaselProcesses','Stop-WeaselForPatch')) {
+  $function = $ast.Find({param($node) $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq $name}, $true)
+  Invoke-Expression $function.Extent.Text
+}
+function New-FakeProcess([string]$Path, [bool]$Hung) {
+  $p = [pscustomobject]@{Id=100; Path=$Path; Hung=$Hung; HasExited=$false; Killed=$false}
+  $p | Add-Member ScriptMethod WaitForExit {param($milliseconds) if ($milliseconds -gt 10000) { throw 'Unbounded wait' }; if (!$this.Hung) { $this.HasExited=$true }; return $this.HasExited}
+  $p | Add-Member ScriptMethod Kill {$this.Killed=$true; $this.HasExited=$true}
+  return $p
+}
+function Start-WeaselCommand {
+  param($FilePath,$Argument)
+  if ($Argument -cne '/q') { throw 'Incorrect shutdown argument' }
+  return $script:helper
+}
+function Get-Process {param($Name,$ErrorAction) $script:remaining}
+function Read-Host {param($Prompt) if ($script:case -eq 'delayed-exit') { throw 'Prompted before service finished cleanup' }; return $script:answer}
+$path = 'C:\test\WeaselServer.exe'
+foreach ($case in @('normal','delayed-exit','hung-helper','refuse','force','foreign','exited-null-path','exit-during-path-read','live-null-path')) {
+  $script:helper = New-FakeProcess $path ($case -eq 'hung-helper')
+  $script:remaining = @()
+  $script:answer = 'NO'
+  if ($case -in @('refuse','force','foreign','exited-null-path','exit-during-path-read','live-null-path')) {
+    $script:remaining = @(New-FakeProcess $(if ($case -eq 'foreign') {'C:\other\WeaselServer.exe'} else {$path}) $true)
+  }
+  if ($case -eq 'delayed-exit') { $script:remaining = @(New-FakeProcess $path $false) }
+  if ($case -eq 'force') { $script:answer = ' yes ' }
+  if ($case -eq 'exited-null-path') {
+    $script:remaining = @(New-FakeProcess '' $false)
+    $script:remaining[0].HasExited = $true
+  }
+  if ($case -eq 'exit-during-path-read') {
+    $p = New-FakeProcess $path $false
+    $p.PSObject.Properties.Remove('Path')
+    $p | Add-Member ScriptProperty Path { $this.HasExited = $true; return $null }
+    $script:remaining = @($p)
+  }
+  if ($case -eq 'live-null-path') { $script:remaining = @(New-FakeProcess '' $true) }
+  $failed = $false
+  try { Stop-WeaselForPatch $path } catch { $failed = $true }
+  if ($failed -ne ($case -in @('refuse','foreign','live-null-path'))) { throw "Unexpected result: $case" }
+  if ($case -eq 'hung-helper' -and !$script:helper.Killed) { throw 'Hung helper not cleaned up' }
+  if ($case -eq 'force' -and !$script:remaining[0].Killed) { throw 'Confirmed process not stopped' }
+  if ($case -in @('refuse','foreign','live-null-path') -and $script:remaining[0].Killed) { throw 'Unapproved process stopped' }
+  Write-Host "PASS: $case"
+}
