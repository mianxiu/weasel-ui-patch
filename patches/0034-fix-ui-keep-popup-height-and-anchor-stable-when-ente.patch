@@ -12,7 +12,7 @@ struct RewriteLayout {
 };
 // Keep pronunciation and its superscript badge together when wrapping.
 inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
-                                    PDWR dwr) {
+                                    PDWR dwr, bool unwrapped = false) {
   RewriteLayout result;
   const auto& style = layout._style;
   const bool vertical = style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT;
@@ -34,7 +34,7 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     const int w = vertical ? (std::max<LONG>)(text.cx, lw) : text.cx + (lw ? margin + lw : 0);
     const int h = vertical ? text.cy + (lh ? margin + lh : 0) : (std::max<LONG>)(text.cy, lh);
     const int span = vertical ? h : w;
-    if (limit > 0 && advance > 0 && advance + span > limit) {
+    if (!unwrapped && limit > 0 && advance > 0 && advance + span > limit) {
       cross += line + gap; advance = 0; line = 0;
     }
     const int x = vertical ? cross : advance, y = vertical ? advance : cross;
@@ -53,4 +53,40 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
   }
   return result;
 }
+// Fixed rail with a reserved editing slot, visible even before the first digit.
+// Clip and scroll only presentation rectangles; never truncate Rime input.
+inline RewriteLayout MeasureStableRewrite(Layout& layout, const RewriteState& state,
+                                           PDWR dwr, CSize area,
+                                           CRect& syllables, CRect& editor) {
+  auto result = MeasureRewrite(layout, state, dwr, true);
+  const bool vertical = layout._style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT;
+  const int extent = vertical ? area.cy : area.cx;
+  const int gap = (std::max)(1, (int)(6 * dwr->dpiScaleLayout));
+  const int reserve = (std::max)(1, (std::min)((int)(80 * dwr->dpiScaleLayout), extent / 3));
+  syllables.SetRect(0, 0, area.cx, area.cy);
+  editor = syllables;
+  if (vertical) { syllables.bottom = (std::max)(1, extent - reserve - gap); editor.top = extent - reserve; }
+  else { syllables.right = (std::max)(1, extent - reserve - gap); editor.left = extent - reserve; }
+  int shift = 0;
+  for (const auto& cell : result.cells) if (cell.unit.active && !cell.unit.badge) {
+    const int start = vertical ? cell.back.top : cell.back.left;
+    const int end = vertical ? cell.back.bottom : cell.back.right;
+    const int span = vertical ? syllables.Height() : syllables.Width();
+    if (end > span) shift = (std::max)(0, end - span);
+    if (end - start > span) shift = start;
+  }
+  for (auto& cell : result.cells) {
+    int dx = vertical ? 0 : -shift, dy = vertical ? -shift : 0;
+    if (cell.unit.badge) {
+      dx = editor.left - cell.text.left;
+      dy = editor.top - cell.text.top;
+      if (vertical) dy -= (std::max)(0, cell.text.Height() - editor.Height());
+      else dx -= (std::max)(0, cell.text.Width() - editor.Width());
+    }
+    cell.back.OffsetRect(dx, dy); cell.text.OffsetRect(dx, dy);
+    cell.labelBack.OffsetRect(dx, dy); cell.label.OffsetRect(dx, dy);
+  }
+  result.size = area;
+  return result;
+}
 }  // namespace weasel
diff --git a/WeaselUI/StableRewriteLayout.h b/WeaselUI/StableRewriteLayout.h
new file mode 100644
index 0000000..db10d2e
--- /dev/null
+++ b/WeaselUI/StableRewriteLayout.h
@@ -0,0 +1,115 @@
+#pragma once
+#include "HorizontalLayout.h"
+#include "VerticalLayout.h"
+#include "VHorizontalLayout.h"
+#include <array>
+#include <memory>
+
+namespace weasel {
+// Put the rewrite rail beside the existing candidate area, never above it.
+// The entry size is captured before Tab, including margins and shadow padding.
+class StableRewriteLayout : public Layout {
+ public:
+  StableRewriteLayout(const UIStyle& style, const Context& context,
+                      const Status& status, PDWR dwr, CSize entry,
+                      int workWidth)
+      : Layout(style, context, status, dwr), normal_(context), entry_(entry),
+        workWidth_(workWidth) {
+    normal_.rewrite.clear();
+    normal_.preedit.clear();
+    auto plain = style;
+    plain.inline_preedit = true;
+    // Keep a single horizontal candidate strip; scroll it to the selected item.
+    // Vertical lists retain their original orientation and scroll vertically.
+    plain.max_width = plain.max_height = 0;
+    if (style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT)
+      base_.reset(new VHorizontalLayout(plain, normal_, status, dwr));
+    else if (style.layout_type == UIStyle::LAYOUT_VERTICAL ||
+             style.layout_type == UIStyle::LAYOUT_VERTICAL_FULLSCREEN)
+      base_.reset(new VerticalLayout(plain, normal_, status, dwr));
+    else base_.reset(new HorizontalLayout(plain, normal_, status, dwr));
+  }
+  void DoLayout(CDCHandle dc, PDWR dwr) override {
+    const std::array<ComPtr<IDWriteTextFormat1>, 3> formats = {
+        dwr->pTextFormat, dwr->pLabelTextFormat, dwr->pCommentTextFormat};
+    std::array<DWRITE_WORD_WRAPPING, 3> wraps{};
+    for (size_t i = 0; i < formats.size(); ++i) if (formats[i]) {
+      wraps[i] = formats[i]->GetWordWrapping();
+      formats[i]->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
+    }
+    base_->DoLayout(dc, dwr);
+    for (size_t i = 0; i < formats.size(); ++i) if (formats[i])
+      formats[i]->SetWordWrapping(wraps[i]);
+    auto natural = base_->GetContentSize();
+    const int scaleRail = (std::max)(48, (int)(240 * dwr->dpiScaleLayout));
+    const int gap = (std::max)(_style.hilite_padding_x * 2,
+                              (int)(12 * dwr->dpiScaleLayout));
+    const int oldWidth = entry_.cx > 0 ? entry_.cx : natural.cx;
+    const int oldHeight = entry_.cy > 0 ? entry_.cy : natural.cy;
+    const int limit = workWidth_ > 0 ? workWidth_ : oldWidth + scaleRail + gap;
+    size_ = CSize((std::min)(limit, oldWidth + scaleRail + gap), oldHeight);
+    const int innerWidth = (std::max<LONG>)(2, size_.cx - 2 * (offsetX + real_margin_x));
+    const int rail = (std::min)(scaleRail, (std::max)(1, innerWidth / 2 - gap));
+    const int top = offsetY + real_margin_y;
+    const int bottom = (std::max<LONG>)(top + 1, size_.cy - offsetY - real_margin_y);
+    rail_.SetRect(offsetX + real_margin_x, top,
+                  offsetX + real_margin_x + rail, bottom);
+    viewport_.SetRect(rail_.right + gap, top,
+                      (std::max)(rail_.right + gap + 1, size_.cx - offsetX - real_margin_x), bottom);
+    dx_ = rail + gap; dy_ = 0;
+    mark_width = base_->mark_width;
+    mark_gap = base_->mark_gap;
+    mark_height = base_->mark_height;
+    if (candidates_count > 0 && id >= 0 && id < candidates_count && id < MAX_CANDIDATES_COUNT) {
+      auto selected = base_->GetCandidateRect(id);
+      selected.OffsetRect(dx_, 0);
+      if (selected.Width() > viewport_.Width() || selected.left < viewport_.left)
+        dx_ += viewport_.left - selected.left;
+      else if (selected.right > viewport_.right) dx_ -= selected.right - viewport_.right;
+      if (selected.Height() > viewport_.Height() || selected.top < viewport_.top)
+        dy_ += viewport_.top - selected.top;
+      else if (selected.bottom > viewport_.bottom) dy_ -= selected.bottom - viewport_.bottom;
+    }
+    content_.SetRect(offsetX, offsetY, size_.cx - offsetX, size_.cy - offsetY);
+  }
+  bool IsStableRewrite() const override { return true; }
+  bool IsInlinePreedit() const override { return false; }
+  CSize GetContentSize() const override { return size_; }
+  CRect GetPreeditRect() const override { return rail_; }
+  CRect GetContentRect() override { return content_; }
+  CRect GetCandidateViewport() override { return viewport_; }
+  CRect GetCandidateRect(int i) const override { return clipped(base_->GetCandidateRect(i)); }
+  CRect GetHighlightRect() const override { return clipped(base_->GetHighlightRect()); }
+  CRect GetCandidateLabelRect(int i) const override { return shifted(base_->GetCandidateLabelRect(i)); }
+  CRect GetCandidateTextRect(int i) const override { return shifted(base_->GetCandidateTextRect(i)); }
+  CRect GetCandidateCommentRect(int i) const override { return shifted(base_->GetCandidateCommentRect(i)); }
+  CRect GetAuxiliaryRect() const override { return clipped(base_->GetAuxiliaryRect()); }
+  CRect GetStatusIconRect() const override { return clipped(base_->GetStatusIconRect()); }
+  CRect GetPrepageRect() override { return clipped(base_->GetPrepageRect()); }
+  CRect GetNextpageRect() override { return clipped(base_->GetNextpageRect()); }
+  bool ShouldDisplayStatusIcon() const override { return base_->ShouldDisplayStatusIcon(); }
+  IsToRoundStruct GetRoundInfo(int i) override { return base_->GetRoundInfo(i); }
+  IsToRoundStruct GetTextRoundInfo() override { return base_->GetTextRoundInfo(); }
+  TextRange GetPreeditRange() override { return {}; }
+  CSize GetBeforeSize() override { return {}; }
+  CSize GetHilitedSize() override { return {}; }
+  CSize GetAfterSize() override { return {}; }
+  std::wstring GetLabelText(const std::vector<Text>& labels, int i, const wchar_t* format) const override {
+    return base_->GetLabelText(labels, i, format);
+  }
+  void GetTextSizeDW(const std::wstring& text, size_t count,
+                    ComPtr<IDWriteTextFormat1>& format, PDWR dwr, LPSIZE size) const override {
+    base_->GetTextSizeDW(text, count, format, dwr, size);
+  }
+ private:
+  CRect shifted(CRect rc) const { rc.OffsetRect(dx_, dy_); return rc; }
+  CRect clipped(CRect rc) const {
+    rc = shifted(rc); CRect result; result.IntersectRect(rc, viewport_); return result;
+  }
+  Context normal_;
+  std::unique_ptr<Layout> base_;
+  CSize entry_, size_;
+  int workWidth_, dx_ = 0, dy_ = 0;
+  CRect rail_, viewport_, content_;
+};
+}  // namespace weasel
