From 9455ac9145d60764cfbe6a98b0368c1d092992c1 Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Tue, 29 Sep 2026 23:00:09 +0800
Subject: [PATCH 26/27] docs(installer): explain preflight and post-install
 verification in terminal

---
 Apply-Patch.ps1 | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/Apply-Patch.ps1 b/Apply-Patch.ps1
index 834291f..827c3e0 100644
--- a/Apply-Patch.ps1
+++ b/Apply-Patch.ps1
@@ -1,4 +1,4 @@
-# Only the binary installer is elevated; configuration belongs to the signed-in user.
+﻿# Only the binary installer is elevated; configuration belongs to the signed-in user.
 [CmdletBinding()]
 param([string]$Target, [string]$UserDataRoot, [switch]$CheckOnly)
 $ErrorActionPreference = 'Stop'
@@ -120,6 +120,12 @@ try {
   foreach ($required in @('Install-Binaries.ps1','RewriteConfig.exe','rime\lua\indexed_rewrite_pro.lua','rewrite-build.txt')) {
     if (!$manifest.ContainsKey($required)) { throw "Manifest missing $required" }
   }
+  Write-Host '正在执行安装前预检：下方 CHECK ONLY 属于正常流程，不代表安装失败。'
+  if ($CheckOnly) {
+    Write-Host '本次仅检查，不安装、不提权、不部署。'
+  } else {
+    Write-Host '预检通过后会继续安装；请以最后的 SUCCESS 或 INSTALL FAILED 为准。'
+  }
   & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $package 'Install-Binaries.ps1') -Target $Target -CheckOnly
   if ($LASTEXITCODE -ne 0) { throw 'Program preflight failed.' }
   $backupName = 'rewrite-backup-' + [Guid]::NewGuid().ToString('N')
@@ -180,6 +186,13 @@ try {
   Write-Host 'SUCCESS: program files, Lua and YAML installed; deployment verified; Rewrite UI enabled.' -ForegroundColor Green
   Write-Host 'Sign out and back in (or restart Windows) so applications load the new TSF DLLs.'
   Write-Host "Backups and log: $transaction"
+  Write-Host ''
+  Write-Host '安装成功：程序文件、Lua 和 YAML 已安装，部署校验通过，Rewrite UI 已启用。' -ForegroundColor Green
+  Write-Host '下一步：'
+  Write-Host '  1. 注销后重新登录，或重启 Windows，让应用加载新版输入法 DLL。'
+  Write-Host '  2. 输入拼音后按 Tab，检查音节高亮、数字索引选择，以及 Esc 恢复是否正常。'
+  Write-Host '开头的 CHECK ONLY 只是安装前预检；本次安装已完成。'
+  Write-Host '备份已保留，无需删除。按任意键只关闭此窗口，不会自动重启 Windows。'
   exit 0
 } catch {
   Write-Host "INSTALL FAILED: $_" -ForegroundColor Red
-- 
2.53.0.windows.2

