+  static std::wstring IndexLabel(size_t ordinal) {
+    std::wstring label;
+    while (ordinal) {
+      --ordinal;
+      label.insert(label.begin(), wchar_t(L'1' + ordinal % 6));
+      ordinal /= 6;
+    }
+    return label;
+  }
+  static bool IndexOrdinal(const std::wstring& label, size_t& ordinal) {
+    ordinal = 0;
+    if (label.empty()) return false;
+    for (auto digit : label) {
+      if (digit < L'1' || digit > L'6') return false;
+      ordinal = ordinal * 6 + digit - L'0';
+      if (ordinal > 256) return false;
+    }
+    return true;
+  }
