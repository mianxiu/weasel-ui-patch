 > **2026-10-01 整体圆角轮廓：** 主候选与 Tab 标签使用同一条组合外轮廓描边，连接处为圆弧，内部没有分隔边；两块分区绘制同一形状与阴影，避免接缝重复加深。文字对齐、紧凑 padding 和跨线程跟随保持。
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index 9e9cd11..2f2bdfe 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -197,6 +197,7 @@ void WeaselPanel::_CreateLayout() {
 
 // 更新界面
 void WeaselPanel::Refresh() {
+  const bool wasRewrite = m_ctx.rewrite.active();
   m_ctx = m_sourceCtx;
   if (!m_editOnly && IsWindow()) {
     ::PostMessage(m_hWnd, POSITION_SETUP, 0, 0);
@@ -240,11 +241,14 @@ void WeaselPanel::Refresh() {
     m_layout->DoLayout(dc, pDWR);
     ReleaseDC(dc);
     _ResizeWindow();
-    // Recompute placement from the caret when adding/removing the Tab row.
-    if (m_lastCaretRect.bottom > m_lastCaretRect.top) {
+    // A resized Tab row must use the same shadow correction as TSF MoveTo.
+    // Ordinary typing keeps the original adjusted position and jitter filtering.
+    const bool fromCaret = (wasRewrite || m_ctx.rewrite.active()) &&
+                           m_lastCaretRect.bottom > m_lastCaretRect.top;
+    if (fromCaret) {
       m_inputPos = m_lastCaretRect; m_inputPos.OffsetRect(0, 6);
     }
-    _RepositionWindow();
+    _RepositionWindow(fromCaret);
     if (m_ctx != m_octx) {
       m_octx = m_ctx;
       RedrawWindow();
diff --git a/rewrite-build.txt b/rewrite-build.txt
index 4bfd5a8..9f73bf5 100644
--- a/rewrite-build.txt
+++ b/rewrite-build.txt
@@ -1,4 +1,4 @@
-Build-ID: rewrite-ui-integrated-tab-placement-20261001
+Build-ID: rewrite-ui-tab-position-stable-20261001
 Weasel base: d73f6295e8252ed2f7b9c12bae32e9001b1afdaa
 Features: integrated Tab preedit row with ordinary prefix numbers; 12pt skin; original inline composition
 Targets: Windows x64 / x86; ARM64 not supported
diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index 233a5fc..c985eee 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -289,6 +289,23 @@ int main() {
       assert(actual.top == before.top && actual.left == before.left);
 
     }
+    // Typing interleaves context refresh and TSF caret notifications. Neither
+    // phase may move the panel by the shadow-buffer height at an unchanged caret.
+    for (int repeat = 0; repeat < 12; ++repeat) {
+      for (auto typing : {normal, armed, indexed, replaced}) {
+        typing.cinfo = normal.cinfo;
+        typing.cinfo.candies[0].str += std::wstring(repeat % 2, L'测');
+        host.ctx() = typing;
+        panel.Refresh();
+        CRect refreshed; panel.GetWindowRect(&refreshed);
+        panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
+        CRect positioned; panel.GetWindowRect(&positioned);
+        assert(refreshed.TopLeft() == positioned.TopLeft());
+        panel.Refresh();
+        CRect repeated; panel.GetWindowRect(&repeated);
+        assert(repeated == positioned);
+      }
+    }
     panel.MoveTo(CRect(200, 200, 200, 224), inputHost);
     auto hostCandidate = panel.SurfaceRect(); auto hostEditor = panel.RewriteSurfaceRect();
     const auto layoutGeneration = panel.RewriteLayoutGeneration();
