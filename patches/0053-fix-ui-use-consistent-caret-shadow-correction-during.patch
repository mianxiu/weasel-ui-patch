From 5279d49a5ac557171d309975e161b6a8d3ca4395 Mon Sep 17 00:00:00 2001
From: mianxiu <mianxiu8481@gmail.com>
Date: Thu, 1 Oct 2026 02:48:44 +0800
Subject: [PATCH 53/66] fix(ui): use consistent caret shadow correction during
 typing

---
 INSTALL-PATCH.md               |  2 ++
 Install-Binaries.ps1           |  2 +-
 REWRITE-UI.md                  |  2 ++
 WeaselUI/WeaselPanel.cpp       | 10 +++++++---
 rewrite-build.txt              |  2 +-
 test/rewrite_pipeline_test.cpp | 17 +++++++++++++++++
 6 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/INSTALL-PATCH.md b/INSTALL-PATCH.md
index a283dea..76ec492 100644
--- a/INSTALL-PATCH.md
+++ b/INSTALL-PATCH.md
@@ -1,3 +1,5 @@
+> **2026-10-01 打字抖动修复：** Tab 行重排时，从原始光标定位必须与 TSF 位置通知使用相同的阴影偏移；普通打字继续保留原候选框的已调整位置。测试覆盖连续交替更新内容和同位置光标通知，两个阶段不得上下跳动。
+
 > **2026-10-01 当前 Tab 实现：** Tab 编码恢复到主候选框内的编码行，进入时原候选框增高，退出后恢复；主候选在行内编码下方时 Tab 行在候选下方，主候选在行内编码上方时 Tab 行在候选上方；共用原皮肤圆角、外框和阴影。万象声调拼音使用普通前置编号（如 `1. shū`），取消上标和独立编号徽章；序号与拼音同一基线，编辑输入显示在所有音节后面。保留行内原始输入、紧凑皮肤与窗口跟随优化。下方独立悬浮、组合轮廓的说明是旧版记录，以此条为准。
 
 > **2026-10-01 整体圆角轮廓：** 主候选与 Tab 标签使用同一条组合外轮廓描边，连接处为圆弧，内部没有分隔边；两块分区绘制同一形状与阴影，避免接缝重复加深。文字对齐、紧凑 padding 和跨线程跟随保持。
diff --git a/Install-Binaries.ps1 b/Install-Binaries.ps1
index 912dad3..ae692f6 100644
--- a/Install-Binaries.ps1
+++ b/Install-Binaries.ps1
@@ -144,7 +144,7 @@ try {
   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-integrated-tab-placement-20261001; profile: $profileName"
+  Write-Host "Build: rewrite-ui-tab-position-stable-20261001; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
