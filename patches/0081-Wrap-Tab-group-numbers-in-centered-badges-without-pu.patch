diff --git a/WeaselUI/RewriteLayout.h b/WeaselUI/RewriteLayout.h
index ecbdbed..88b8bd5 100644
--- a/WeaselUI/RewriteLayout.h
+++ b/WeaselUI/RewriteLayout.h
@@ -17,7 +17,6 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
   const auto& style = layout._style;
   const bool vertical = style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT;
   const int px = (std::max)(1, (int)(3 * dwr->dpiScaleLayout));
-  const int py = 0;  // Font metrics already include the complete line height.
   const int margin = (std::max)(2, (int)(4 * dwr->dpiScaleLayout));
   const int gap = margin * 2;
   const int rightPadding = (int)ceil(4 * dwr->dpiScaleLayout);
@@ -72,12 +71,9 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     CSize text(0, 0), label(0, 0);
     std::wstring number;
     if (!unit.label.empty() && !hiddenNumber(unit.label)) {
-      wchar_t formatted[128];
-      swprintf_s(formatted, style.label_text_format.c_str(), unit.label.c_str());
-      number = formatted;
-      layout.GetTextSizeDW(number, number.size(), dwr->pRewriteLabelTextFormat, dwr, &label);
+      number = unit.label;
+      layout.GetTextSizeDW(number, number.size(), dwr->pRewriteBadgeTextFormat, dwr, &label);
     }
-    const int labelOffset = vertical ? 0 : (std::max)(0, (int)ceil(dwr->rewriteLabelBaselineOffset));
     const int lw = number.empty() ? 0 : label.cx + px * 2;
     const auto& textValue = unit.text;
     const int prefixGap = margin;
@@ -90,7 +86,7 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
       layout.GetTextSizeDW(textValue, textValue.size(), dwr->pRewriteTextFormat,
                           dwr, &text);
     layout._style.max_width = savedWidth;
-    const int lh = number.empty() ? 0 : label.cy + py * 2 + labelOffset;
+    const int lh = number.empty() ? 0 : dwr->rewriteBadgeHeight;
     const int separation = textValue.empty() ? 0 : prefixGap;
     const int w = vertical ? (std::max<LONG>)(text.cx, lw) : text.cx + (lw ? separation + lw : 0);
     const int h = vertical ? text.cy + (lh ? separation + lh : 0) : (std::max<LONG>)(text.cy, lh);
@@ -103,11 +99,11 @@ inline RewriteLayout MeasureRewrite(Layout& layout, const RewriteState& state,
     lb.SetRectEmpty(); lr.SetRectEmpty();
     if (lw) {
       const int bx = x;
-      const int by = y;
+      const int by = vertical ? y : y + (h - lh) / 2;
       lb.SetRect(bx, by, bx + lw, by + lh);
-      lr.SetRect(bx + px, by + py + labelOffset, bx + px + label.cx, by + py + labelOffset + label.cy);
+      lr = lb;
     }
-    if (lw) tr.OffsetRect(vertical ? 0 : lw + separation, vertical ? lh + separation : py);
+    if (lw) tr.OffsetRect(vertical ? 0 : lw + separation, vertical ? lh + separation : 0);
     auto shown = unit; shown.label = number; shown.text = textValue;
     result.cells.push_back({shown, CRect(x, y, x + w, y + h), tr, lb, lr});
     result.size.cx = (std::max<LONG>)(result.size.cx, x + w);
diff --git a/WeaselUI/WeaselPanel.cpp b/WeaselUI/WeaselPanel.cpp
index e3f1296..2718a56 100644
--- a/WeaselUI/WeaselPanel.cpp
+++ b/WeaselUI/WeaselPanel.cpp
@@ -949,6 +949,12 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
                          DPI_SCALE(6), BackType::TEXT, IsToRoundStruct());
         }
       }
+      if (!cell.unit.badge && !cell.unit.label.empty()) {
+        auto back = cell.labelBack;
+        if (stable) back.IntersectRect(back, clip);
+        _HighlightText(dc, back, 0xffe8e8e8, 0, DPI_SCALE(4),
+                       BackType::TEXT, IsToRoundStruct());
+      }
     } else {
       int color = cell.unit.badge ? 0xff555555 :
           (cell.unit.active ? m_style.hilited_candidate_text_color : m_style.text_color);
@@ -968,10 +974,7 @@ bool WeaselPanel::_DrawRewrite(CDCHandle dc, const CRect& rc, bool background) {
       }
       if (!cell.unit.label.empty())
         _TextOut(cell.label, cell.unit.label, cell.unit.label.size(),
-                 cell.unit.badge ? 0xff555555 :
-                     (cell.unit.active ? 0xffd0d0d0 : m_style.label_text_color),
-                 cell.unit.badge ? pDWR->pRewriteBadgeTextFormat.Get() : pDWR->pRewriteLabelTextFormat.Get(),
-                 cell.unit.badge);
+                 0xff555555, pDWR->pRewriteBadgeTextFormat.Get(), true);
       if (stable) pDWR->pRenderTarget->PopAxisAlignedClip();
     }
   }
