-# Merge these keys into the EXISTING patch map of weasel.custom.yaml.
-# Do not replace your theme or existing settings.
-patch:
-  rewrite_ui/enabled: true
-  rewrite_ui/debug: false
-# Existing theme settings control native rewrite cells:
-# hilited_back_color, hilited_text_color, text_color,
-# style/layout/corner_radius, hilite_padding_x/y and hilite_spacing.
-# The index badge uses one third of the highlight background opacity.
-#
-# After editing these keys you MUST redeploy (WeaselDeployer.exe /deploy) and
-# then restart WeaselServer.exe. The server reads the compiled config at
-# %APPDATA%\Rime\build\weasel.yaml, not weasel.yaml (the installed default
-# copy, which has no rewrite_ui/* keys) and not this custom file. Editing the
-# custom file alone leaves the old values in build\weasel.yaml in effect.
-#
-# rewrite_ui/debug: true writes the codes being typed to
-# %TEMP%\rime.weasel\rewrite-ui.log. Turn it back off, redeploy and restart
-# the server when the investigation is finished.
