index 0000000..b421257
--- /dev/null
+++ b/rime/wanxiang_pro.custom.yaml
@@ -0,0 +1,29 @@
+# 本文件的工作目录是在用户根目录，本目录携带是因为如果放外面就会更新的时候覆盖你的修改，因此我只能藏起来。
+# 如果没有按初始化说明进行初始化那么你需要手动复制本文件到上层目录，请知悉。
+patch:
+  engine/processors/@before 0: lua_processor@*indexed_rewrite_pro
+
+  key_binder/bindings/+:
+    - { when: has_menu, accept: "Tab", send_sequence: "//" }
+    - { when: composing, accept: "Tab", send_sequence: "//" }
+
+  speller/algebra:
+    __patch:
+      #- wanxiang_algebra:/模糊音_nl
+      #- wanxiang_algebra:/模糊音_ry
+      #- wanxiang_algebra:/模糊音_hf
+      #- wanxiang_algebra:/模糊音_rl
+      #- wanxiang_algebra:/模糊音_kg
+      #- wanxiang_algebra:/模糊音_en_eng
+      #- wanxiang_algebra:/模糊音_in_ing
+      #- wanxiang_algebra:/模糊音_c_ch
+      #- wanxiang_algebra:/模糊音_z_zh
+      #- wanxiang_algebra:/模糊音_s_sh
+      - wanxiang_algebra:/pro/小鹤双拼
+      # 可选输入方案名称：自然码, 自然龙, 小鹤双拼, 搜狗双拼, 微软双拼, 智能ABC, 紫光双拼, 国标双拼
+      - wanxiang_algebra:/pro/直接辅助
+      #辅助码升级为：直接辅助和间接辅助两种类型，都是句中任意，不同点在于直接辅助是nire=你  而间接则需要/引导  ni/re=你 ，在这个基础上直接辅助支持拼音后任意位置数字声调参与，间接辅助声调在/引导前参与
+      #- wanxiang_algebra:/自然码提权             #自然码提权、小鹤双拼提权 可选
+
+  #下面是候选数量
+  menu/page_size: 6
diff --git a/rime/weasel.custom.yaml b/rime/weasel.custom.yaml
new file mode 100644
index 0000000..f904329
--- /dev/null
+++ b/rime/weasel.custom.yaml
@@ -0,0 +1,24 @@
+# Rewrite UI 开关（脱敏版：只有开关，不含个人主题与 app_options）。
+#
+# 如果 %APPDATA%\Rime\weasel.custom.yaml 已经存在（通常都有，里面是你的主题），
+# 请把下面 patch: 下的两行合并进去，**不要整体覆盖**那个文件，否则会丢主题。
+# 也可以直接用仓库根的 enable-rewrite-ui.ps1 -Apply 自动合并。
+patch:
+  rewrite_ui/enabled: true
+  rewrite_ui/debug: false
+
+# 原生绘制用到的颜色 / 圆角 / 间距全部复用当前主题，不在这里配置：
+#   hilited_back_color      当前音节背景
+#   hilited_text_color      当前音节文字
+#   text_color              普通音节文字
+#   style/layout/corner_radius、hilite_padding_x/y、hilite_spacing
+# index badge 的背景取高亮背景透明度的 1/3，不单独配置。
+#
+# 改完必须重新部署再重启服务，顺序不能省：
+#   WeaselDeployer.exe /deploy    → 重新生成 %APPDATA%\Rime\build\weasel.yaml
+#   WeaselServer.exe /quit        → 停服务
+#   启动 WeaselServer.exe          → Initialize() 重新读配置
+# 服务端读的是 build\weasel.yaml，只改这个文件而不部署是无效的。
+#
+# rewrite_ui/debug: true 会把正在输入的编码写进
+# %TEMP%\rime.weasel\rewrite-ui.log，排查完请改回 false 并再次部署 + 重启。
