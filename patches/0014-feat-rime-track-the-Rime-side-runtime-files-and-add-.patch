+++ b/rime/README.md
@@ -0,0 +1,45 @@
+# Rime 用户目录文件（不带词库）
+
+这个目录放的是本补丁**必需的、原先只存在于 `%APPDATA%\Rime` 的运行期文件**。
+没有它们，只 clone 本仓库是跑不起来的。
+
+| 文件 | 目标位置 | 作用 |
+|---|---|---|
+| `lua/indexed_rewrite_pro.lua` | `%APPDATA%\Rime\lua\` | 核心编辑算法（`Tab` 重写状态机） |
+| `wanxiang_pro.custom.yaml` | `%APPDATA%\Rime\` | `Tab → send_sequence: "//"` 绑定、注册 processor |
+| `weasel.custom.yaml` | `%APPDATA%\Rime\` | `rewrite_ui/*` 开关（脱敏版，只有开关没有主题） |
+
+**不含**：万象 Pro 词库与方案数据、`wanxiang_algebra.yaml`、
+`indexed_rewrite_tab_ui_v2.lua`（已被 Weasel 原生绘制取代，不再需要）。
+
+## 安装
+
+```powershell
+# 预览（默认不改任何文件）
+pwsh -NoProfile -File .\install-rime-files.ps1
+
+# 实际写入（自动备份）
+pwsh -NoProfile -File .\install-rime-files.ps1 -Apply
+```
+
+脚本行为：
+
+- `lua\indexed_rewrite_pro.lua`：不存在就复制；已存在且内容不同则先备份再覆盖
+- `wanxiang_pro.custom.yaml`：不存在就复制；已存在则**只检查**必需的几行是否齐全，
+  不覆盖（你可能有模糊音之类的额外自定义），报告缺什么
+- `weasel.custom.yaml`：不存在就复制；已存在则在 `patch:` 下补齐两行开关，
+  不改动你原有的主题配置
+
+写入完成后脚本会打印后续必须执行的步骤（重新部署 + 重启服务）。
+
+## 换机器恢复顺序
+
+1. `git clone` 本仓库（`feature/rewrite-ui` 分支，`--recursive` 取子模块）
+2. 装好小狼毫、万象 Pro，准备好词库
+3. 在仓库根运行 `rime\install-rime-files.ps1 -Apply`
+4. 编译并安装补丁程序：`build-rewrite.cmd` → `package-rewrite.ps1` → `Apply-Patch.cmd`
+5. `WeaselDeployer.exe /deploy`，然后重启 `WeaselServer.exe`
+6. 注销并重新登录 Windows，使宿主进程加载新的 TSF DLL
+7. 按 `REWRITE-UI.md` 的验收项回归：`jxjirzbj` → `Tab` → `3` → `j` → `m` → `Backspace` → `Esc`
+
+只调 `rewrite_ui/*` 开关时不需要第 4、6 步，但第 5 步不能省。
diff --git a/rime/install-rime-files.ps1 b/rime/install-rime-files.ps1
new file mode 100644
index 0000000..79542ac
--- /dev/null
+++ b/rime/install-rime-files.ps1
@@ -0,0 +1,155 @@
+# Installs the Rime-side files this patch depends on. Preview by default;
+# pass -Apply to write. Existing files are backed up before being replaced.
+[CmdletBinding()]
+param(
+  [string]$UserDataRoot = (Join-Path $env:APPDATA 'Rime'),
+  [switch]$Apply,
+  [switch]$Force
+)
+$ErrorActionPreference = 'Stop'
+$source = $PSScriptRoot
+
+function Backup-File([string]$Path) {
+  $stamp = (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [Guid]::NewGuid().ToString('N').Substring(0, 8)
+  $dest = "$Path.rewrite-backup-$stamp"
+  Copy-Item -LiteralPath $Path -Destination $dest
+  Write-Output ("  backup: " + (Split-Path $dest -Leaf))
+}
+
+$luaSrc = Join-Path $source 'lua\indexed_rewrite_pro.lua'
+$schemaSrc = Join-Path $source 'wanxiang_pro.custom.yaml'
+$uiSrc = Join-Path $source 'weasel.custom.yaml'
+foreach ($f in @($luaSrc, $schemaSrc, $uiSrc)) {
+  if (!(Test-Path -LiteralPath $f -PathType Leaf)) { throw "Missing source file: $f" }
+}
+if (!(Test-Path -LiteralPath $UserDataRoot -PathType Container)) {
+  throw "Rime user directory not found: $UserDataRoot"
+}
+
+$luaDst = Join-Path $UserDataRoot 'lua\indexed_rewrite_pro.lua'
+$schemaDst = Join-Path $UserDataRoot 'wanxiang_pro.custom.yaml'
+$uiDst = Join-Path $UserDataRoot 'weasel.custom.yaml'
+
+Write-Output "Rime user directory : $UserDataRoot"
+Write-Output "Source              : $source"
+Write-Output ("Mode                : " + $(if ($Apply) { 'APPLY' } else { 'preview (no files changed)' }))
+Write-Output ""
+
+# ---------------------------------------------------------------- 1. Lua
+Write-Output '[1/3] lua\indexed_rewrite_pro.lua'
+$luaAction = 'copy'
+if (Test-Path -LiteralPath $luaDst) {
+  $luaAction = if ((Get-FileHash -LiteralPath $luaDst).Hash -eq
+                   (Get-FileHash -LiteralPath $luaSrc).Hash) { 'unchanged' } else { 'replace' }
+}
+switch ($luaAction) {
+  'unchanged' { Write-Output '  already identical, nothing to do' }
+  'copy' { Write-Output '  will install (target does not exist)' }
+  'replace' { Write-Output '  will REPLACE the existing file (backup kept)' }
+}
+
+# ------------------------------------------- 2. wanxiang_pro.custom.yaml
+Write-Output '[2/3] wanxiang_pro.custom.yaml'
+$required = @('lua_processor@\*indexed_rewrite_pro', 'key_binder/bindings/\+:', 'speller/algebra:')
+if (!(Test-Path -LiteralPath $schemaDst)) {
+  $schemaAction = 'copy'
+  Write-Output '  will install (target does not exist)'
+}
+else {
+  # Never overwrite silently: the file may carry unrelated customisations.
+  $existing = [IO.File]::ReadAllLines($schemaDst)
+  $missing = @($required | Where-Object { -not ($existing -match $_) })
+  if ($missing.Count -eq 0) {
+    $schemaAction = 'unchanged'
+    Write-Output '  existing file already has the required patch lines, left untouched'
+  }
+  elseif ($Force) {
+    $schemaAction = 'replace'
+    Write-Output '  existing file is missing required lines; -Force given, will overwrite (backup kept)'
+  }
+  else {
+    $schemaAction = 'skip'
+    Write-Output '  existing file is MISSING required lines and was left untouched:'
+    $missing | ForEach-Object { Write-Output "    - $_" }
+    Write-Output '  merge them manually, or re-run with -Force to overwrite.'
+  }
+}
+
+# ------------------------------------------------- 3. weasel.custom.yaml
+Write-Output '[3/3] weasel.custom.yaml'
+$uiAction = 'merge'
+if (!(Test-Path -LiteralPath $uiDst)) {
+  $uiAction = 'copy'
+  Write-Output '  will install (target does not exist)'
+}
+else {
+  $lines = [IO.File]::ReadAllLines($uiDst)
+  if (@($lines | Where-Object { $_ -ceq 'patch:' }).Count -ne 1) {
+    throw "Expected exactly one top-level 'patch:' line in $uiDst."
+  }
+  if ($lines -match '^\s+rewrite_ui:\s*$') {
+    throw "Nested rewrite_ui map in $uiDst requires manual reconciliation."
+  }
+  $needEnabled = -not ($lines -match '^\s*["'']?rewrite_ui/enabled["'']?\s*:')
+  $needDebug = -not ($lines -match '^\s*["'']?rewrite_ui/debug["'']?\s*:')
+  if (!$needEnabled -and !$needDebug) {
+    $uiAction = 'unchanged'
+    Write-Output '  both rewrite_ui switches already present, left untouched'
+  }
+  else {
+    $newLines = @(
+      foreach ($line in $lines) {
+        $line
+        if ($line -ceq 'patch:') {
+          if ($needEnabled) { '  rewrite_ui/enabled: true' }
+          if ($needDebug) { '  rewrite_ui/debug: false' }
+        }
+      }
+    )
+    $missing = @()
+    if ($needEnabled) { $missing += 'rewrite_ui/enabled' }
+    if ($needDebug) { $missing += 'rewrite_ui/debug' }
+    Write-Output ('  will insert under patch/: ' + ($missing -join ', '))
+    Write-Output '  existing theme and app_options are preserved'
+  }
+}
+
+Write-Output ''
+if (!$Apply) {
+  Write-Output 'Preview only. Re-run with -Apply to write.'
+  return
+}
+
+# ------------------------------------------------------------------ apply
+Write-Output 'Applying:'
+if ($luaAction -eq 'copy' -or $luaAction -eq 'replace') {
+  $luaDir = Split-Path $luaDst -Parent
+  if (!(Test-Path -LiteralPath $luaDir)) { New-Item -ItemType Directory -Force $luaDir | Out-Null }
+  if ($luaAction -eq 'replace') { Backup-File $luaDst }
+  Copy-Item -LiteralPath $luaSrc -Destination $luaDst -Force
+  Write-Output "  lua\indexed_rewrite_pro.lua : installed"
+}
+if ($schemaAction -eq 'copy' -or $schemaAction -eq 'replace') {
+  if ($schemaAction -eq 'replace') { Backup-File $schemaDst }
+  Copy-Item -LiteralPath $schemaSrc -Destination $schemaDst -Force
+  Write-Output '  wanxiang_pro.custom.yaml    : installed'
+}
+if ($uiAction -eq 'copy') {
+  Copy-Item -LiteralPath $uiSrc -Destination $uiDst -Force
+  Write-Output '  weasel.custom.yaml          : installed'
+}
+elseif ($uiAction -eq 'merge') {
+  Backup-File $uiDst
+  $utf8 = New-Object Text.UTF8Encoding($false)
+  [IO.File]::WriteAllLines($uiDst, [string[]]$newLines, $utf8)
+  Write-Output '  weasel.custom.yaml          : switches merged'
+}
+
+Write-Output ''
+Write-Output 'Next steps (both are required):'
+Write-Output '  1. WeaselDeployer.exe /deploy        # rebuilds %APPDATA%\Rime\build\weasel.yaml'
+Write-Output '  2. restart WeaselServer.exe          # Initialize() reads the config at startup'
+Write-Output ''
+Write-Output 'If you replaced the Weasel binaries too, sign out and back in so that'
+Write-Output 'hosting processes load the new TSF DLL, then re-run the acceptance checks'
+Write-Output 'listed in REWRITE-UI.md.'
diff --git a/rime/lua/indexed_rewrite_pro.lua b/rime/lua/indexed_rewrite_pro.lua
new file mode 100644
index 0000000..2bbcd6d
--- /dev/null
+++ b/rime/lua/indexed_rewrite_pro.lua
@@ -0,0 +1,601 @@
+-- indexed_rewrite_pro.lua
+-- 万象 Pro / 小鹤双拼：双模式 // 快速重写器
+--
+-- 同时支持：
+--
+--   1) // + 字母
+--      从头逐字符覆盖（保留旧功能）
+--
+--      jxjirz//jm
+--      -> jmjirz
+--
+--   2) // + 数字 + 字母
+--      按音节索引替换
+--
+--      jxjirzbj//3jm
+--      -> 把第 3 音节替换为 jm
+--
+-- UI 与 indexed_rewrite_preedit.lua 配合：
+--   //      -> jx¹ ji² rz³ bj⁴
+--   //3     -> jx¹ ji² 【rz³】 bj⁴
+--
+-- 单个 / 始终先交给万象 Pro。
+-- 只有第二个连续 / 到来时才进入本脚本。
+
+local M = {}
+
+local ACCEPTED = 1
+local NOOP = 2
+
+local PROP_STAGE = "_indexed_rewrite_stage"
+local PROP_ORIGINAL = "_indexed_rewrite_original"
+local PROP_INDEX = "_indexed_rewrite_index"
+local PROP_RANGES = "_indexed_rewrite_ranges"
+local PROP_REPLACEMENT = "_indexed_rewrite_replacement"
+
+local function set_prop(ctx, key, value)
+    ctx:set_property(key, value or "")
+end
+
+local function get_prop(ctx, key)
+    return ctx:get_property(key) or ""
+end
+
+-- 只在“索引 property 改变、context.input 没变”时使用。
+-- librime-lua 正式暴露 Engine:compose(Context)。
+-- 这里重新 Compose 当前输入，让 translation/filter 重新建立；
+-- 不修改 context.input，也不调用 RefreshNonConfirmedComposition。
+local function sync_ui(env, ctx)
+    pcall(function()
+        env.engine:compose(ctx)
+    end)
+end
+
+
+local function clear_props(ctx)
+    set_prop(ctx, PROP_STAGE, "")
+    set_prop(ctx, PROP_ORIGINAL, "")
+    set_prop(ctx, PROP_INDEX, "")
+    set_prop(ctx, PROP_RANGES, "")
+    set_prop(ctx, PROP_REPLACEMENT, "")
+end
+
+local function is_slash(repr)
+    return repr == "/" or repr == "slash"
+end
+
+local function is_digit(repr)
+    return #repr == 1 and repr:match("^[0-9]$") ~= nil
+end
+
+local function is_lower_letter(repr)
+    return #repr == 1 and repr:match("^[a-z]$") ~= nil
+end
+
+------------------------------------------------------------
+-- range helpers
+------------------------------------------------------------
+
+local function serialize_ranges(ranges)
+    local parts = {}
+    for _, r in ipairs(ranges) do
+        parts[#parts + 1] = tostring(r[1]) .. "-" .. tostring(r[2])
+    end
+    return table.concat(parts, ",")
+end
+
+local function parse_ranges(s)
+    local ranges = {}
+    for a, b in (s or ""):gmatch("(%d+)%-(%d+)") do
+        ranges[#ranges + 1] = { tonumber(a), tonumber(b) }
+    end
+    return ranges
+end
+
+------------------------------------------------------------
+-- 尝试读取 Rime candidate spans
+------------------------------------------------------------
+
+local function try_previous_stop(spans, pos)
+    local names = {
+        "previous_stop",
+        "PreviousStop",
+        "prev_stop",
+        "PrevStop",
+    }
+
+    for _, name in ipairs(names) do
+        local ok, value = pcall(function()
+            local fn = spans[name]
+            if type(fn) == "function" then
+                return fn(spans, pos)
+            end
+            return nil
+        end)
+
+        if ok and type(value) == "number" then
+            return value
+        end
+    end
+
+    return nil
+end
+
+local function ranges_from_rime(ctx, raw)
+    local cand = ctx:get_selected_candidate()
+    if not cand then
+        return nil
+    end
+
+    local ok, spans = pcall(function()
+        return cand:spans()
+    end)
+
+    if not ok or not spans then
+        return nil
+    end
+
+    local stops = { #raw }
+    local pos = #raw
+    local guard = 0
+
+    while pos > 0 and guard < 128 do
+        guard = guard + 1
+        local prev = try_previous_stop(spans, pos)
+
+        if type(prev) ~= "number"
+            or prev < 0
+            or prev >= pos
+        then
+            break
+        end
+
+        table.insert(stops, 1, prev)
+        pos = prev
+    end
+
+    if stops[1] ~= 0 or #stops < 2 then
+        return nil
+    end
+
+    local ranges = {}
+    for i = 1, #stops - 1 do
+        local a = stops[i]
+        local b = stops[i + 1]
+        if b > a then
+            ranges[#ranges + 1] = { a, b }
+        end
+    end
+
+    if #ranges == 0 then
+        return nil
+    end
+
+    return ranges
+end
+
+------------------------------------------------------------
+-- 小鹤双拼 fallback：两码一音节
+------------------------------------------------------------
+
+local function ranges_fallback_xiaohe(raw)
+    local ranges = {}
+    local n = #raw
+    local pos = 0
+
+    while pos < n do
+        local next_pos = math.min(pos + 2, n)
+        ranges[#ranges + 1] = { pos, next_pos }
+        pos = next_pos
+    end
+
+    return ranges
+end
+
+local function get_ranges(ctx, raw)
+    local ranges = ranges_from_rime(ctx, raw)
+    if ranges and #ranges > 0 then
+        return ranges
+    end
+    return ranges_fallback_xiaohe(raw)
+end
+
+------------------------------------------------------------
+-- string helpers
+------------------------------------------------------------
+
+local function slice0(s, start_pos, end_pos)
+    if end_pos <= start_pos then
+        return ""
+    end
+    return s:sub(start_pos + 1, end_pos)
+end
+
+local function replace_range(original, start_pos, end_pos, replacement)
+    local prefix = slice0(original, 0, start_pos)
+    local suffix = original:sub(end_pos + 1)
+    return prefix .. replacement .. suffix
+end
+
+-- 旧版 // 从头覆盖行为
+local function overwrite_from_start(original, typed)
+    local n = #typed
+    if n >= #original then
+        return typed
+    end
+    return typed .. original:sub(n + 1)
+end
+
+------------------------------------------------------------
+-- state helpers
+------------------------------------------------------------
+
+local function finish(ctx)
+    clear_props(ctx)
+end
+
+local function cancel(ctx)
+    local original = get_prop(ctx, PROP_ORIGINAL)
+    if original ~= "" then
+        ctx.input = original
+        ctx.caret_pos = #original
+    end
+    clear_props(ctx)
+end
+
+local function get_target_range(ctx)
+    local n = tonumber(get_prop(ctx, PROP_INDEX))
+    if not n or n < 1 then
+        return nil, nil, nil
+    end
+
+    local ranges = parse_ranges(get_prop(ctx, PROP_RANGES))
+    local r = ranges[n]
+    if not r then
+        return nil, nil, nil
+    end
+
+    return r[1], r[2], n
+end
+
+------------------------------------------------------------
+-- init / fini
+------------------------------------------------------------
+
+function M.init(env)
+    clear_props(env.engine.context)
+end
+
+function M.fini(env)
+    clear_props(env.engine.context)
+end
+
+------------------------------------------------------------
+-- processor
+------------------------------------------------------------
+
+function M.func(key, env)
+
+    if key:release() then
+        return NOOP
+    end
+
+    local ctx = env.engine.context
+    local repr = key:repr()
+    local stage = get_prop(ctx, PROP_STAGE)
+
+    if stage ~= "" and (
+        not ctx:is_composing()
+        or ctx.input == ""
+    ) then
+        clear_props(ctx)
+        stage = ""
+    end
+
+    --------------------------------------------------------
+    -- armed:
+    -- 已按 //，下一键决定模式：
+    --   数字 -> 索引模式
+    --   字母 -> 从头覆盖模式
+    --------------------------------------------------------
+
+    if stage == "armed" then
+
+        if is_digit(repr) then
+            if repr == "0" then
+                return ACCEPTED
+            end
+
+            set_prop(ctx, PROP_INDEX, repr)
+            set_prop(ctx, PROP_STAGE, "index")
+            sync_ui(env, ctx)
+            return ACCEPTED
+        end
+
+        if is_lower_letter(repr) then
+            local original = get_prop(ctx, PROP_ORIGINAL)
+            local typed = repr
+
+            set_prop(ctx, PROP_REPLACEMENT, typed)
+            set_prop(ctx, PROP_STAGE, "head_replace")
+
+            local new_input = overwrite_from_start(original, typed)
+            ctx.input = new_input
+            ctx.caret_pos = #new_input
+
+            return ACCEPTED
+        end
+
+        if repr == "BackSpace" then
+            finish(ctx)
+            return ACCEPTED
+        end
+
+        if repr == "Escape" then
+            cancel(ctx)
+            return ACCEPTED
+        end
+
+        if is_slash(repr) then
+            finish(ctx)
+            return ACCEPTED
+        end
+
+        finish(ctx)
+        return NOOP
+    end
+
+    --------------------------------------------------------
+    -- index:
+    -- 已输入 //N，继续收数字或等待替换字母
+    --------------------------------------------------------
+
+    if stage == "index" then
+
+        if is_digit(repr) then
+            local current = get_prop(ctx, PROP_INDEX)
+            current = current .. repr
+            set_prop(ctx, PROP_INDEX, current)
+            sync_ui(env, ctx)
+            return ACCEPTED
+        end
+
+        if repr == "BackSpace" then
+            local current = get_prop(ctx, PROP_INDEX)
+
+            if #current > 1 then
+                current = current:sub(1, #current - 1)
+                set_prop(ctx, PROP_INDEX, current)
+            else
+                set_prop(ctx, PROP_INDEX, "")
+                set_prop(ctx, PROP_STAGE, "armed")
+            end
+
+            sync_ui(env, ctx)
+            return ACCEPTED
+        end
+
+        if repr == "Escape" then
+            cancel(ctx)
+            return ACCEPTED
+        end
+
+        if is_lower_letter(repr) then
+            local start_pos, end_pos = get_target_range(ctx)
+
+            if not start_pos then
+                -- 索引越界时不吞字母，恢复正常输入
+                finish(ctx)
+                return NOOP
+            end
+
+            local original = get_prop(ctx, PROP_ORIGINAL)
+            local replacement = repr
+
+            set_prop(ctx, PROP_REPLACEMENT, replacement)
+            set_prop(ctx, PROP_STAGE, "index_replace")
+
+            local new_input = replace_range(
+                original,
+                start_pos,
+                end_pos,
+                replacement
+            )
+
+            ctx.input = new_input
+            ctx.caret_pos = #new_input
+
+            return ACCEPTED
+        end
+
+        if is_slash(repr) then
+            finish(ctx)
+            return ACCEPTED
+        end
+
+        finish(ctx)
+        return NOOP
+    end
+
+    --------------------------------------------------------
+    -- head_replace:
+    -- 旧功能：从输入串开头逐字符覆盖
+    --------------------------------------------------------
+
+    if stage == "head_replace" then
+
+        if is_lower_letter(repr) then
+            local typed = get_prop(ctx, PROP_REPLACEMENT) .. repr
+            local original = get_prop(ctx, PROP_ORIGINAL)
+
+            set_prop(ctx, PROP_REPLACEMENT, typed)
+
+            local new_input = overwrite_from_start(original, typed)
+            ctx.input = new_input
+            ctx.caret_pos = #new_input
+
+            return ACCEPTED
+        end
+
+        if repr == "BackSpace" then
+            local typed = get_prop(ctx, PROP_REPLACEMENT)
+
+            if #typed > 0 then
+                typed = typed:sub(1, #typed - 1)
+                set_prop(ctx, PROP_REPLACEMENT, typed)
+
+                local original = get_prop(ctx, PROP_ORIGINAL)
+
+                if typed == "" then
+                    ctx.input = original
+                    ctx.caret_pos = #original
+                    set_prop(ctx, PROP_STAGE, "armed")
+                else
+                    local new_input = overwrite_from_start(original, typed)
+                    ctx.input = new_input
+                    ctx.caret_pos = #new_input
+                end
+
+                return ACCEPTED
+            end
+
+            set_prop(ctx, PROP_STAGE, "armed")
+            return ACCEPTED
+        end
+
+        if repr == "Escape" then
+            cancel(ctx)
+            return ACCEPTED
+        end
+
+        if is_slash(repr) then
+            finish(ctx)
+            return ACCEPTED
+        end
+
+        finish(ctx)
+        return NOOP
+    end
+
+    --------------------------------------------------------
+    -- index_replace:
+    -- 替换指定音节
+    --------------------------------------------------------
+
+    if stage == "index_replace" then
+
+        if is_lower_letter(repr) then
+            local start_pos, end_pos = get_target_range(ctx)
+
+            if not start_pos then
+                finish(ctx)
+                return NOOP
+            end
+
+            local replacement = get_prop(ctx, PROP_REPLACEMENT) .. repr
+            local original = get_prop(ctx, PROP_ORIGINAL)
+
+            set_prop(ctx, PROP_REPLACEMENT, replacement)
+
+            local new_input = replace_range(
+                original,
+                start_pos,
+                end_pos,
+                replacement
+            )
+
+            ctx.input = new_input
+            ctx.caret_pos = #new_input
+
+            return ACCEPTED
+        end
+
+        if repr == "BackSpace" then
+            local replacement = get_prop(ctx, PROP_REPLACEMENT)
+            local start_pos, end_pos = get_target_range(ctx)
+
+            if not start_pos then
+                cancel(ctx)
+                return ACCEPTED
+            end
+
+            if #replacement > 0 then
+                replacement = replacement:sub(1, #replacement - 1)
+                set_prop(ctx, PROP_REPLACEMENT, replacement)
+
+                local original = get_prop(ctx, PROP_ORIGINAL)
+
+                if replacement == "" then
+                    ctx.input = original
+                    ctx.caret_pos = #original
+                    set_prop(ctx, PROP_STAGE, "index")
+                else
+                    local new_input = replace_range(
+                        original,
+                        start_pos,
+                        end_pos,
+                        replacement
+                    )
+                    ctx.input = new_input
+                    ctx.caret_pos = #new_input
+                end
+
+                return ACCEPTED
+            end
+
+            set_prop(ctx, PROP_STAGE, "index")
+            return ACCEPTED
+        end
+
+        if repr == "Escape" then
+            cancel(ctx)
+            return ACCEPTED
+        end
+
+        if is_slash(repr) then
+            finish(ctx)
+            return ACCEPTED
+        end
+
+        finish(ctx)
+        return NOOP
+    end
+
+    --------------------------------------------------------
+    -- 普通模式：
+    -- 第一个 / 已由万象处理。
+    -- 第二个 / 到来时进入 armed。
+    --------------------------------------------------------
+
+    if is_slash(repr) then
+        local raw = ctx.input or ""
+
+        if raw:match("^[a-z0-9]+/$")
+            and not ctx:get_option("ascii_mode")
+            and ctx.caret_pos == #raw
+        then
+            local original = raw:sub(1, #raw - 1)
+
+            if original ~= "" then
+                local ranges = get_ranges(ctx, original)
+
+                set_prop(ctx, PROP_STAGE, "armed")
+                set_prop(ctx, PROP_ORIGINAL, original)
+                set_prop(ctx, PROP_INDEX, "")
+                set_prop(ctx, PROP_RANGES, serialize_ranges(ranges))
+                set_prop(ctx, PROP_REPLACEMENT, "")
+
+                -- 去掉第一枚已进入 input 的 /
+                ctx.input = original
+                ctx.caret_pos = #original
+
+                -- 吞掉第二枚 /
+                return ACCEPTED
+            end
+        end
+    end
+
+    return NOOP
+end
+
+return M
diff --git a/rime/wanxiang_pro.custom.yaml b/rime/wanxiang_pro.custom.yaml
