diff --git a/test/rewrite_pipeline_test.cpp b/test/rewrite_pipeline_test.cpp
index 08abfb1..93a0732 100644
--- a/test/rewrite_pipeline_test.cpp
+++ b/test/rewrite_pipeline_test.cpp
@@ -105,7 +105,7 @@ int main() {
       // Near-aligned right edges used to shrink both curves to a tiny 1-2px
       // radius. Preserve the long vertical tangent above and below the join.
       for (int scale : {1, 2}) for (bool above : {false, true}) {
-        for (int step : {2, 4, 8}) {
+        for (int step : {1, 2, 4, 8}) {
           CRect candidate(20*scale, 40*scale, 150*scale, 80*scale);
           CRect syllable(92*scale, (above ? 12 : 77)*scale,
                          (150-step)*scale, (above ? 43 : 108)*scale);
@@ -117,6 +117,21 @@ int main() {
           // The outer turn starts before the old half-step radius allowed.
           assert(!path.IsVisible(149.9f*scale, seam - side*3.f*scale));
           assert(path.IsVisible(100.f*scale, seam));
+          std::vector<Gdiplus::PointF> points(path.GetPointCount());
+          std::vector<BYTE> types(path.GetPointCount());
+          path.GetPathPoints(points.data(), (INT)points.size());
+          path.GetPathTypes(types.data(), (INT)types.size());
+          bool smoothStep = false;
+          for (size_t i = 1; i + 2 < points.size(); ++i) {
+            if ((types[i] & Gdiplus::PathPointTypePathTypeMask) != Gdiplus::PathPointTypeBezier) continue;
+            const auto a = points[i-1], b = points[i], c = points[i+1], d = points[i+2];
+            if (abs(abs(d.X-a.X)-step*scale) < .01f &&
+                abs(d.Y-a.Y) >= 20.f*scale && a.X == b.X && c.X == d.X)
+              smoothStep = true;
+            i += 2;
+          }
+          // No horizontal tangent at the narrow join: one long vertical S curve.
+          assert(smoothStep);
           // Keep all paint inside the original bounds; the text/layout is untouched.
           Gdiplus::RectF bounds; path.GetBounds(&bounds);
           assert(bounds.X >= candidate.left && bounds.GetRight() <= candidate.right);
@@ -151,6 +166,13 @@ int main() {
         Gdiplus::SolidBrush blue(Gdiplus::Color(255,38,105,255));
         graphics.FillPath(&blue,&highlight);
         assert(preview.Save(above ? L"deps/joined-highlight-above.png" : L"deps/joined-highlight-below.png", &png) == Gdiplus::Ok);
+        Gdiplus::Bitmap zoom(800,700,PixelFormat32bppARGB);
+        Gdiplus::Graphics zoomGraphics(&zoom);
+        zoomGraphics.Clear(Gdiplus::Color(255,255,255,255));
+        zoomGraphics.SetSmoothingMode(Gdiplus::SmoothingModeAntiAlias);
+        zoomGraphics.ScaleTransform(4.f,4.f);
+        zoomGraphics.FillPath(&blue,&highlight);
+        assert(zoom.Save(above ? L"deps/joined-highlight-above-zoom.png" : L"deps/joined-highlight-below-zoom.png", &png) == Gdiplus::Ok);
       }
     }
     Gdiplus::GdiplusShutdown(token);
