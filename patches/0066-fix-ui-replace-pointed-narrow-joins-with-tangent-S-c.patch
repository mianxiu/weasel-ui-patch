   $arguments = @{hans='/s'; hant='/t'; hongkong='/hk'; macau='/mc'; singapore='/sg'}
   if (!$arguments.ContainsKey($profileName)) { throw "Unsupported existing profile: $profileName" }
   Write-Host "Target: $Target"
-  Write-Host "Build: rewrite-ui-smooth-highlight-20261001; profile: $profileName"
+  Write-Host "Build: rewrite-ui-smooth-neck-20261001; profile: $profileName"
   Write-Host 'Program installer: revision 6 (shutdown process race fixed)'
   Write-Host 'Package hashes and target files verified. User dictionaries/configuration will not be changed.'
   if ($CheckOnly) { $succeeded = $true; Write-Host 'CHECK ONLY: no files, processes, or registry entries changed.'; exit 0 }
