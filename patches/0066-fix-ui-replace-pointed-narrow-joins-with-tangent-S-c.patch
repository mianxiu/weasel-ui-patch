diff --git a/WeaselUI/JoinedRewritePath.h b/WeaselUI/JoinedRewritePath.h
index db8bfb0..284f934 100644
--- a/WeaselUI/JoinedRewritePath.h
+++ b/WeaselUI/JoinedRewritePath.h
@@ -71,6 +71,28 @@ inline void BuildJoinedRewritePath(Gdiplus::GraphicsPath& path, CRect body, CRec
     const float outgoingRadius = (std::min)(radius, outgoing / 2);
     const Gdiplus::PointF u((c.x - p.x) / incoming, (c.y - p.y) / incoming);
     const Gdiplus::PointF v((n.x - c.x) / outgoing, (n.y - c.y) / outgoing);
+    // Two quarter ellipses on a tiny horizontal ledge still flatten to a
+    // near-horizontal tangent, which looks like a point at normal DPI. Replace
+    // the opposing turns with one S curve, tangent to both vertical sides.
+    if (i + 1 < corners.size() && c.y == n.y && outgoing <= 2 * neckRadius) {
+      const auto after = corners[(i + 2) % corners.size()];
+      const float nextLength = (float)(abs(after.x - n.x) + abs(after.y - n.y));
+      const Gdiplus::PointF w((after.x - n.x) / nextLength, (after.y - n.y) / nextLength);
+      if (u.X == 0 && w.X == 0 && u.Y == w.Y) {
+        const float reach = (std::max)((std::max)(bodyRadius, tagRadius), neckRadius);
+        const float beforeReach = (std::min)(reach, incoming / 2);
+        const float afterReach = (std::min)(reach, nextLength / 2);
+        const Gdiplus::PointF start((float)c.x, c.y - u.Y * beforeReach);
+        const Gdiplus::PointF end((float)n.x, n.y + w.Y * afterReach);
+        const float control = (beforeReach + afterReach) / 2;
+        if (i) path.AddLine(last, start); else firstPoint = start;
+        path.AddBezier(start, {start.X, start.Y + u.Y * control},
+                       {end.X, end.Y - w.Y * control}, end);
+        last = end;
+        ++i;
+        continue;
+      }
+    }
     const Gdiplus::PointF start(c.x - u.X * incomingRadius, c.y - u.Y * incomingRadius);
     const Gdiplus::PointF end(c.x + v.X * outgoingRadius, c.y + v.Y * outgoingRadius);
     if (i) path.AddLine(last, start); else firstPoint = start;
