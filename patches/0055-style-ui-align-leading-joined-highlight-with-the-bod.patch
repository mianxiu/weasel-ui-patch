   path.AddLine(last, firstPoint);
   path.CloseFigure();
 }
+// Give the leading joined highlight the same inset and curve along the body.
+// Test the original rectangles first, so this adjustment cannot create a bridge.
+inline bool AlignLeadingRewriteHighlight(CRect candidate, CRect& syllable,
+                                        CRect body, int verticalInset) {
+  CRect overlap;
+  if (!overlap.IntersectRect(candidate, syllable)) return false;
+  syllable.left = candidate.left;
+  if (syllable.CenterPoint().y >= candidate.CenterPoint().y)
+    syllable.bottom = (std::max)((int)syllable.bottom, (int)body.bottom - verticalInset);
+  else
+    syllable.top = (std::min)((int)syllable.top, (int)body.top + verticalInset);
+  return true;
+}
 // Only merge actual intersections; never bridge empty space between highlights.
 inline bool BuildJoinedRewriteHighlight(Gdiplus::GraphicsPath& path,
                                         CRect candidate, CRect syllable,
                                         float candidateRadius, float syllableRadius,
-                                        float neckRadius) {
+                                        float neckRadius, bool leading = false) {
   CRect overlap;
   if (!overlap.IntersectRect(candidate, syllable)) return false;
   BuildJoinedRewritePath(path, candidate, syllable,
-                         candidateRadius, syllableRadius, neckRadius);
+                         candidateRadius, syllableRadius, neckRadius,
+                         leading ? candidateRadius : -1.f);
   return path.GetPointCount() > 0;
 }
 }  // namespace weasel
