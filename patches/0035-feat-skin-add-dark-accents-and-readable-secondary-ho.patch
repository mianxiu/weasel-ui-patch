diff --git a/INSTALL-PATCH.md b/INSTALL-PATCH.md
index d84c23d..e230e9f 100644
--- a/INSTALL-PATCH.md
+++ b/INSTALL-PATCH.md
@@ -1,6 +1,8 @@
 # 悬浮声调拼音预览版（2026-09-30）
 
 新增独立皮肤 **Azure Pill / 蓝白圆角**：白色横排、蓝色圆角选中项、灰色编号与淡阴影。
+新增深蓝、深黑、深绿配色，运行 `Apply-Skin-navy.cmd`、`Apply-Skin-black.cmd`、`Apply-Skin-green.cmd` 切换。
+本次程序修复次要候选 hover 白字与浅色背景难辨的问题，悬停使用深色强调文字，选中项仍为白字。
 已有程序只换皮肤时运行 `Apply-Skin.cmd`；它备份并合并 UI 配置、部署和重启服务，无需重启 Windows。
 皮肤定义及详细说明见 `skins/azure_pill.yaml` 和 `skins/README.md`。
 
diff --git a/WeaselUI/CandidateTextColors.h b/WeaselUI/CandidateTextColors.h
new file mode 100644
index 0000000..10c870c
--- /dev/null
+++ b/WeaselUI/CandidateTextColors.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <WeaselUI.h>
+
+namespace weasel {
+struct CandidateTextColors { int label, text, comment; };
+inline CandidateTextColors GetCandidateTextColors(const UIStyle& style,
+                                                   bool selected, bool hovered) {
+  if (selected) return {style.hilited_label_text_color,
+                        style.hilited_candidate_text_color,
+                        style.hilited_comment_text_color};
+  // Semi-highlight has a translucent background, not the opaque selection.
+  // Retain the readable normal accent rather than white selection lettering.
+  if (hovered) return {style.candidate_text_color, style.candidate_text_color,
+                       style.candidate_text_color};
+  return {style.label_text_color, style.candidate_text_color, style.comment_text_color};
+}
+}  // namespace weasel
