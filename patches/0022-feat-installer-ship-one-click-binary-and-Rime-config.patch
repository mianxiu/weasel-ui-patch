diff --git a/tools/rewrite-config.cpp b/tools/rewrite-config.cpp
new file mode 100644
index 0000000..0d3090f
--- /dev/null
+++ b/tools/rewrite-config.cpp
@@ -0,0 +1,189 @@
+// Standalone, statically linked YAML merger/validator for the Windows installer.
+#include <yaml-cpp/yaml.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+const std::string processor = "lua_processor@*indexed_rewrite_pro";
+const std::string legacy = "lua_filter@*indexed_rewrite_tab_ui_v2";
+void require(bool ok, const std::string& message) {
+  if (!ok) throw std::runtime_error(message);
+}
+bool scalar(YAML::Node n, const std::string& value) {
+  return n.IsScalar() && n.Scalar() == value;
+}
+void validate(YAML::Node n, int depth = 0) {
+  require(depth < 64, "YAML nesting/alias cycle exceeds safe limit");
+  if (n.IsMap()) {
+    std::set<std::string> keys;
+    for (auto item : n) {
+      require(item.first.IsScalar(), "Non-scalar YAML key is unsupported");
+      require(keys.insert(item.first.Scalar()).second, "Duplicate YAML key: " + item.first.Scalar());
+      require(item.first.Scalar() != "<<", "YAML merge keys require manual reconciliation");
+      validate(item.second, depth + 1);
+    }
+  } else if (n.IsSequence()) {
+    for (auto item : n) validate(item, depth + 1);
+  }
+}
+YAML::Node load(const fs::path& path, bool optional = false) {
+  if (optional && !fs::exists(path)) return YAML::Node(YAML::NodeType::Map);
+  std::ifstream input(path, std::ios::binary);
+  require(input.good(), "Cannot open YAML file");
+  auto docs = YAML::LoadAll(input);
+  require(docs.size() == 1, "Expected one YAML document");
+  auto n = docs[0];
+  if (n.IsNull()) n = YAML::Node(YAML::NodeType::Map);
+  require(n.IsMap(), "YAML root must be a map");
+  validate(n);
+  return n;
+}
+YAML::Node patch(YAML::Node root) {
+  require(!root["__include"] && !root["__patch"], "Root include/patch directives require manual reconciliation");
+  if (!root["patch"] || root["patch"].IsNull()) root["patch"] = YAML::Node(YAML::NodeType::Map);
+  require(root["patch"].IsMap(), "patch must be a YAML map");
+  auto p = root["patch"];
+  require(!p["__include"] && !p["__patch"], "Patch include directives require manual reconciliation");
+  return p;
+}
+void save(YAML::Node n, const fs::path& path) {
+  YAML::Emitter out;
+  out << n;
+  require(out.good(), "Cannot serialize YAML");
+  std::ofstream file(path, std::ios::binary | std::ios::trunc);
+  file << "# Updated by Weasel Rewrite UI installer; original retained in backup.\n" << out.c_str() << '\n';
+  file.close();
+  require(!file.fail(), "Cannot write staged YAML");
+  load(path);
+}
+// Remove the obsolete filter from both scalar patch operations and filter lists.
+void cleanLegacy(YAML::Node n) {
+  if (n.IsMap()) {
+    std::vector<std::string> erase;
+    for (auto item : n) {
+      if (scalar(item.second, legacy)) erase.push_back(item.first.Scalar());
+      else cleanLegacy(item.second);
+    }
+    for (const auto& key : erase) n.remove(key);
+  } else if (n.IsSequence()) {
+    for (size_t i = n.size(); i > 0; --i) {
+      if (scalar(n[i - 1], legacy)) n.remove(i - 1);
+      else cleanLegacy(n[i - 1]);
+    }
+  }
+}
+void prepare(const fs::path& user, const fs::path& stage) {
+  auto ui = load(user / L"weasel.custom.yaml", true);
+  auto u = patch(ui);
+  if (u["rewrite_ui"]) {
+    require(u["rewrite_ui"].IsMap(), "rewrite_ui must be a map");
+    u["rewrite_ui"].remove("enabled");
+    u["rewrite_ui"].remove("debug");
+  }
+  u["rewrite_ui/enabled"] = true;
+  u["rewrite_ui/debug"] = false;
+
+  auto schema = load(user / L"wanxiang_pro.custom.yaml", true);
+  auto p = patch(schema);
+  cleanLegacy(p);
+  // Refuse ambiguous path operations instead of destroying user configuration.
+  for (auto item : p) {
+    const auto key = item.first.Scalar();
+    if (key.rfind("engine/processors/", 0) == 0)
+      require(key == "engine/processors/@before 0" && scalar(item.second, processor),
+              "Conflicting processor patch: " + key);
+    if (key.rfind("key_binder/bindings/", 0) == 0)
+      require(key == "key_binder/bindings/+", "Conflicting binding patch: " + key);
+  }
+  YAML::Node processors;
+  int processorLists = 0;
+  if (p["engine/processors"]) { processors.reset(p["engine/processors"]); ++processorLists; }
+  if (p["engine"]) {
+    require(p["engine"].IsMap(), "engine patch must be a map");
+    if (p["engine"]["processors"]) { processors.reset(p["engine"]["processors"]); ++processorLists; }
+  }
+  require(processorLists < 2, "Multiple processor lists require manual reconciliation");
+  if (processorLists) {
+    require(processors.IsSequence(), "processors must be a list");
+    for (size_t i = processors.size(); i > 0; --i)
+      if (scalar(processors[i - 1], processor)) processors.remove(i - 1);
+    auto merged = YAML::Node(YAML::NodeType::Sequence);
+    merged.push_back(processor);
+    for (auto item : processors) merged.push_back(YAML::Clone(item));
+    processors = merged;
+    p.remove("engine/processors/@before 0");
+  } else p["engine/processors/@before 0"] = processor;
+
+  YAML::Node bindings;
+  int bindingLists = 0;
+  for (const auto& key : {"key_binder/bindings", "key_binder/bindings/+"}) {
+    if (p[key]) { bindings.reset(p[key]); ++bindingLists; }
+  }
+  if (p["key_binder"]) {
+    require(p["key_binder"].IsMap(), "key_binder patch must be a map");
+    if (p["key_binder"]["bindings"]) { bindings.reset(p["key_binder"]["bindings"]); ++bindingLists; }
+  }
+  require(bindingLists < 2, "Multiple binding lists require manual reconciliation");
+  if (!bindingLists) {
+    p["key_binder/bindings/+"] = YAML::Node(YAML::NodeType::Sequence);
+    bindings.reset(p["key_binder/bindings/+"]);
+  }
+  require(bindings.IsSequence(), "key bindings must be a list");
+  for (size_t i = bindings.size(); i > 0; --i) {
+    auto b = bindings[i - 1];
+    require(b.IsMap(), "Each binding must be a map");
+    if (scalar(b["accept"], "Tab") &&
+        (scalar(b["when"], "composing") || scalar(b["when"], "has_menu"))) bindings.remove(i - 1);
+  }
+  auto merged = YAML::Node(YAML::NodeType::Sequence);
+  for (const auto& when : {"has_menu", "composing"}) {
+    YAML::Node b;
+    b["when"] = when; b["accept"] = "Tab"; b["send_sequence"] = "//";
+    merged.push_back(b);
+  }
+  for (auto b : bindings) merged.push_back(YAML::Clone(b));
+  bindings = merged;
+  fs::create_directories(stage);
+  save(ui, stage / L"weasel.custom.yaml");
+  save(schema, stage / L"wanxiang_pro.custom.yaml");
+}
+void verify(const fs::path& user) {
+  auto ui = load(user / L"build" / L"weasel.yaml");
+  require(ui["rewrite_ui"]["enabled"].as<bool>(false), "Deployed rewrite_ui is not enabled");
+  require(!ui["rewrite_ui"]["debug"].as<bool>(true), "Deployed debug logging is not disabled");
+  auto schema = load(user / L"build" / L"wanxiang_pro.schema.yaml");
+  auto procs = schema["engine"]["processors"];
+  require(procs.IsSequence() && procs.size() && scalar(procs[0], processor), "Rewrite processor is not first in deployed schema");
+  auto filters = schema["engine"]["filters"];
+  if (filters.IsSequence()) for (auto f : filters) require(!scalar(f, legacy), "Obsolete Lua filter is still deployed");
+  auto bindings = schema["key_binder"]["bindings"];
+  require(bindings.IsSequence(), "Deployed bindings missing");
+  for (const auto& when : {"has_menu", "composing"}) {
+    bool found = false;
+    for (auto b : bindings) {
+      if (scalar(b["when"], when) && scalar(b["accept"], "Tab")) {
+        require(scalar(b["send_sequence"], "//"), "An earlier Tab binding overrides rewrite");
+        found = true; break;
+      }
+    }
+    require(found, "Deployed Tab binding missing");
+  }
+}
+int wmain(int argc, wchar_t** argv) {
+  try {
+    require(argc >= 3, "Usage: RewriteConfig.exe prepare USER STAGE | verify USER");
+    if (std::wstring(argv[1]) == L"prepare") {
+      require(argc == 4, "prepare requires USER STAGE"); prepare(argv[2], argv[3]);
+    } else if (std::wstring(argv[1]) == L"verify") verify(argv[2]);
+    else throw std::runtime_error("Unknown operation");
+    std::cout << "Configuration check passed.\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << "Configuration error: " << e.what() << '\n'; return 1;
+  }
+}
