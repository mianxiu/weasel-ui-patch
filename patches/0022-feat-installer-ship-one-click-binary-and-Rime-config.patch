+    Assert (!(Test-Path (Join-Path $UserDataRoot 'wanxiang_pro.custom.yaml'))) 'New schema not removed on rollback'
+    Assert (!(Test-Path (Join-Path $UserDataRoot 'lua/indexed_rewrite_pro.lua'))) 'New Lua not removed on rollback'
+    if ($scenario -eq 'uac-cancel') { Assert (($events -join ',') -eq 'install-binaries') 'UAC cancel must not restart or deploy' }
+    else { Assert ($events.Contains('restore-binaries')) 'Binary recovery not requested' }
+  }
+  Write-Host "PASS: transaction $scenario"
+}
