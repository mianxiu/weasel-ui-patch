new file mode 100644
index 0000000..4cd2bb7
--- /dev/null
+++ b/test/installer_rime_test.cpp
@@ -0,0 +1,40 @@
+// Runs real bundled librime in an isolated fixture, never Windows registry paths.
+#include <rime_api.h>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+void check(bool ok, const char* message) { if (!ok) throw std::runtime_error(message); }
+int wmain(int argc, wchar_t** argv) {
+  try {
+    check(argc == 3, "Expected shared and user fixture paths");
+    auto shared = std::filesystem::absolute(argv[1]).u8string();
+    auto user = std::filesystem::absolute(argv[2]).u8string();
+    auto logs = (std::filesystem::absolute(argv[2]) / "logs").u8string();
+    std::filesystem::create_directories(std::filesystem::u8path(logs));
+    RIME_STRUCT(RimeTraits, traits);
+    traits.shared_data_dir = shared.c_str(); traits.user_data_dir = user.c_str();
+    traits.log_dir = logs.c_str(); traits.app_name = "rime.installer-test";
+    auto api = rime_get_api();
+    api->setup(&traits); api->deployer_initialize(&traits);
+    check(api->deploy(), "Workspace deployment failed");
+    check(api->deploy_config_file("weasel.yaml", "config_version"), "UI deployment failed");
+    api->initialize(&traits);
+    auto session = api->create_session();
+    check(session != 0, "Session creation failed");
+    check(api->select_schema(session, "wanxiang_pro"), "Schema selection failed");
+    for (char key : std::string("jxjirzbj")) api->process_key(session, key, 0);
+    check(api->process_key(session, 0xff09, 0), "Tab not handled");
+    char stage[64] = {};
+    check(api->get_property(session, "_indexed_rewrite_stage", stage, sizeof(stage)), "Rewrite property missing");
+    check(std::string(stage) == "armed", "Tab did not arm rewrite");
+    api->process_key(session, '3', 0);
+    char index[64] = {};
+    check(api->get_property(session, "_indexed_rewrite_index", index, sizeof(index)) && std::string(index) == "3", "Index selection failed");
+    api->process_key(session, 0xff1b, 0);
+    check(std::string(api->get_input(session)) == "jxjirzbj", "Escape did not restore input");
+    api->destroy_session(session); api->finalize();
+    std::cout << "PASS: real deployment, Lua loading, Tab, index, Escape\n";
+    return 0;
+  } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
