+Write-Host 'PASS: repeated install is idempotent'
+$nested = Prepare 'nested-lists' '' @'
+patch:
+  engine:
+    processors: [ascii_composer, key_binder]
+    filters: [lua_filter@*indexed_rewrite_tab_ui_v2, simplifier]
