@@ -163,6 +168,16 @@ LPCTSTR GetParamByPrefix(LPCTSTR lpCmdLine, LPCTSTR prefix) {
 }
 
 static int Run(LPTSTR lpCmdLine) {
+  // Windows launchers can append whitespace to the raw command line.
+  std::wstring normalized = lpCmdLine;
+  const auto last = normalized.find_last_not_of(L" \t\r\n");
+  normalized.erase(last == std::wstring::npos ? 0 : last + 1);
+  const auto first = normalized.find_first_not_of(L" \t\r\n");
+  if (first != std::wstring::npos) normalized.erase(0, first);
+  lpCmdLine = normalized.data();
+  char command[1024] = {};
+  WideCharToMultiByte(CP_UTF8, 0, lpCmdLine, -1, command, sizeof(command), nullptr, nullptr);
+  SetupTrace(command);
   constexpr bool silent = true;
   // parameter /? or /help to show commandline args
   if (!wcscmp(L"/?", lpCmdLine) || !wcscmp(L"/help", lpCmdLine)) {
@@ -247,8 +262,10 @@ static int Run(LPTSTR lpCmdLine) {
