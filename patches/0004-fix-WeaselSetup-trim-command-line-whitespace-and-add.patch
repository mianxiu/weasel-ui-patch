Subject: [PATCH 04/57] fix(WeaselSetup): trim command-line whitespace and add
 opt-in setup tracing

---
 WeaselSetup/SetupTrace.h    | 13 +++++++++++++
 WeaselSetup/WeaselSetup.cpp | 17 +++++++++++++++++
 WeaselSetup/imesetup.cpp    |  6 ++++++
 3 files changed, 36 insertions(+)
 create mode 100644 WeaselSetup/SetupTrace.h

diff --git a/WeaselSetup/SetupTrace.h b/WeaselSetup/SetupTrace.h
new file mode 100644
index 0000000..860e6fb
--- /dev/null
+++ b/WeaselSetup/SetupTrace.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <windows.h>
+inline void SetupTrace(const char* message) {
+  wchar_t path[MAX_PATH];
+  if (!GetEnvironmentVariableW(L"WEASEL_SETUP_LOG", path, MAX_PATH)) return;
+  HANDLE file = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                            nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) return;
+  DWORD written;
+  WriteFile(file, message, static_cast<DWORD>(lstrlenA(message)), &written, nullptr);
+  WriteFile(file, "\r\n", 2, &written, nullptr);
+  CloseHandle(file);
+}
