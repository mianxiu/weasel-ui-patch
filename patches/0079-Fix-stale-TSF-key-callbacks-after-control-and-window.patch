diff --git a/WeaselTSF/KeyEventSink.cpp b/WeaselTSF/KeyEventSink.cpp
index 6a18c13..41c7377 100644
--- a/WeaselTSF/KeyEventSink.cpp
+++ b/WeaselTSF/KeyEventSink.cpp
@@ -83,19 +83,44 @@ STDMETHODIMP WeaselTSF::OnSetFocus(BOOL fForeground) {
  *  and for OnKeyDown() to check if the key has already been sent to the server.
  */
 
+bool WeaselTSF::_PrepareKeyContext(ITfContext* context) {
+  if (!context)
+    return false;
+  com_ptr<ITfDocumentMgr> focusedDocument;
+  com_ptr<ITfContext> focusedContext;
+  if (_pThreadMgr && SUCCEEDED(_pThreadMgr->GetFocus(&focusedDocument)) &&
+      focusedDocument && SUCCEEDED(focusedDocument->GetTop(&focusedContext)) &&
+      focusedContext && focusedContext != context)
+    return false;  // A delayed key from the old control cannot abort new input.
+  // A host can switch controls without a document/thread focus callback.
+  // Cancel the old input before sending the first key for the new control.
+  if (context && _pEditSessionContext && context != _pEditSessionContext)
+    _AbortComposition();
+  if (context)
+    _pEditSessionContext = context;
+  return true;
+}
+
 STDMETHODIMP WeaselTSF::OnTestKeyDown(ITfContext* pContext,
                                       WPARAM wParam,
                                       LPARAM lParam,
                                       BOOL* pfEaten) {
+  if (!_PrepareKeyContext(pContext)) { *pfEaten = FALSE; return S_OK; }
   _fTestKeyUpPending = FALSE;
-  if (_fTestKeyDownPending) {
+  const LONG messageTime = GetMessageTime();
+  if (_fTestKeyDownPending &&
+      _testKeyDown.Matches(pContext, wParam, lParam, messageTime, true)) {
     *pfEaten = TRUE;
     return S_OK;
   }
+  // Missing OnKeyDown must not swallow a different or later repeated key.
+  _fTestKeyDownPending = FALSE;
   _ProcessKeyEvent(wParam, lParam, pfEaten);
   _UpdateComposition(pContext);
-  if (*pfEaten)
+  if (*pfEaten) {
+    _testKeyDown = {pContext, wParam, lParam, messageTime};
     _fTestKeyDownPending = TRUE;
+  }
   return S_OK;
 }
 
