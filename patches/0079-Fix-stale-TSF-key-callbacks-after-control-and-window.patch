 };
@@ -319,6 +323,55 @@ struct TSFFocusTest {
     assert(context.propertyReads == propertiesBeforeDrain);
     assert(committedEarly.ends == 0);
     service->_AbortComposition();
+    context.Drain();
+
+    // Lost OnKeyDown while holding U: only a duplicate test for the same
+    // message is skipped. A later autorepeat or another key must run normally.
+    const LPARAM initialU = 0x00160001;
+    const LPARAM repeatU = 0x40160001;
+    service->_PrepareKeyContext(&context);
+    service->_testKeyDown = {&context, 'U', initialU, GetMessageTime()};
+    service->_fTestKeyDownPending = TRUE;
+    BOOL eaten = FALSE;
+    service->OnTestKeyDown(&context, 'U', initialU, &eaten);
+    assert(eaten && service->_fTestKeyDownPending);
+    assert(!service->_testKeyDown.Matches(&context, 'U', repeatU, GetMessageTime(), true));
+    assert(!service->_testKeyDown.Matches(&context, 'U', initialU, GetMessageTime() + 30, true));
+    assert(!service->_testKeyDown.Matches(&context, 'A', initialU, GetMessageTime(), true));
+    service->OnKeyDown(&context, 'U', initialU, &eaten);
+    assert(eaten && !service->_fTestKeyDownPending);
+
+    // A different control on the same document can receive the next U
+    // without either a document-focus or thread-focus callback.
+    Context nextContext;
+    context.document = nextContext.document = &document;
+    Composition heldU, nextInput;
+    heldU.range.text = L"u";
+    service->_SetComposition(&heldU);
+    service->_status.composing = true;
+    service->_UpdateComposition(&context);
+    service->_fTestKeyDownPending = service->_fTestKeyUpPending = TRUE;
+    epoch = service->_GetCompositionEpoch();
+    service->_PrepareKeyContext(&nextContext);
+    assert(!service->_IsComposing() && !service->_status.composing);
+    assert(!service->_fTestKeyDownPending && !service->_fTestKeyUpPending);
+    assert(service->_pEditSessionContext == &nextContext);
+    assert(!service->_IsCompositionEpoch(epoch));
+    service->_SetComposition(&nextInput);
+    service->_status.composing = true;
+    host.focused = &document; document.top = &nextContext;
+    epoch = service->_GetCompositionEpoch();
+    assert(!service->_PrepareKeyContext(&context));
+    eaten = TRUE;
+    service->OnKeyUp(&context, 'U', 0xc0160001, &eaten);
+    assert(!eaten && service->_IsCompositionEpoch(epoch));
+    assert(service->_IsCurrentComposition(&nextInput) && service->_status.composing);
+    context.Drain();
+    assert(heldU.range.text.empty());
+    assert(service->_IsCurrentComposition(&nextInput) && service->_status.composing);
+    service->_AbortComposition();
+    nextContext.Drain();
+    host.focused = nullptr; document.top = nullptr;
     service->_pEditSessionContext.Release();
     candidates->Destroy();
     candidates.Release(); // Break the existing service/candidate COM cycle.
