diff --git a/WeaselTSF/WeaselTSF.h b/WeaselTSF/WeaselTSF.h
index 0b8cfe8..70662c8 100644
--- a/WeaselTSF/WeaselTSF.h
+++ b/WeaselTSF/WeaselTSF.h
@@ -183,6 +183,7 @@ class WeaselTSF : public ITfTextInputProcessorEx,
   BOOL _InitKeyEventSink();
   void _UninitKeyEventSink();
   void _ProcessKeyEvent(WPARAM wParam, LPARAM lParam, BOOL* pfEaten);
+  bool _PrepareKeyContext(ITfContext* context);
 
   BOOL _InitPreservedKey();
   void _UninitPreservedKey();
@@ -216,6 +217,18 @@ class WeaselTSF : public ITfTextInputProcessorEx,
   DWORD _dwTextEditSinkCookie, _dwTextLayoutSinkCookie;
   BYTE _lpbKeyState[256];
   BOOL _fTestKeyDownPending, _fTestKeyUpPending;
+  struct PendingKeyEvent {
+    ITfContext* context = nullptr;
+    WPARAM key = 0;
+    LPARAM flags = 0;
+    LONG messageTime = 0;
+    bool Matches(ITfContext* current, WPARAM currentKey, LPARAM currentFlags,
+                 LONG currentTime, bool sameMessage) const {
+      return context == current && key == currentKey && flags == currentFlags &&
+             (!sameMessage || messageTime == currentTime);
+    }
+  };
+  PendingKeyEvent _testKeyDown, _testKeyUp;
 
   com_ptr<ITfContext> _pEditSessionContext;
   std::wstring _editSessionText;
